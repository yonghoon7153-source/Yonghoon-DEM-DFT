+        ("dq_nin_p1",      float(nin)),
+        ("E_PE_0p5",       float(np.atleast_1d(obj.half.E_PE(0.5))[0])),
+        ("E_NE_0p5_0p25",  float(np.atleast_1d(obj.blend.E(np.atleast_1d(0.5), 0.25))[0])),
+        ("dv_PE_0p5",      float(np.atleast_1d(obj.half.dv_PE(0.5))[0])),
