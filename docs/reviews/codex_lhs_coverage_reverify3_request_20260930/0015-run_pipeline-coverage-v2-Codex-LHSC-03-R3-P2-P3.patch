+def _v2_count_dict(d, keys):
+    """개수 원장 — 생산자의 분류 집합과 **정확히** 같은 키 · 값은 명시적 비음수 정수 (빈 dict · 모르는 분류 · 실수 개수는 거부 · LHSC-03 R3)."""
+    return isinstance(d, dict) and set(d) == set(keys) and all(_v2_int(v) for v in d.values())
