+def base_config_closure_members(root_key, sealed: dict, snap_dir) -> tuple[list, list]:
+    """★ 85차 G85-N1 — base-config closure 의 구성원을 **봉인 스냅샷에서 독립 유도**한다.
+
+    검사 대상의 키 목록을 정답으로 쓰지 않는다. 출발점은 run_spec 의 root 논리 키이고, 각 구성원의 봉인
+    스냅샷 바이트를 YAML 로 읽어 `extends` 를 `load_config` 와 같은 규칙 (`Path(key).parent / extends`) 으로
+    따라간다. 봉인 목록이나 스냅샷에 없는 부모는 실패다 — 현재 디스크의 다른 config 로 채우지 않는다.
+    반환: (정렬된 구성원 논리 키, 문제 목록). 문제가 있으면 구성원은 참고용일 뿐이다.
+    """
+    import posixpath
+    snap_dir = Path(snap_dir)
+    if not isinstance(root_key, str) or not root_key:
+        return [], [f"root: run_spec.base_config 가 없다 ({root_key!r})"]
+    order: list = []
+    problems: list = []
+    key = root_key
+    while key is not None:
+        norm = posixpath.normpath(key)
+        role = "root " if not order else ""
+        if posixpath.isabs(norm) or norm == ".." or norm.startswith("../"):
+            problems.append(f"{role}{key}: extends 가 저장소 밖을 가리킨다")
+            break
+        if norm in order:
+            problems.append(f"{norm}: extends 순환 ({' → '.join(order + [norm])})")
+            break
+        if len(order) >= _CLOSURE_MAX_DEPTH:
+            problems.append(f"extends 깊이가 {_CLOSURE_MAX_DEPTH} 를 넘는다")
+            break
+        order.append(norm)
+        dig = (sealed or {}).get(norm)
+        if not dig:
+            problems.append(f"{role}{norm}: 봉인 목록 (run_spec.sealed_inputs) 에 없다")
+            break
+        snap = snap_dir / f"{str(dig)[:12]}_{Path(norm).name}"
+        if not snap.is_file():
+            problems.append(f"{role}{norm}: 봉인 스냅샷이 없다")
+            break
+        try:
+            doc = yaml.safe_load(snap.read_text(encoding="utf-8"))
+        except (yaml.YAMLError, UnicodeDecodeError) as e:
+            problems.append(f"{norm}: 스냅샷 YAML 을 읽을 수 없다 ({type(e).__name__})")
+            break
+        doc = {} if doc is None else doc
+        if not isinstance(doc, dict):
+            problems.append(f"{norm}: 스냅샷 YAML 이 mapping 이 아니다")
+            break
+        ext = doc.get("extends")
+        if ext is None:
+            key = None
+        elif not isinstance(ext, str) or not ext:
+            problems.append(f"{norm}: extends 가 문자열이 아니다 ({ext!r})")
+            break
+        else:
+            key = posixpath.join(posixpath.dirname(norm), ext)
+    return sorted(order), problems
 
 
