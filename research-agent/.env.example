# research-agent — 로컬 자격증명 (절대 커밋 금지). Hermes 사용 시 ~/.hermes/.env 를 RA_ENV_FILE 로 지정해도 됨.
EMAIL_ADDRESS=yonghoon71@hanyang.ac.kr
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx        # Gmail 앱 비밀번호 (2단계 인증 필요)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
# LLM 백엔드 (기본 hermes = 큐만 생성). anthropic | claude-cli | hermes | none
RA_LLM_BACKEND=hermes
RA_LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...            # RA_LLM_BACKEND=anthropic 일 때
# RA_ROOT=/path/to/research-agent        # repo 밖에서 ra 를 실행할 때
