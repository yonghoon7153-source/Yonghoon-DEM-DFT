+    막지 않으면 이름뿐이다). `run_id` 가 없으면 자리를 정할 수 없으므로 거부한다 — 부재는 안전값이 아니다.
+    """
+    import re as _re
+    out = Path(out)
+    if status == "complete":
+        out.parent.mkdir(parents=True, exist_ok=True)
+        return out
+    if not run_id:
+        raise ValueError("부분 산출은 attempt-id(run_id) 없이 자리를 정할 수 없다 (조건 8 축 ④)")
