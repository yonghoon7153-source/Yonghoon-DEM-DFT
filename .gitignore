# ★ 39차 #9 — 게시 writer lock 은 **runtime 파일**이다. 저장소에 커밋되면
#   worktree 가 더러워지고, checkout·배포가 그 pathname 의 inode 를 갈아
#   끼울 수 있다 (그 자체가 lock capability 를 무효화하는 조건이다).
.publish.lock

# ★ 53차 P0-5 — 동결이 원장 전이를 발급자와 **같은 lock** 으로 감싼다
#   (`tools/preserve.py` 의 `_ledger_lock()`). 그 sentinel 도 runtime 파일이다.
LEG_PRESERVATION.yaml.lock

# ★ 48차 P0-8 — gated 진입점을 태우는 단위 시험의 산출 (면제 namespace 안)
degradation-degeneracy/results/_smoke/_unit/

# webapp 실행용 가상환경 (bms.sh 가 만든다)
.venv/

# 3자 데이터셋 원본 — manifest 와 파생 소표만 커밋한다 (재배포·용량)
mode-observability/data/

# 파이썬 바이트코드 — 저장소 어디에서든 (지금까지 degradation-degeneracy/ 안에만
# 규칙이 있어 새 satellite 의 __pycache__ 가 untracked 로 떴다)
__pycache__/
*.py[cod]

# 셀 자료 트리 — bms-balancing/scripts/prepare_cell.py · fixed_hc.py 가 만드는
# 곳에 **규진팀 원자료 xlsx 사본**이 들어간다. 저장소는 public 이다.
# 사용자 기계의 clone 루트가 ~/dd 라 루트 바로 아래 cells/ 가 생겼고,
# bms-balancing/.gitignore 는 상위 디렉터리를 못 막는다 (HANDOFF_TO_GATE.md §2b).
cells/
