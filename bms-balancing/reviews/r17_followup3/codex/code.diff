+
+def unique_rows(rows, key):
+    """(key → 행, 중복 key 목록, 행 수). 중복은 **조용히 합치지 않는다** — checker(R8-05)·reader(R9-05)가 같은 함수를 쓴다."""
+    seen, dup, out = {}, [], {}
+    for r in rows:
+        k = key(r)
+        seen[k] = seen.get(k, 0) + 1
+        if seen[k] > 1 and k not in dup:
+            dup.append(k)
+        out.setdefault(k, r)
+    return out, dup, len(rows)
+
