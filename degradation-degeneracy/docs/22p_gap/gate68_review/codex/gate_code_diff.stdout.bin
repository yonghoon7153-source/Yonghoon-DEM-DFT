     """child 의 `customization` 이 부모의 시야와 **양립하는가** (62차 자체 리뷰 F1 ·
     65차 N1a).
@@ -5989,21 +6100,28 @@ def _assert_customization_matches_parent(receipt: dict, ctx: dict | None = None)
