atom_style granular
atom_modify map array sort 0 0
boundary p p f
newton off
soft_particles yes
communicate single vel yes
units si
variable target_press equal 0.30
variable r_AM_P equal 3e-3
variable r_AM_S equal 2.0e-3
variable r_SE equal 0.35e-3
variable dt equal 1.0e-6
variable plate_margin equal 0.003
timestep ${dt}
processors * * 1
read_restart restart_kg50_d07_b50/restart_compress_1000000.bin
neighbor 0.002 bin
neigh_modify delay 0 check yes
fix m1 all property/global youngsModulus peratomtype 1.4e8 1.4e8 0.135e7
fix m2 all property/global poissonsRatio peratomtype 0.25 0.25 0.30
fix m3 all property/global coefficientRestitution peratomtypepair 3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3
fix m4 all property/global coefficientFriction peratomtypepair 3 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5
fix m5 all property/global coefficientRollingFriction peratomtypepair 3 0.2 0.2 0.1 0.2 0.2 0.1 0.1 0.1 0.1
fix m6 all property/global coefficientMaxElasticStiffness peratomtypepair 3 1.5 1.5 3.0 1.5 1.5 3.0 3.0 3.0 5.0
fix m7 all property/global coefficientAdhesionStiffness peratomtypepair 3 1.0e5 1.0e5 2.0e5 1.0e5 1.0e5 2.0e5 2.0e5 2.0e5 1.0e6
fix m8 all property/global coefficientPlasticityDepth peratomtypepair 3 0.05 0.05 0.01 0.05 0.05 0.01 0.01 0.01 0.005
fix m9 all property/global characteristicVelocity scalar 2.0
pair_style gran model hooke/hysteresis tangential history rolling_friction cdt
pair_coeff * *
compute strs all stress/atom
compute ke all ke/atom
compute cpl all pair/gran/local pos id force force_normal force_tangential torque contactArea delta contactPoint
fix zwall_bot all wall/gran model hooke/hysteresis tangential history rolling_friction cdt primitive type 1 zplane 0.0
variable n_ins equal count(all)
print "====== INSERTED ${n_ins} / 488291 (floor 483408 = 99%) ======"
if "${n_ins} < 483408" then "print 'FATAL: partial insertion - bed composition differs (PS-01). aborting.'" "quit 1"
group g_am_ins type 1
variable n_am_ins equal count(g_am_ins)
print "====== AM ${n_am_ins} / 1481 (gate 1474-1488) ======"
if "${n_am_ins} < 1474 || ${n_am_ins} > 1488" then "print 'FATAL: AM count off plan (SELF-70) - insert at NP 1. aborting.'" "quit 1"
group g_se_ins type 3
variable n_se_ins equal count(g_se_ins)
print "====== SE ${n_se_ins} / 486810 (gate 484376-489244) ======"
if "${n_se_ins} < 484376 || ${n_se_ins} > 489244" then "print 'FATAL: SE count off plan (SELF-70) - insert at NP 1. aborting.'" "quit 1"
shell mkdir -p post_kg50_d07_b50
thermo_style custom step atoms ke cpu
thermo 1000
fix integr all nve/sphere
fix top_mesh all mesh/surface/stress file plate_kg50_d07_b50_r56.stl type 1 scale 1.0 reference_point 0 0 0
fix zwall_top all wall/gran model hooke/hysteresis tangential history rolling_friction cdt mesh n_meshes 1 meshes top_mesh
dump dmp_mesh all mesh/stl 5000 post_kg50_d07_b50/mesh_*.stl top_mesh
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix damp all viscous 0.5
variable pressMPa equal abs(f_top_mesh[3])/0.0025/1000000
thermo_style custom step atoms ke cpu v_pressMPa
thermo 1000
print "====== PHASE 3: COMPRESSION (Speed 0.01) ======"
dump dmp_atom all custom 50000 post_kg50_d07_b50/atom_*.liggghts id type x y z radius vx vy vz c_strs[1] c_strs[2] c_strs[3] c_ke
fix_modify zwall_top energy yes
variable press_speed equal 0.01
fix move_press all move/mesh mesh top_mesh linear 0.0 0.0 -${press_speed}
restart 200000 restart_kg50_d07_b50/restart_compress_*.bin
label loop_press
run 5000
variable current_press equal "abs(f_top_mesh[3]) / 0.0025 / 1000000"
print "Current Pressure: ${current_press} MPa (Target: ${target_press})"
if "${current_press} < ${target_press}" then "jump SELF loop_press"
unfix move_press
restart 0
print "====== PHASE 4: RELAXATION ======"
unfix damp
fix damp all viscous 1.0e-5
dump dmp_contact all local 10000 post_kg50_d07_b50/contact_*.liggghts c_cpl[1] c_cpl[2] c_cpl[3] c_cpl[4] c_cpl[5] c_cpl[6] c_cpl[7] c_cpl[8] c_cpl[9] c_cpl[10] c_cpl[11] c_cpl[12] c_cpl[13] c_cpl[14] c_cpl[15] c_cpl[16] c_cpl[17] c_cpl[18] c_cpl[19] c_cpl[20] c_cpl[21] c_cpl[22] c_cpl[23] c_cpl[24] c_cpl[25] c_cpl[26]
run 100000
write_restart restart_kg50_d07_b50/restart_end.bin
dump dmp_atom_end all custom 1 post_kg50_d07_b50/atom_end_*.liggghts id type x y z radius vx vy vz c_strs[1] c_strs[2] c_strs[3] c_ke
dump dmp_contact_end all local 1 post_kg50_d07_b50/contact_end_*.liggghts c_cpl[1] c_cpl[2] c_cpl[3] c_cpl[4] c_cpl[5] c_cpl[6] c_cpl[7] c_cpl[8] c_cpl[9] c_cpl[10] c_cpl[11] c_cpl[12] c_cpl[13] c_cpl[14] c_cpl[15] c_cpl[16] c_cpl[17] c_cpl[18] c_cpl[19] c_cpl[20] c_cpl[21] c_cpl[22] c_cpl[23] c_cpl[24] c_cpl[25] c_cpl[26]
dump dmp_mesh_end all mesh/stl 1 post_kg50_d07_b50/mesh_end_*.stl top_mesh
run 0
undump dmp_atom_end
undump dmp_contact_end
undump dmp_mesh_end
print "====== Simulation Finished! (KG50_D07_B50: mono AM D6, AM:SE=85:15 wt%, SE D50 0.7um, 6.5mAh/cm2, 50x50um) ======"
