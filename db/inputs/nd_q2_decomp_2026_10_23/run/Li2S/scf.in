&CONTROL
    calculation = 'vc-relax'
    prefix      = 'Li2S'
    outdir      = './tmp'
    pseudo_dir  = '/home/kgy/work/pseudo'
    tprnfor     = .true.
    tstress     = .true.
    etot_conv_thr = 1.0d-6
    forc_conv_thr = 1.0d-4
    nstep        = 200
/
&SYSTEM
    ibrav       = 0
    nat         = 3
    ntyp        = 2
    ecutwfc     = 70.0
    ecutrho     = 560.0
    occupations = 'smearing'
    smearing    = 'mv'
    degauss     = 0.01
    nosym       = .true.
/
&ELECTRONS
    conv_thr     = 1.0d-9
    electron_maxstep = 100
    mixing_mode  = 'plain'
    mixing_beta  = 0.3
    mixing_ndim  = 8
    diagonalization = 'david'
/
&IONS
    ion_dynamics = 'bfgs'
/
&CELL
    cell_dynamics = 'bfgs'
    press_conv_thr = 0.5
/
ATOMIC_SPECIES
  Li  6.9410  Li.pbe-sl-kjpaw_psl.1.0.0.UPF
  S  32.0650  S.pbe-nl-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
    4.0456138700    0.0000000000    0.0000000000
    2.0228069350    3.5036043853    0.0000000000
    2.0228069350    1.1678681284    3.3032298926
ATOMIC_POSITIONS crystal
  Li    0.7500000000    0.7500000000    0.7500000000
  Li    0.2500000000    0.2500000000    0.2500000000
  S    0.0000000000    0.0000000000    0.0000000000
K_POINTS automatic
  8 8 8 0 0 0
