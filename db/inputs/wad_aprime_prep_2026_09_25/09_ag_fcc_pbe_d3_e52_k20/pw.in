&CONTROL
  calculation = 'vc-relax'
  prefix = '09_ag_fcc_pbe_d3_e52_k20'
  outdir = './tmp'
  pseudo_dir = '/data/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
  nstep = 100
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 52.0
  ecutrho = 520.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.5
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = 'all'
  press = 0.0
  press_conv_thr = 0.1
/

ATOMIC_SPECIES
  Ag  107.8682  Ag_ONCV_PBE-1.0.oncvpsp.upf

CELL_PARAMETERS angstrom
  0.0000000000  2.0800000000  2.0800000000
  2.0800000000  0.0000000000  2.0800000000
  2.0800000000  2.0800000000  0.0000000000

ATOMIC_POSITIONS angstrom
  Ag  0.0000000000  0.0000000000  0.0000000000

K_POINTS automatic
  20 20 20 0 0 0
