# ============================================================
# DEM 언로딩 키트 — ps_10_0_r45 · UNread — 보조 소거 읽기 (R 의 진단 restart → 같은 머리 → PRE · POST 관측 · 진단 전용)
#   생성: make_unload_decks.py (손으로 고치지 말 것 — 생성기를 고치고 다시 만든다 · SHA256SUMS)
#   정본: docs/data/ps45_unload_20261009/README.md · 등록 docs/reviews/dem_unloading_ps45_prereg_20261009.md §12 · §13
#   변수 (run_unload.sh 가 -var 로 준다): out (이 런 폴더) · plate_stl (판 STL · 자료는 restart 에서) · ckpt (읽을 restart) ·
#     ul_base (KE 기준 파일 · S2) · ul_state (상태 파일 · 이어 돌림 · 중력 팔) · ul_resume (1 = 이어 돌림) · ul_s0 (10:0 S0′ 결정)
#   모델 머리 = 원 덱 글자 · 언로딩 블록 숫자 = unload_params.json (덱 안 상수로 다시 적지 않는다 · 생성기 selftest 가 검사)
# ============================================================

# >>> block head — 원 마지막 조각 덱 (r8 꼴) 이 S0 에 켜 둔 정의 그대로 · 순서 = 원 PHASE 4 (zwall_bot → integr → gravi → top_mesh → zwall_top → damp)
#     (r8 글자에서 뽑았다 · 판 STL 경로만 ${plate_stl} — 메시 자료는 restart 에서 · 압축 감쇠 0.5 · 판 이동 fix 는 S0 에 없다)
atom_style granular
atom_modify map array sort 0 0
boundary p p f
newton off
soft_particles yes
communicate single vel yes
units si

variable r_AM_P equal 4.5e-3
variable r_AM_S equal 2.0e-3
variable r_SE equal 0.5e-3
variable dt equal 1.0e-6
timestep ${dt}
processors * * 1

read_restart ${ckpt}

neighbor 0.002 bin
neigh_modify delay 0 check yes

fix m1 all property/global youngsModulus peratomtype 1.4e8 1.4e8 0.135e7
fix m2 all property/global poissonsRatio peratomtype 0.25 0.25 0.30
fix m3 all property/global coefficientRestitution peratomtypepair 3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3
fix m4 all property/global coefficientFriction peratomtypepair 3 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5
fix m5 all property/global coefficientRollingFriction peratomtypepair 3 0.2 0.2 0.1 0.2 0.2 0.1 0.1 0.1 0.1
fix m6 all property/global coefficientMaxElasticStiffness peratomtypepair 3 1.5 1.5 3.0 1.5 1.5 3.0 3.0 3.0 5.0
fix m7 all property/global coefficientAdhesionStiffness peratomtypepair 3 1.0e5 1.0e5 2.0e5 1.0e5 1.0e5 2.0e5 2.0e5 2.0e5 1.0e6
fix m8 all property/global coefficientPlasticityDepth peratomtypepair 3 0.05 0.05 0.01 0.05 0.05 0.01 0.01 0.01 0.005
fix m9 all property/global characteristicVelocity scalar 2.0

pair_style gran model hooke/hysteresis tangential history rolling_friction cdt
pair_coeff * *

compute strs all stress/atom
compute ke all ke/atom
compute cpl all pair/gran/local pos id force force_normal force_tangential torque contactArea delta contactPoint

fix zwall_bot all wall/gran model hooke/hysteresis tangential history rolling_friction cdt primitive type 1 zplane 0.0

fix integr all nve/sphere
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix top_mesh all mesh/surface/stress file ${plate_stl} type 1 scale 1.0 reference_point 0 0 0
fix zwall_top all wall/gran model hooke/hysteresis tangential history rolling_friction cdt mesh n_meshes 1 meshes top_mesh
fix damp all viscous 1.0e-5
fix_modify zwall_top energy yes

variable pressMPa equal abs(f_top_mesh[3])/0.0025/1000000
# <<< block head

# >>> block r_params — 표에서 온 숫자
variable ul_bed string ps_10_0_r45
variable ul_s0 index 3600000
variable ul_atoms0 equal 159152
variable ul_big equal 1000000000
# <<< block r_params

# >>> block r_obs — 복원 관측 (ul_ 접두 · 동역학 없음) · 벽 local = mesh 판만 (3d5c00f compute_pair_gran_local.cpp 247–269 행)
compute ul_erot all erotate/sphere
compute ul_wh all wall/gran/local id history force_normal
variable ul_Ps equal f_top_mesh[3]/0.0025/1000000
thermo_style custom step atoms ke c_ul_erot v_ul_Ps v_pressMPa cpu
thermo 1000
# <<< block r_obs

# >>> block un_start — 보조 소거 진단 restart 를 새 프로세스로 · 같은 머리 (벽 다시 정의 = 이력 0 에서) · PRE · POST 관측 (진단 전용)
variable ul_step equal step
variable ul_step equal ${ul_step}
variable ul_na equal atoms
variable ul_na equal ${ul_na}
print "UL_UN_START bed=${ul_bed} step=${ul_step} atoms=${ul_na}"
write_dump all custom ${out}/obs/un_pre_bot.dump id type x y z radius mass vx vy vz omegax omegay omegaz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4] modify format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump ul_uw all local ${ul_big} ${out}/obs/un_post_wall_*.dump c_ul_wh[1] c_ul_wh[2] c_ul_wh[3] c_ul_wh[4] c_ul_wh[5] c_ul_wh[6] c_ul_wh[7] c_ul_wh[8] c_ul_wh[9] c_ul_wh[10]
dump_modify ul_uw first yes format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump ul_ua all custom ${ul_big} ${out}/obs/un_post_atom_*.dump id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4]
dump_modify ul_ua first yes format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
undump ul_uw
undump ul_ua
print "UL_UN_DONE bed=${ul_bed} step=${ul_step}"
# <<< block un_start
