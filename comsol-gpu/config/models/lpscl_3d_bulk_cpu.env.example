# CPU 기준선 (벤치마크용 쌍둥이). 같은 물리/메시, Direct 솔버만 CPU(PARDISO).
# 복사:  cp config/models/lpscl_3d_bulk_cpu.env.example config/models/lpscl_3d_bulk_cpu.env
#
# 사용: bash scripts/benchmark.sh --cpu lpscl_3d_bulk_cpu --gpu lpscl_3d_bulk
MODEL_NAME=lpscl_3d_bulk_cpu
# CPU 솔버로 저장한 별도 mph (권장). 없으면 동일 파일을 가리켜도 되지만
# 그 경우 솔버가 cuDSS면 둘 다 GPU로 돌아 비교가 안 됨 — 반드시 CPU 솔버 버전을 둘 것.
MPH_FILE=models/0.1C_31x31x40_LPSCl_5e-6_bulk_cpu.mph
STUDY=
SOLVER=pardiso
USE_GPU=false
NP=8
HWACC=
EXTRA_FLAGS=
NOTES="3D SSB LPSCl bulk — CPU(PARDISO) 기준선"
