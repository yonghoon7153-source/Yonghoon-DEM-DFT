# P2D(Newman/DFN) 예시 — GPU 효과 거의 없음(작은 DOF). CPU로 두는 게 정상.
# 이런 모델은 GPU 대신 "여러 케이스 배치 스윕"에 쓰세요.
# 복사:  cp config/models/p2d_baseline.env.example config/models/p2d_baseline.env
MODEL_NAME=p2d_baseline
MPH_FILE=models/p2d_baseline.mph
STUDY=
SOLVER=pardiso       # CPU 직접솔버로 충분 (cuDSS로 바꿔도 더 느려질 수 있음)
USE_GPU=false
NP=4
HWACC=
EXTRA_FLAGS=
NOTES="P2D Newman — 소규모, GPU 비권장. 파라미터 스윕 throughput용."
