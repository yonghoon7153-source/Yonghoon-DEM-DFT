====== PLATE HEIGHT: 0.142972437242453 ======

# 동적 plate STL (RVE 50×50 μm → Sim 0.05×0.05 m)
print "solid plate" file plate_kg50_d07_b50.stl screen no
print "facet normal 0 0 -1" append plate_kg50_d07_b50.stl screen no
print "outer loop" append plate_kg50_d07_b50.stl screen no
print "vertex 0.0 0.0 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "vertex 0.05 0.05 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "vertex 0.05 0.0 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "endloop" append plate_kg50_d07_b50.stl screen no
print "endfacet" append plate_kg50_d07_b50.stl screen no
print "facet normal 0 0 -1" append plate_kg50_d07_b50.stl screen no
print "outer loop" append plate_kg50_d07_b50.stl screen no
print "vertex 0.0 0.0 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "vertex 0.0 0.05 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "vertex 0.05 0.05 ${plate_z}" append plate_kg50_d07_b50.stl screen no
print "endloop" append plate_kg50_d07_b50.stl screen no
print "endfacet" append plate_kg50_d07_b50.stl screen no
print "endsolid plate" append plate_kg50_d07_b50.stl screen no

# --- 10. Phase 2: Stabilize ---
fix top_mesh all mesh/surface/stress file plate_kg50_d07_b50.stl type 1 scale 1.0 reference_point 0 0 0
WARNING: Mesh for fix mesh/surface/stress has been scaled, moved, or rotated.
Please note that values for 'reference_point' refer to the scaled, moved, or rotated configuration (../mesh_module_stress.cpp:104)
fix zwall_top all wall/gran model hooke/hysteresis tangential history rolling_friction cdt mesh n_meshes 1 meshes top_mesh

dump dmp_mesh all mesh/stl 5000 post_kg50_d07_b50/mesh_*.stl top_mesh

print "====== PHASE 2: STABILIZE ======"
====== PHASE 2: STABILIZE ======
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
unfix damp
fix damp all viscous 0.5
# RVE 면적: 0.05 × 0.05 = 0.0025 m²
variable pressMPa equal abs(f_top_mesh[3])/0.0025/1000000
thermo_style    custom step atoms ke cpu v_pressMPa
thermo 1000
run 200000
