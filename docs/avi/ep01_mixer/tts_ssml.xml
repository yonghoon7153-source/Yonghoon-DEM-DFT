<?xml version="1.0" encoding="UTF-8"?>
<!-- SSML 1.1 (예비 · 1순위 아님). 엔진마다 지원하는 태그가 다르다 — prosody rate / break / emphasis 만 썼다. -->
<speak version="1.1" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="ko-KR">
  <!-- S01 · 도입 — 같은 가루, 다른 결과 -->
  <p>
    <s><prosody rate="100%">전고체 배터리의 양극은, <emphasis level="moderate">두 가지 가루</emphasis>를 섞어서 만듭니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="103%">리튬을 담아 두는 <emphasis level="moderate">큰 알갱이</emphasis>와, 이온이 지나가는 길이 되는 <emphasis level="moderate">작은 알갱이</emphasis>죠.</prosody></s><break time="700ms"/>
    <s><prosody rate="105%">그런데 <emphasis level="moderate">같은</emphasis> 재료를, 같은 비율로 섞어도요.</prosody></s><break time="350ms"/>
    <s><prosody rate="100%">섞는 <emphasis level="moderate">방법</emphasis>만 바꾸면, 결과가 달라집니다.</prosody></s><break time="600ms"/>
    <s><prosody rate="104%">독일의 한 연구진이, 셀을 아홉 개씩 만들어 봤는데요.</prosody></s><break time="350ms"/>
    <s><prosody rate="100%">평균 용량은 거의 같았지만, <emphasis level="moderate">들쭉날쭉한 정도</emphasis>가 달랐어요.</prosody></s><break time="500ms"/>
    <s><prosody rate="92%">손으로 섞으면 <emphasis level="moderate">오 점 일</emphasis> 퍼센트, 기계로 흔들어 섞으면 <emphasis level="moderate">일 점 사</emphasis> 퍼센트였습니다.</prosody></s><break time="800ms"/>
    <s><prosody rate="97%">작은 가루가 큰 가루를 <emphasis level="moderate">덮을까요</emphasis>, 아니면 자기들끼리 <emphasis level="moderate">뭉칠까요</emphasis>?</prosody></s><break time="850ms"/>
    <s><prosody rate="100%">오늘은 그걸 <emphasis level="moderate">정하는 힘</emphasis>과, <emphasis level="moderate">아직 모르는</emphasis> 것을 차례로 보겠습니다.</prosody></s><break time="1500ms"/>
  </p>
  <!-- S02 · 양극 안 — 큰 알갱이와 작은 알갱이 -->
  <p>
    <s><prosody rate="105%">먼저 양극 안을 들여다볼게요.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">큰 알갱이는 <emphasis level="moderate">활물질</emphasis>입니다.</prosody></s><break time="300ms"/>
    <s><prosody rate="103%">니켈과 코발트, 망간이 들어간 산화물 알갱이죠.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">작은 알갱이는 <emphasis level="moderate">황화물 고체전해질</emphasis>이고요.</prosody></s><break time="450ms"/>
    <s><prosody rate="93%">한 연구에서 쓴 가루를 보면, 활물질은 <emphasis level="moderate">사 점 삼</emphasis> 마이크로미터, 고체전해질은 <emphasis level="moderate">영 점 칠</emphasis> 마이크로미터였어요.</prosody></s><break time="750ms"/>
    <s><prosody rate="104%">액체 전해질이라면, 알아서 구석구석 스며들겠죠.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">하지만 고체는 <emphasis level="moderate">스며들지 않거든요</emphasis>.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">그래서 작은 알갱이들이 큰 알갱이 곁에 고루 자리 잡고, 서로 <emphasis level="moderate">이어져야</emphasis> 합니다.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">이 배치의 밑그림을 그리는 단계가, 바로 가루를 <emphasis level="moderate">섞는 과정</emphasis>이에요.</prosody></s><break time="1500ms"/>
  </p>
  <!-- S03 · 작을수록 끈적하다 — 본드 수 -->
  <p>
    <s><prosody rate="100%">그런데 아주 고운 가루는, 잘 섞이지 않습니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="103%">입자들 사이에는, 늘 서로 <emphasis level="moderate">당기는 힘</emphasis>이 있거든요.</prosody></s><break time="450ms"/>
    <s><prosody rate="96%">두 알갱이를 떼어 내는 데 드는 힘은, 알갱이의 <emphasis level="moderate">크기에 비례</emphasis>합니다.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">반면 무게는, 크기의 <emphasis level="moderate">세제곱</emphasis>에 비례하죠.</prosody></s><break time="500ms"/>
    <s><prosody rate="95%">그래서 지름이 열 배 작아지면, 붙는 힘은 <emphasis level="moderate">십 분의 일</emphasis>이 되지만, 무게는 <emphasis level="moderate">천 분의 일</emphasis>이 됩니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="95%">무게에 견준 끈적함이, <emphasis level="moderate">백 배</emphasis>로 커지는 거예요.</prosody></s><break time="700ms"/>
    <s><prosody rate="100%">이 비율을 <emphasis level="moderate">본드 수</emphasis>라고 부릅니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">본드 수가 크면, 가루는 무게보다 끈적함을 따라 움직여요.</prosody></s><break time="600ms"/>
    <s><prosody rate="100%">실제로 칼날 혼합기를 가장 느리게 돌린 조건에서는, 고체전해질이 <emphasis level="moderate">활물질만 한 덩어리</emphasis>로 남아 있었습니다.</prosody></s><break time="1500ms"/>
  </p>
  <!-- S04 · 누구와 붙을까 — 힘의 비율 -->
  <p>
    <s><prosody rate="97%">그럼 작은 가루는, 누구와 붙을까요?</prosody></s><break time="850ms"/>
    <s><prosody rate="100%">길은 두 가지입니다.</prosody></s><break time="300ms"/>
    <s><prosody rate="100%"><emphasis level="moderate">자기들끼리</emphasis> 뭉치거나, 아니면 큰 알갱이 <emphasis level="moderate">표면에</emphasis> 붙는 거예요.</prosody></s><break time="600ms"/>
    <s><prosody rate="103%">여기서 <emphasis level="moderate">크기</emphasis>가 한 번 더 일을 합니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">작은 알갱이가 큰 알갱이에 닿으면, 상대 표면이 거의 평평하게 느껴지거든요.</prosody></s><break time="450ms"/>
    <s><prosody rate="95%">그래서 같은 끈적함이라면, 작은 알갱이끼리보다 큰 알갱이에 붙는 쪽이, <emphasis level="moderate">최대 두 배</emphasis>까지 세게 붙습니다.</prosody></s><break time="650ms"/>
    <s><prosody rate="100%">하지만 표면 자체의 끈적함이 다르면, 이야기가 달라지죠.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">큰 알갱이 표면이 훨씬 덜 끈적하다면, 작은 알갱이는 자기들끼리 뭉치는 쪽을 고릅니다.</prosody></s><break time="500ms"/>
    <s><prosody rate="95%">결국 승부는, 작은 알갱이끼리 붙는 힘과, 큰 알갱이에 붙는 힘의 <emphasis level="moderate">비율</emphasis>이에요.</prosody></s><break time="750ms"/>
    <s><prosody rate="100%">분체 과학에서는, 이런 힘의 비율로 섞일지 갈라질지를 가르는 지도를 그려 왔습니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">다만 건식 가루에 대한 그 지도는, 컴퓨터 속 매끈한 <emphasis level="moderate">가상 알갱이</emphasis>로 그린 거예요.</prosody></s><break time="500ms"/>
    <s><prosody rate="97%">작은 알갱이가 큰 알갱이의 절반 크기일 때는, 네 경우 중 <emphasis level="moderate">두 번</emphasis>이 예측과 <emphasis level="moderate">반대로</emphasis> 나왔고요.</prosody></s><break time="400ms"/>
    <s><prosody rate="97%">끈적함을 두 배로 키우자, 넷 중 셋이 다시 들어맞았습니다.</prosody></s><break time="550ms"/>
    <s><prosody rate="100%"><emphasis level="moderate">비율 하나만으로는</emphasis>, 다 정해지지 않는다는 뜻이죠.</prosody></s><break time="1500ms"/>
  </p>
  <!-- S05 · 약을 만드는 분야가 먼저 판 문제 — 정렬 혼합과 힘의 비율 -->
  <p>
    <s><prosody rate="103%">사실 이 문제를 오래 파 온 분야가 있어요.</prosody></s><break time="350ms"/>
    <s><prosody rate="100%">바로 <emphasis level="moderate">약</emphasis>을 만드는 쪽입니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">들이마시는 흡입약은 흔히, 아주 고운 약 가루를 훨씬 큰 유당 가루에 붙여서 만들거든요.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">작은 가루가 큰 가루 표면에 붙으면서 섞이는 이 방식을, <emphasis level="moderate">정렬 혼합</emphasis>이라고 불렀습니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="102%">나중에는, <emphasis level="moderate">상호작용 혼합</emphasis>이라는 이름이 제안됐고요.</prosody></s><break time="450ms"/>
    <s><prosody rate="97%">두 크기가 열 배에서 백 배쯤 차이 날 때, 작은 가루가 큰 가루에 잘 붙는다고 알려져 있죠.</prosody></s><break time="450ms"/>
    <s><prosody rate="95%">앞서 본 전고체 양극 가루에서는, 그 차이가 <emphasis level="moderate">여섯 배</emphasis> 정도였어요.</prosody></s><break time="750ms"/>
    <s><prosody rate="100%">그리고 이천사 년, 영국 연구진이 그 힘을 <emphasis level="moderate">직접</emphasis> 쟀습니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">원자힘현미경의 아주 작은 막대 끝에, 약 가루 한 알을 붙였어요.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">그리고 같은 약의 결정과 유당의 결정에, 번갈아 눌렀다 떼면서 힘을 쟀죠.</prosody></s><break time="350ms"/>
    <s><prosody rate="94%">한 쌍마다, <emphasis level="moderate">사천구십육 번</emphasis>씩이요.</prosody></s><break time="700ms"/>
    <s><prosody rate="100%">결과는 뚜렷하게 갈렸습니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="95%">한 약은, 유당에 붙는 힘이 자기끼리 붙는 힘의 <emphasis level="moderate">열일곱 배</emphasis>쯤 됐어요.</prosody></s><break time="400ms"/>
    <s><prosody rate="96%">다른 약은 반대로, 자기끼리 붙는 힘이 많게는 <emphasis level="moderate">네 배</emphasis> 가까이 셌고요.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">실제로 섞어 보니, 앞의 약은 유당 위에 고르게 퍼졌고, 뒤의 약은 덩어리로 남았습니다.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">힘의 비율로, 섞인 모습을 <emphasis level="moderate">미리</emphasis> 내다본 셈이죠.</prosody></s><break time="800ms"/>
    <s><prosody rate="103%">그런데 이야기가 여기서 끝나지는 않아요.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">이천팔 년에는, 약과 운반 입자 조합 열여섯 가지를 같은 방법으로 견줘 봤어요.</prosody></s><break time="400ms"/>
    <s><prosody rate="97%">그랬더니 운반 입자별로 보면 흡입 성능과는 관계가 보였지만, 섞임의 고르기와는 뚜렷한 관계가 <emphasis level="moderate">보이지 않았습니다</emphasis>.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">힘의 비율은 중요한 <emphasis level="moderate">단서</emphasis>이지만, 그것만으로 결과가 정해지지는 않는 거죠.</prosody></s><break time="1500ms"/>
  </p>
  <!-- S06 · 미리 덮어 두면 — 코팅이 바꾸는 균형 -->
  <p>
    <s><prosody rate="105%">이제 배터리로 돌아와 볼게요.</prosody></s><break time="350ms"/>
    <s><prosody rate="97%">큰 알갱이 표면을, <emphasis level="moderate">미리</emphasis> 고체전해질로 <emphasis level="moderate">얇게</emphasis> 덮어 두면 어떨까요?</prosody></s><break time="850ms"/>
    <s><prosody rate="100%">작은 알갱이 입장에서는, 큰 알갱이가 자기와 같은 물질로 보이게 됩니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">표면 끈적함의 차이가 <emphasis level="moderate">사라지는</emphasis> 거죠.</prosody></s><break time="450ms"/>
    <s><prosody rate="102%">그러면 크기에서 오는 이점만 남게 되고요.</prosody></s><break time="350ms"/>
    <s><prosody rate="100%">작은 알갱이가 큰 알갱이 쪽에 붙기 쉬워질 거라고 <emphasis level="moderate">기대할</emphasis> 수 있습니다.</prosody></s><break time="650ms"/>
    <s><prosody rate="100%">다만, 표면을 바꾼다고 <emphasis level="moderate">늘</emphasis> 좋아지는 건 아닙니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">세제 가루를 다룬 한 연구에서는, 한 성분을 코팅해 끈적하게 만들자, 성분이 갈라지는 정도가 줄었어요.</prosody></s><break time="400ms"/>
    <s><prosody rate="98%">그런데 계산에서 끈적함을 더 키우자, 고운 가루가 들러붙은 덩어리가 생기면서, <emphasis level="moderate">오히려</emphasis> 더 갈라졌습니다.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">끈적함에도, <emphasis level="moderate">알맞은 정도</emphasis>가 있다는 뜻이죠.</prosody></s><break time="1450ms"/>
  </p>
  <!-- S07 · 황화물 고체전해질에서는 쟀을까 -->
  <p>
    <s><prosody rate="97%">그럼 황화물 고체전해질에서는, 이 힘을 재 봤을까요?</prosody></s><break time="850ms"/>
    <s><prosody rate="100%">저희 연구실이 참여한 연구에서는, 조성이 다른 황화물 <emphasis level="moderate">다섯 가지</emphasis>를 원자힘현미경으로 재 봤습니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">실리콘 탐침을 눌렀다 떼면서, 떼어 낼 때 드는 일인 <emphasis level="moderate">접착일</emphasis>과, 단단함을 함께 쟀어요.</prosody></s><break time="450ms"/>
    <s><prosody rate="102%">같은 가루로, 활물질에 건식 코팅도 해 봤어요.</prosody></s><break time="350ms"/>
    <s><prosody rate="100%">그러자 접착일을 포함한 기계적 성질이, 붙지 않고 남은 고체전해질 비율과 <emphasis level="moderate">함께 변했습니다</emphasis>.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">저자들은, 부착이 중요한 역할을 한다고 <emphasis level="moderate">제안</emphasis>했고요.</prosody></s><break time="600ms"/>
    <s><prosody rate="100%">다만 이건 실리콘 탐침과 재료 사이의 힘이에요.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">고체전해질끼리, 그리고 고체전해질과 활물질 사이의 힘을 같은 탐침으로 견준 자료는요.</prosody></s><break time="300ms"/>
    <s><prosody rate="100%">저희가 살펴본 문헌 안에서는, <emphasis level="moderate">아직</emphasis> 보지 못했습니다.</prosody></s><break time="1450ms"/>
  </p>
  <!-- S08 · 더 세게 섞으면 — 칼날 혼합기 실험 -->
  <p>
    <s><prosody rate="97%">그럼, 더 세게 섞으면 해결될까요?</prosody></s><break time="850ms"/>
    <s><prosody rate="100%">일본의 한 연구진은, 칼날이 빠르게 도는 혼합기로 두 가루를 섞어 봤습니다.</prosody></s><break time="400ms"/>
    <s><prosody rate="95%">칼날을 일 분에 <emphasis level="moderate">오천</emphasis> 번 돌리다가, <emphasis level="moderate">이만 오천</emphasis> 번까지 올렸죠.</prosody></s><break time="400ms"/>
    <s><prosody rate="100%">빠를수록 덩어리가 풀렸고, 가장 빠를 때는 작은 가루 대부분이 활물질 위에 붙었어요.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">그런데 일부는, 혼합기 <emphasis level="moderate">벽</emphasis>에 달라붙어 버렸습니다.</prosody></s><break time="450ms"/>
    <s><prosody rate="94%">계산해 보면, 가장 빠를 때 넣은 고체전해질의 <emphasis level="moderate">이십칠 퍼센트</emphasis>쯤이 빠져나간 셈이에요.</prosody></s><break time="700ms"/>
    <s><prosody rate="100%">그리고 이온이 통하는 정도는, 회전 속도와 상관없이 거의 <emphasis level="moderate">그대로</emphasis>였죠.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">저자들은 그 이유로, 혼합물 속 고체전해질 양이 달라진 점을 들었어요.</prosody></s><break time="450ms"/>
    <s><prosody rate="100%">세게 섞는다고, 늘 답이 되는 건 아니라는 거죠.</prosody></s><break time="500ms"/>
    <s><prosody rate="100%">분체 연구들에서도, 세게 저을수록 좋은지는 조건에 따라 엇갈리고요.</prosody></s><break time="1450ms"/>
  </p>
  <!-- S09 · 눌린 뒤의 이온 길 — 아직 열린 질문 -->
  <p>
    <s><prosody rate="100%">이제 가장 궁금한 질문이 남았습니다.</prosody></s><break time="400ms"/>
