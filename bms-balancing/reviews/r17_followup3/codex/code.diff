+def receipt_map(consumed) -> dict:
+    """`{역할: sha256}` — 두 실행의 **입력 identity** 를 이것으로 댄다 (Codex R11 P1-1)."""
+    return {role: (str(leaf.get("sha256", "")) if isinstance(leaf, dict) else "")
+            for role, leaf in receipt_leaves(receipt_text(consumed))}
