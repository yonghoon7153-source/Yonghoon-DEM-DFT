    tstress     = .true.
    etot_conv_thr = 1.0d-6
    forc_conv_thr = 1.0d-4
    nstep        = 200
/
&SYSTEM
    ibrav       = 0
    nat         = 62
    ntyp        = 4
    ecutwfc     = 70.0
    ecutrho     = 560.0
