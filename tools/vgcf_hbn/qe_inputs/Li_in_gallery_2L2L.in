&CONTROL
    calculation     = 'relax'
    prefix          = 'Li_in_galler'
    outdir          = './tmp'
    pseudo_dir      = '$PSEUDO_DIR'
    tprnfor         = .true.
    forc_conv_thr   = 1.0d-3
    nstep           = 200
    disk_io         = 'low'
/
&SYSTEM
    ibrav           = 0
    nat             = 129
    ntyp            = 4
    ecutwfc         = 60.0
    ecutrho         = 480.0
    occupations     = 'smearing'
    smearing        = 'mv'
    degauss         = 0.01
    nspin           = 2
    starting_magnetization(4) = 0.4
    vdw_corr        = 'grimme-d3'
    dftd3_version   = 4
/
&ELECTRONS
    conv_thr        = 1.0d-6
    mixing_beta     = 0.3
    electron_maxstep = 200
/
&IONS
    ion_dynamics    = 'bfgs'
/
