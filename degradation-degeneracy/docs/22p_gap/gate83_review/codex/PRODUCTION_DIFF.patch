+    want = (planned_env.get("inputs") or {}).get("curves_sha256")
+    for p in sorted((Path(run_dir) / "_inputs").glob("*_curves.parquet")):
+        if want and hashlib.sha256(p.read_bytes()).hexdigest() == want:
+            return p
+    return None
