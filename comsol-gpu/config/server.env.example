# 복사해서 사용:  cp config/server.env.example config/server.env
# (server.env 는 .gitignore 처리됨 — 접속정보 커밋 방지)

# ===== 서버 접속 (로컬에서 remote.sh 사용 시) =====
SSH_HOST=121.78.116.27
SSH_USER=root
SSH_OPTS=                         # 예: "-p 22 -i ~/.ssh/id_ed25519"
REMOTE_DIR=~/Yonghoon-DEM-DFT     # 서버에 클론된 레포 경로

# ===== COMSOL (서버에서 실행 시) =====
COMSOL_BIN=comsol                 # PATH에 없으면 풀경로 지정, 예:
# COMSOL_BIN=/usr/local/comsol64/multiphysics/bin/comsol

# 라이선스 (필요 시). 배치/멀티-GPU는 보통 플로팅 네트워크 라이선스(FNL).
# LMCOMSOL_LICENSE_FILE=1718@license-server
