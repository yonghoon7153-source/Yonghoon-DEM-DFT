+#: 모르는 확장자는 `unknown` 이다 — 추측하지 않는다 (부재는 안전값이 아니다).
+READER_BY_EXT = {".csv": "pandas.read_csv", ".xlsx": "pandas.read_excel", ".xls": "pandas.read_excel"}
