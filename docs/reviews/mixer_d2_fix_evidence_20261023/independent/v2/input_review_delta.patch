+    # Independent review follow-up: consume actual gravity, preserve active-phase API,
+    # and stop description line breaks before they can become deck commands.
+    def _mxd_review_gravity():
+        txt, _ = _mxd_deck(bo=0.73)
+        gravity_line = next(ln for ln in txt.splitlines() if ln.split()[:4] == ['fix', 'gravi', 'all', 'gravity'])
+        tokens = gravity_line.split()
+        tokens[4] = '1.0'
+        altered = txt.replace(gravity_line, ' '.join(tokens), 1)
+        return (txt != altered and abs(_mxd_bo_tokens(txt) / 0.73 - 1.0) < 2e-5
+                and abs(_mxd_bo_tokens(altered) / (0.73 * 9.81) - 1.0) < 2e-5)
+    chk('MXDR1 actual deck gravity participates in independently read Bo (9.81 → 1 changes Bo ×9.81)',
+        _ok(_mxd_review_gravity))
+
+    def _mxd_review_active_phases():
+        before = TYPES
+        nm = 'MXDACTIVE'
