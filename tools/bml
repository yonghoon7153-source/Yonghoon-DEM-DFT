#: CRLF 로 체크아웃된 스크립트만 LF 로 되돌린다.
#:
#: `git rm --cached -r . && git reset --hard` 를 대신하는 것이 목적이다. 그
#: 처방은 줄바꿈과 무관한 미커밋 작업까지 전부 날리는데, 이 저장소는
#: --autostash 로 "커밋 안 해도 잃지 않는다" 를 전제로 굴러간다. .gitattributes
#: 가 인덱스를 이미 LF 로 잡고 있으므로, 걸린 파일의 CR 만 지우면 작업 트리가
#: 수렴한다 — git 상태는 건드리지 않는다.
cmd_repair_crlf() {
  step "줄바꿈 점검"
  local found=()
  while IFS= read -r file; do
    head -1 "$file" 2>/dev/null | grep -q $'\r' && found+=("$file")
  done < <(find "$REPO/tools" "$REPO/.claude/hooks" -type f \
             \( -name '*.sh' -o -name '*.py' -o -name 'bml' \) 2>/dev/null)

  if [ ${#found[@]} -eq 0 ]; then
    ok "CRLF 인 스크립트가 없습니다."
    return 0
  fi

  local file
  for file in "${found[@]}"; do
    # 원본을 남기지 않고 제자리에서 CR 만 지운다. 내용은 그대로다.
    sed -i 's/\r$//' "$file" && say "  ${DIM}고침: ${file#"$REPO"/}${OFF}"
  done
  ok "${#found[@]}개 파일을 LF 로 되돌렸습니다."
  say "  ${DIM}다시 겪지 않으려면: git config --global core.autocrlf input${OFF}"
}

cmd_doctor() {
  local problems=0
  say "${B}환경 점검${OFF}  ${DIM}$REPO${OFF}"
  say ""

  # --- WSL ------------------------------------------------------------------
  if is_wsl; then
    local wsl_version="WSL"
    grep -qi 'wsl2' /proc/sys/kernel/osrelease 2>/dev/null && wsl_version="WSL2"
    grep -qi 'microsoft-standard-WSL2' /proc/version 2>/dev/null && wsl_version="WSL2"
    ok "$wsl_version (${WSL_DISTRO_NAME:-배포판 이름 없음})"

    case "$REPO" in
      /mnt/[a-z]/*)
        warn "저장소가 Windows 드라이브($REPO)에 있습니다."
        say  "  ${DIM}파일 접근이 10배 이상 느리고, bml dev 의 자동 새로고침이 잘 안 됩니다.${OFF}"
        say  "  ${DIM}WSL 안(~/)으로 옮기길 권합니다:${OFF}"
        say  "  ${DIM}  git clone <저장소> ~/Yonghoon-DEM-DFT${OFF}"
        problems=$((problems + 1))
        ;;
      *) ok "저장소가 WSL 파일시스템에 있습니다 (빠름)" ;;
    esac

    if command -v wslview >/dev/null 2>&1; then
      ok "브라우저 열기: wslview"
    elif command -v explorer.exe >/dev/null 2>&1; then
      ok "브라우저 열기: explorer.exe"
      say "  ${DIM}더 깔끔하게 하려면: sudo apt install wslu${OFF}"
    else
      warn "브라우저를 자동으로 못 엽니다. 주소를 직접 여세요: $URL"
    fi

    # .exe 를 부를 수 있는가.  이 저장소는 이제 여기에 기댄다.
    local ib_names ib_entry
    ib_names="$(ls /proc/sys/fs/binfmt_misc/ 2>/dev/null | tr '\n' ' ')"
    ib_entry="$(cat /proc/sys/fs/binfmt_misc/WSLInterop /proc/sys/fs/binfmt_misc/WSLInterop-late 2>/dev/null)"
    case "$(interop_state "$ib_names" "$ib_entry")" in
      ok) ok "Windows 프로그램 실행 (interop)" ;;
      wiped|disabled)
        warn "Windows 프로그램(.exe)을 부를 수 없습니다 — binfmt 에 WSLInterop 등록이 없습니다."
        say  "  ${DIM}오류는${OFF} ${DIM}'cannot execute binary file: Exec format error' 로만 나옵니다 —${OFF}"
        say  "  ${DIM}그 문구에 WSL 도 interop 도 없어서 원인을 찾을 수 없습니다.${OFF}"
        say  "  ${DIM}/etc/wsl.conf 에 systemd=true 가 있으면 WSL 이 등록을 systemd 에 맡기는데,${OFF}"
        say  "  ${DIM}systemd 는 WSL 안에서 그 서비스를 건너뜁니다 (ConditionVirtualization=!wsl).${OFF}"
        say  ""
        say  "  ${B}지금 살리기${OFF} ${DIM}(커널에 직접. WSL 을 껐다 켜면 사라집니다)${OFF}"
        interop_repair_now | while IFS= read -r c; do say "    ${GREEN}${c}${OFF}"; done
        say  "  ${DIM}확인:${OFF} ${GREEN}ipconfig.exe | head -3${OFF}"
        say  ""
        say  "  ${B}다음 부팅에도 살리기${OFF}"
        interop_repair_persist | while IFS= read -r c; do say "    ${GREEN}${c}${OFF}"; done
        say  ""
        say  "  ${DIM}systemd 가 꼭 필요한 게 아니면${OFF} ${GREEN}/etc/wsl.conf${OFF} ${DIM}의 systemd=true 를 빼고${OFF}"
        say  "  ${DIM}PowerShell 에서${OFF} ${GREEN}wsl --shutdown${OFF} ${DIM}해도 됩니다 — 이 워크벤치는 systemd 를 안 씁니다.${OFF}"
        ;;
      *) say "  ${DIM}interop 상태를 확인하지 못했습니다 (binfmt_misc 가 안 보입니다).${OFF}" ;;
    esac

    local wsl_ip
    wsl_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$wsl_ip" ] && say "  ${DIM}localhost 가 안 되면 Windows 에서: http://${wsl_ip}:${PORT}${OFF}"
    say ""
  fi

  # --- 저장소가 실제로 이 프로젝트인지 --------------------------------------
  #
  # main 브랜치는 비어 있다.  그냥 클론하면 파일이 하나도 없는 폴더를 받게 되고,
  # make 는 "Nothing to be done" 을, 셸은 "bml: command not found" 를 뱉는다.
  # 둘 다 원인을 말해 주지 않으므로 여기서 짚는다.
  local missing=()
  for required in Makefile packages/wrdkit/src/wrdkit apps/api/app apps/web/src; do
    [ -e "$REPO/$required" ] || missing+=("$required")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    printf '%s✕%s 저장소에 워크벤치 파일이 없습니다 (없는 것: %s)\n' \
      "$RED" "$OFF" "${missing[*]}"
    if [ -z "$(git -C "$REPO" ls-tree -r --name-only HEAD 2>/dev/null | head -1)" ]; then
      say "  ${DIM}이 브랜치는 비어 있습니다. 작업 브랜치로 옮기세요:${OFF}"
      say "    git -C \"$REPO\" fetch origin"
      say "    git -C \"$REPO\" checkout $WORKBENCH_BRANCH"
    else
      # 여기서 checkout 을 시키면 안 된다.  이 폴더에 들어 있는 다른 프로젝트가
      # 통째로 사라진다 — 실제로 그렇게 DFT 판을 날린 적이 있다.
      say "  ${DIM}이 폴더에는 다른 프로젝트가 들어 있습니다. checkout 하지 마세요 —${OFF}"
      say "  ${DIM}그쪽 파일이 사라집니다. worktree 로 각자 폴더를 주세요:${OFF}"
      say "    git -C \"$REPO\" worktree add ~/bml $WORKBENCH_BRANCH"
      say "    cd ~/bml && ./tools/bml install && bml"
    fi
    problems=$((problems + 1))
  else
    local branch
    branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    ok "프로젝트 파일 정상 (브랜치 ${branch})"
  fi

  # --- bml 명령 자체 ----------------------------------------------------------
  #
  # `bml doctor` 를 `./tools/bml doctor` 로 부를 수도 있으므로, 이 검사가 돌고
  # 있다는 것이 `bml` 이 PATH 에 있다는 뜻은 아니다.  실제로 걸린 자리다:
  # clone → make setup 까지 했는데 `bml` 이 없어서 command not found 가 났다.
  local bml_on_path; bml_on_path="$(command -v bml 2>/dev/null)"
  if [ -z "$bml_on_path" ]; then
    warn "bml 명령    PATH 에 없습니다 — 'bml' 로 못 부릅니다."
    say "  ${GREEN}$REPO/tools/bml install${OFF} ${DIM}한 번이면 등록됩니다.${OFF}"
    problems=$((problems + 1))
  elif [ "$(readlink -f "$bml_on_path" 2>/dev/null)" != "$(readlink -f "$SCRIPT" 2>/dev/null)" ]; then
    # 두 클론(예: worktree)이 있으면 PATH 의 bml 이 다른 트리를 가리킬 수 있다.
    # 그러면 여기서 고친 것이 저기서 안 보인다.
    warn "bml 명령    $bml_on_path — 지금 이 트리($SCRIPT)가 아닙니다."
    say "  ${DIM}이 트리를 쓰려면${OFF} ${GREEN}$REPO/tools/bml install${OFF}"
    problems=$((problems + 1))
  else
    ok "bml 명령    $bml_on_path"
  fi

  # --- 줄바꿈 (WSL 에서 가장 흔한 사고) ---------------------------------------
  #
  # bml 자신이 CRLF 면 애초에 실행되지 않고 "bad interpreter" 만 뜬다.  그래서
  # 여기서는 나머지 스크립트를 훑는다 — 훅이나 tools/*.py 가 CRLF 면 나중에
  # 엉뚱한 곳에서 터진다.
  local crlf=()
  while IFS= read -r file; do
    head -1 "$file" 2>/dev/null | grep -q $'\r' && crlf+=("$file")
  done < <(find "$REPO/tools" "$REPO/.claude/hooks" -type f \
             \( -name '*.sh' -o -name '*.py' -o -name 'bml' \) 2>/dev/null)

  if [ ${#crlf[@]} -gt 0 ]; then
    printf '%s✕%s CRLF 줄바꿈인 스크립트가 %d개 있습니다 — WSL 에서 실행되지 않습니다.\n' \
      "$RED" "$OFF" "${#crlf[@]}"
    printf '  %s\n' "${crlf[@]}"
    say "  ${DIM}고치기:${OFF}"
    say "    git config --global core.autocrlf input"
    # `git rm --cached -r . && git reset --hard` 를 처방하지 않는다.  CRLF 한
    # 줄을 고치자고 저장소 전체의 미커밋 변경을 말없이 날린다 — 이 저장소는
    # --autostash 로 "커밋 안 해도 잃지 않는다" 를 전제로 굴러가는데 정반대다.
    # .gitattributes 가 인덱스를 이미 LF 로 잡고 있으므로, 걸린 파일의 CR 만
    # 지우면 작업 트리가 수렴한다 — git 상태는 건드리지 않는다.
    say "    bml repair crlf"
    problems=$((problems + 1))
  else
    ok "줄바꿈 LF (정상)"
  fi

  # --- python ---------------------------------------------------------------
  if command -v python3 >/dev/null 2>&1; then
    ok "python3 $(python3 -V 2>&1 | awk '{print $2}')"
    if ! python3 -c "import ensurepip" >/dev/null 2>&1; then
      printf '%s✕%s python3-venv 가 없습니다 (Ubuntu 기본 미포함).\n' "$RED" "$OFF"
      say "  ${DIM}설치: sudo apt update && sudo apt install -y python3-venv python3-pip${OFF}"
      problems=$((problems + 1))
    else
      ok "python3-venv 사용 가능"
    fi

    if [ -x "$REPO/.venv/bin/python" ]; then
      if python_ready; then
        ok "가상환경 런타임 정상"
      else
        printf '%s✕%s 가상환경이 깨져 있습니다 — 서버는 뜨지만 요청마다 500 이 납니다.\n' \
          "$RED" "$OFF"
        python_problem | tail -4 | sed 's/^/    /'
        say "  ${DIM}해결: ${OFF}${GREEN}bml repair${OFF}"
        problems=$((problems + 1))
      fi
    else
      say "  ${DIM}가상환경 없음 — 첫 bml 실행 때 만들어집니다.${OFF}"
    fi
  else
    printf '%s✕%s python3 이 없습니다.  ${DIM}sudo apt install -y python3 python3-venv python3-pip${OFF}\n' "$RED" "$OFF"
    problems=$((problems + 1))
  fi

  # --- node -----------------------------------------------------------------
  if command -v node >/dev/null 2>&1; then
    local node_major
    node_major="$(node -v | sed 's/v\([0-9]*\).*/\1/')"
    if [ "${node_major:-0}" -ge 18 ] 2>/dev/null; then
      ok "node $(node -v)"
    else
      warn "node $(node -v) — 18 이상이 필요합니다."
      say "  ${DIM}Ubuntu 기본 저장소는 오래됐습니다. nodesource 를 쓰세요:${OFF}"
      say "  ${DIM}  curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - && sudo apt install -y nodejs${OFF}"
      problems=$((problems + 1))
    fi
  else
    printf '%s✕%s node 가 없습니다.\n' "$RED" "$OFF"
    say "  ${DIM}curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - && sudo apt install -y nodejs${OFF}"
    problems=$((problems + 1))
  fi

  command -v git >/dev/null 2>&1 && ok "git $(git --version | awk '{print $3}')" \
    || { printf '%s✕%s git 이 없습니다.\n' "$RED" "$OFF"; problems=$((problems + 1)); }
  command -v curl >/dev/null 2>&1 && ok "curl" \
    || { warn "curl 이 없습니다 — 서버 준비 확인이 느려집니다. sudo apt install -y curl"; }

  # --- PATH -----------------------------------------------------------------
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ok "~/.local/bin 이 PATH 에 있습니다" ;;
    *)
      warn "~/.local/bin 이 PATH 에 없습니다 — 'bml' 이 안 잡힙니다."
      say "  ${DIM}echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.bashrc && exec bash${OFF}"
      problems=$((problems + 1))
      ;;
  esac

  # --- 포트 -----------------------------------------------------------------
  if port_busy "$PORT"; then
    server_state
    case $? in
      0) ok "포트 $PORT — 워크벤치가 정상 실행 중" ;;
      1)
        warn "포트 $PORT — 서버는 떴는데 정상 응답하지 않습니다."
        say "  ${DIM}해결: ${OFF}${GREEN}bml repair${OFF}"
        problems=$((problems + 1))
        ;;
      *)
        owns_port "$PORT"
        case $? in
          0) say "  ${DIM}포트 $PORT — 이전 bml 프로세스. 'bml' 이 갈아끼웁니다.${OFF}" ;;
          1)
            warn "포트 $PORT 를 bml 이 아닌 다른 프로그램이 쓰고 있습니다."
            say "  ${DIM}WORKBENCH_PORT=6001 bml  로 옮길 수 있습니다.${OFF}"
            ;;
          *)
            warn "포트 $PORT 가 사용 중인데 소유자를 알 수 없습니다."
            say "  ${DIM}sudo apt install -y lsof  하면 확인할 수 있습니다.${OFF}"
            ;;
        esac
        ;;
    esac
  else
    ok "포트 $PORT 사용 가능"
  fi

  say ""
  if [ "$problems" -eq 0 ]; then
    ok "문제 없습니다. 'bml' 로 시작하세요."
  else
    warn "$problems 건을 먼저 해결하세요. 자세한 설명: docs/guides/wsl-setup.md"
    return 1
  fi
}

#: 새 터미널이 열릴 때 읽는 파일.
#:
#: 지금 돌고 있는 셸이 아니라 `$SHELL`(로그인 셸)을 기준으로 고른다 — 사람이
#: 다음에 여는 터미널이 실제로 읽는 것은 그쪽이다.  `bash tools/bml install`
#: 처럼 잠깐 bash 로 실행했다고 zsh 사용자의 `.bashrc` 에 적으면, 새 터미널에서
#: 여전히 안 된다.
shell_rc() {
  case "${SHELL:-}" in
    */zsh)  printf '%s' "$HOME/.zshrc" ;;
    */bash) printf '%s' "$HOME/.bashrc" ;;
    *)      [ -f "$HOME/.bashrc" ] && printf '%s' "$HOME/.bashrc" ;;
  esac
  return 0
}

#: 이 명령을 PATH 에 등록한다.
#:
#: 링크만 만들고 "PATH 는 알아서 하세요" 로 끝내면 안 된다.  `bml install` 을
#: 시킨 바로 다음 줄에서 `bml: command not found` 가 나고, 사람은 설치가 실패한
#: 줄 안다 — 실제로 그렇게 됐다.  이 명령의 이름이 install 인 이상, 셸 설정
#: 한 줄까지가 이 명령의 일이다.
#:
#: 그러면서도 두 가지는 지킨다: 같은 줄을 두 번 넣지 않고, 지금 이 터미널에
#: 반영하는 방법을 함께 준다 (rc 는 **새** 터미널에서만 읽힌다 — 이걸 안 주면
#: "넣었다는데 여전히 안 된다" 가 된다).
#: PATH 에 놓을 껍데기 한 장을 쓴다.
#:
#: 예전에는 심볼릭 링크였다.  그런데 링크가 가리키는 파일이 사라지면 bash 는
#: **`No such file or directory` 한 줄만** 뱉고, 그 문장에는 무엇이 없는지가
#: 없다 — 사람은 자기가 명령을 잘못 친 줄 안다.  실측으로 그렇게 막혔다:
#: 한 폴더에서 브랜치를 바꾸면 워크벤치 파일이 통째로 사라지는데(§0.7),
#: 화면에 남은 것은 그 한 줄뿐이었다.
#:
#: 껍데기는 없어진 것이 무엇인지 보고 그때그때 맞는 명령을 준다.  그리고
#: `exec` 로 넘기므로 그 뒤는 예전과 똑같다.
#:
#: 이름을 환경변수로 넘기는 이유: 셔뱅(`#!`)을 거치면 커널이 argv[0] 을 스크립트
#: 경로로 갈아치우므로 `exec -a` 로 넘긴 별칭이 사라진다.  `bmlin`/`bmlout` 이
#: 어느 이름으로 불렸는지는 그 한 글자에 달려 있다.
#: 값을 셸이 **다시 읽어도 그대로인** 형태로 만든다.
#:
#: 생성한 실행기에 `REAL="/tmp/Battery $100/repo/tools/bml"` 이 적히면, 다음
#: 실행 때 `$1` 이 다시 펼쳐져서 실제 파일이 있어도 엉뚱한 경로를 찾는다.
#: 따옴표·역슬래시·역따옴표도 같다.  작은따옴표로 감싸고 안의 작은따옴표만
#: 떼어 붙이면 셸 문법이 남지 않는다.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

#: 실행기 한 장.  성공하면 0, 못 쓰면 1.
#:
#: 최종 경로에 바로 쓰지 않는다.  중간에 끊기거나 디스크가 차면 **빈/잘린
#: 실행기**가 남아서, 다음부터 `bml` 이 조용히 아무 일도 안 한다.  같은 폴더의
#: 임시 파일에 쓰고, 다 들어갔는지 확인한 뒤 옮긴다.  옛 심볼릭 링크 위로
#: 옮기는 것도 안전하다 -- mv 는 링크를 따라가지 않는다 (cat > 는 따라가서
#: 저장소의 tools/bml 을 덮어썼다).
write_launcher() {
  # 한 `local` 안에서 앞 변수를 참조하지 않는다.  `set -u` 아래의 bash 는
  # 이름을 **먼저 다 만든 뒤** 대입해서, `local a="$1" b="$a.x"` 가
  # "a: unbound variable" 로 죽는다.
  local path="$1" name="$2" rc
  local tmp="$path.new.$$"
  cat > "$tmp" <<LAUNCHER
#!/usr/bin/env bash
# bml — Yonghoon Battery Lab Workbench.  \`bml install\` 이 만든 실행기.
# 이 파일은 고치지 마세요.  \`./tools/bml install\` 이 다시 씁니다.
REAL=$(shquote "$SCRIPT")
REPO=$(shquote "$REPO")
BRANCH=$(shquote "$WORKBENCH_BRANCH")
if [ ! -r "\$REAL" ]; then
  # **브랜치를 오가도 죽지 않는다.**
  #
  # 이 저장소에는 프로젝트가 둘이고 각자 다른 브랜치에 산다.  한 폴더에서
  # 브랜치를 바꾸면 상대 프로젝트 파일이 통째로 사라지고, 그 순간 이 실행기가
  # 가리키던 파일도 없어진다 -- 실제로 그렇게 막혔다.  같은 저장소의 다른
  # 작업 폴더(worktree)에 워크벤치가 살아 있으면 그쪽으로 간다.
  if command -v git >/dev/null 2>&1; then
    while IFS= read -r line; do
      case "\$line" in
        "worktree "*)
          dir="\${line#worktree }"
          if [ -r "\$dir/tools/bml" ]; then REAL="\$dir/tools/bml"; break; fi
          ;;
      esac
    done <<WORKTREES
\$(git -C "\$REPO" worktree list --porcelain 2>/dev/null)
WORKTREES
  fi
fi
if [ ! -r "\$REAL" ]; then
  printf '\\033[31m✕\\033[0m bml 을 찾지 못했습니다: %s\\n' "\$REAL" >&2
  if [ -d "\$REPO/.git" ] || [ -f "\$REPO/.git" ]; then
    here="\$(git -C "\$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    printf '  저장소는 있는데 그 파일이 없습니다 (지금 브랜치: %s)\\n' "\${here:-?}" >&2
    printf '\\n  이 저장소에는 프로젝트가 둘입니다 — 브랜치를 바꾸면 상대 프로젝트\\n' >&2
    printf '  파일이 통째로 사라집니다.  워크벤치로 돌아가려면:\\n\\n' >&2
    printf '    \\033[32mgit -C "%s" switch %s\\033[0m\\n\\n' "\$REPO" "\$BRANCH" >&2
    printf '  두 브랜치를 같이 쓰려면 폴더를 나눕니다 -- 한 번만 하면 됩니다:\\n\\n' >&2
    printf '    \\033[32mgit -C "%s" worktree add ~/bml %s\\033[0m\\n' "\$REPO" "\$BRANCH" >&2
    printf '    \\033[32mcd ~/bml && ./tools/bml install\\033[0m\\n\\n' >&2
    printf '  그 뒤로는 어느 폴더가 어느 브랜치에 있든 bml 이 삽니다.\\n' >&2
  else
    printf '  저장소 폴더가 없습니다: %s\\n' "\$REPO" >&2
    printf '  옮겼거나 다시 클론했다면 그 폴더에서 한 번:\\n' >&2
    printf '    \\033[32m./tools/bml install\\033[0m\\n' >&2
  fi
  exit 1
fi
BML_INVOKED_AS=$(shquote "$name") exec "\$REAL" "\$@"
LAUNCHER
  rc=$?
  if [ "$rc" -ne 0 ]; then rm -f "$tmp"; return 1; fi
  # 다 들어갔는지 본다.  ENOSPC 는 오류 없이 잘린 파일을 남기는 수가 있다.
  if ! grep -q 'BML_INVOKED_AS' "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi
  # 이 heredoc 은 값을 끼워 넣어야 해서 따옴표를 못 씌운다.  그래서 본문에
  # 역따옴표나 $( ) 가 들어가면 **쓰는 순간 실행되어** 그 출력이 파일에 박힌다.
  # 실제로 주석에 적은 역따옴표 한 쌍 때문에 bml 이 실행돼 그 출력이 들어갔고,
  # 실행기는 그 줄들을 명령으로 읽었다.  색 문자가 보이면 그런 사고다.
  if LC_ALL=C grep -q "$(printf '\033')" "$tmp" 2>/dev/null; then
    rm -f "$tmp"; return 1
  fi
  if ! chmod +x "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi
  if ! mv "$tmp" "$path" 2>/dev/null; then rm -f "$tmp"; return 1; fi
  return 0
}

cmd_install() {
  local target="${1:-$HOME/.local/bin}"
  if ! mkdir -p "$target" 2>/dev/null; then
    printf '%s✕%s 설치할 폴더를 만들지 못했습니다: %s\n' "$RED" "$OFF" "$target" >&2
    say "  ${DIM}권한을 확인하거나 다른 곳을 주세요:${OFF} ${GREEN}bml install ~/bin${OFF}"
    return 1
  fi
  # 자리 바꾸기용 두 이름은 같은 파일을 부르므로 bml 을 고치면 같이 따라온다.
  local name
  for name in bml bmlin bmlout bmlonly; do
    # 못 쓰면 **거기서 멈춘다.**  예전에는 실패해도 "설치" 를 출력하고 rc 파일까지
    # 고친 뒤 0 으로 끝났다 -- PATH 는 잡혔는데 실행기가 없는, 가장 헷갈리는
    # 상태다 (`bash: .../bml: No such file or directory`).
    if ! write_launcher "$target/$name" "$name"; then
      printf '%s✕%s 실행기를 쓰지 못했습니다: %s\n' "$RED" "$OFF" "$target/$name" >&2
      say "  ${DIM}권한이나 남은 공간을 확인하세요:${OFF} ${GREEN}ls -ld \"$target\"${OFF}"
      say "  ${DIM}PATH 는 건드리지 않았습니다.${OFF}"
      return 1
    fi
  done
  ok "설치: $target/bml  ${DIM}(+ bmlin · bmlout · bmlonly)${OFF}"

  case ":$PATH:" in
    *":$target:"*)
      say "${DIM}PATH 에 이미 있습니다. 'bml' 로 바로 쓰세요.${OFF}"
      return 0
      ;;
  esac

  local rc line
  line="export PATH=\"$target:\$PATH\""
  rc="$(shell_rc)"

  # 주석은 세지 않는다.  `.bashrc` 에 `# old /home/me/.local/bin` 한 줄만 있어도
  # "이미 있습니다" 로 판단해 PATH 추가를 건너뛰었고, 새 터미널에서는 여전히
  # bml 이 없었다.  `$HOME` 으로 적힌 형태도 같은 줄로 본다.
  local spelled="$target"
  case "$target" in "$HOME"/*) spelled="\$HOME/${target#"$HOME"/}" ;; esac
  local body=""
  [ -n "$rc" ] && body="$(grep -v '^[[:space:]]*#' "$rc" 2>/dev/null || true)"
  if [ -n "$body" ] && { printf '%s\n' "$body" | grep -qF -- "$target" \
                         || printf '%s\n' "$body" | grep -qF -- "$spelled"; }; then
    say "${DIM}${rc} 에 이미 그 줄이 있습니다 — 이 터미널에만 아직 반영이 안 됐습니다.${OFF}"
  elif [ -n "$rc" ]; then
    if printf '\n# bml — Yonghoon Battery Lab Workbench\n%s\n' "$line" >> "$rc" 2>/dev/null; then
      ok "${rc} 에 PATH 한 줄을 넣었습니다 — 새 터미널부터 'bml' 이 됩니다."
    else
      warn "${rc} 에 쓰지 못했습니다. 아래 한 줄을 직접 넣으세요:"
      say "  $line"
    fi
  else
    warn "셸 설정 파일을 찾지 못했습니다. 아래 한 줄을 직접 넣으세요:"
    say "  $line"
  fi

  say ""
  say "  ${B}지금 이 터미널에서 바로 쓰려면:${OFF}"
  say "    ${GREEN}${line}${OFF}"
}

cmd_help() {
  # The header comment block is the help text; print it until the first
  # non-comment line so the two can never drift apart.
  awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$SCRIPT"
}

# --- 진입점 ------------------------------------------------------------------
main() {
  # `bmlin` / `bmlout` 은 이 파일을 부르는 다른 이름이다.  별칭을 기계마다 손으로
  # 관리하면 반드시 어긋나고(특히 터널 주소가 바뀔 때), `bml` 을 고쳐도 별칭은
  # 안 따라온다.  불린 이름으로 첫 인자를 붙여 주면 한 파일로 끝난다.
  #
  # 껍데기가 이름을 환경변수로 넘긴다 -- 셔뱅을 거치면 커널이 argv[0] 을 스크립트
  # 경로로 갈아치워서 `$0` 로는 알 수 없다.  옛 심볼릭 링크로 설치된 기계도
  # 있으므로 `$0` 를 예비로 남긴다.
  # 시험이 **동작으로** 확인할 수 있게 두 개의 창구를 둔다.  실행기의 생성
  # 문자열을 검사하면 인용 방식을 고칠 때마다 애먼 시험이 깨지고, 정작
  # 특수문자 경로에서 실제로 깨지는 것은 못 잡는다.
  if [ -n "${BML_PRINT_REAL:-}" ]; then printf '%s\n' "$SCRIPT"; return 0; fi
  if [ -n "${BML_PRINT_INVOKED_AS:-}" ]; then
    printf '%s\n' "${BML_INVOKED_AS:-$(basename "${0:-bml}")}"
    return 0
  fi

  case "${BML_INVOKED_AS:-$(basename "${0:-bml}")}" in
    bmlin)  set -- in  "$@" ;;
    bmlout) set -- out "$@" ;;
    bmlonly) set -- only "$@" ;;
  esac

  # sync_repo 가 재실행할 때 쓸 원래 인자.
  BML_ARGV=()
  [ $# -gt 0 ] && BML_ARGV=("$@")

  # 워크벤치 체크아웃일 때만 상태 폴더를 만든다.  guard_workbench_checkout 가
  # 잡아 주기 전에 bml 이 남의 저장소에 .bml 을 남기는 일을 막는다.
  [ -z "$(workbench_missing)" ] && need_run_dir

  case "${1:-serve}" in
    serve|start|up|"")
      # 중추 서버가 정해져 있으면 서버를 **띄우지는** 않는다 (ADR 0011).
      # 그래도 저장소는 맞춘다: 이 기계의 bml·문서·스킬이 전부 저장소에서
      # 오므로, 안 맞추면 그 기계만 클론한 시점에 얼어붙는다.  그리고 중추
      # 서버 자신에게 `bml use` 가 걸려 있으면 이 분기 때문에 **아무도** 코드를
      # 갱신하지 않게 되는데, 화면은 멀쩡해서 티가 안 난다.
      if [ -n "$SERVER" ]; then sync_repo; cmd_connect
      else sync_repo; ensure_deps; start_serve; fi
      ;;
    dev)
      # dev 는 코드를 고칠 때 쓰는 것이라, 중추 서버가 있어도 자기 서버를
      # 띄운다.  다만 그때 보이는 데이터가 다르다는 것은 말해 준다.
      [ -n "$SERVER" ] && warn "이 기계의 데이터(${DATA_DIR})로 띄웁니다 — 중추 서버(${SERVER})가 아닙니다."
      sync_repo; ensure_deps; start_dev
      ;;
    stop|down)         cmd_stop ;;
    restart)
      # 터널을 살려 둔다.  restart 가 터널을 닫으면 주소가 바뀌고, 코드를 고칠
      # 때마다 다른 기계마다 `bmlout <새 주소>` 를 다시 쳐야 한다.
      #
      # 그리고 **멈추기 전에 먼저 받는다.**  pull 과 빌드는 포트가 필요 없으므로
      # 옛 서버가 서비스하는 동안 해도 되고, 그러면 내려가 있는 시간이 몇 초로
      # 줄어 터널 너머에서 503 을 볼 창도 그만큼 좁아진다.  (sync_repo 가 자기
      # 자신을 갱신하면 여기서 exec 로 다시 시작하는데, 그때 아직 아무것도 안
      # 멈춘 상태인 것도 이 순서라야 맞다.)
      #
      # serve 와 같은 이유로 여기서도 맞춘다.  restart 는 "고친 것을 반영해
      # 달라" 는 뜻이라, 갱신을 건너뛰면 정확히 그 요청을 배신한다.
      if [ -n "$SERVER" ]; then
        sync_repo; cmd_stop --keep-tunnel
        keep_tunnel_promise
        cmd_connect
        promise_kept
      else
        sync_repo; ensure_deps; cmd_stop --keep-tunnel
        keep_tunnel_promise
        start_serve
        promise_kept
      fi
      ;;
    pull|sync|update)
      # 중추 서버가 정해져 있으면 이 기계는 **브라우저**다 (ADR 0011) -- 파서도
      # API 도 여기서 돌지 않으므로 파이썬 환경이 필요 없다.  `serve` 분기는
      # 이미 이 규칙을 지키고 있었는데 `pull` 만 빠져서, 남의 서버만 보는
      # 기계에서 1~3분짜리 설치가 돌고 python3-venv 가 없으면 거기서 죽었다.
      # 저장소는 맞춘다 -- bml·문서·스킬이 전부 거기서 온다.
      sync_repo
      # `pull` 은 "실행 없이 최신으로만 맞춘다" 이다.  이미 있는 환경은 맞춰
      # 주되 **없는 환경을 새로 만들지는 않는다**: 1~3분짜리 설치는 맞추기가
      # 아니고, 갓 클론한 기계에서 그 기계가 서버가 될지 브라우저가 될지는
      # 아직 아무도 말한 적이 없다 (ADR 0011).  띄울 때 `bml` 이 어차피 한다.
      if [ -n "$SERVER" ]; then
        ok "최신 상태입니다. ${DIM}(중추 서버 ${SERVER} 를 보는 기계라 의존성은 건너뜁니다)${OFF}"
      elif [ -x "$REPO/.venv/bin/python" ]; then
        ensure_deps; ok "최신 상태입니다."
      else
        ok "최신 상태입니다."
        say "  ${DIM}파이썬 환경은 아직 없습니다 — 필요할 때 만듭니다:${OFF}"
        say "    ${GREEN}bml${OFF}                ${DIM}이 기계에서 서버를 띄운다 (그때 설치합니다)${OFF}"
        say "    ${GREEN}bmlin${OFF}${DIM}/${OFF}${GREEN}bmlout <주소>${OFF} ${DIM}남의 서버를 본다 (파이썬이 아예 필요 없습니다)${OFF}"
      fi
      ;;
    status|st)         cmd_status ;;
    mirrored|mirror)   cmd_mirrored ;;
    check|test)        cmd_check ;;
    feed|worklog)      shift; cmd_feed "${1:-}" ;;
    logs|log)          tail -f "$LOG" ;;
    doctor|diag)       cmd_doctor ;;
    repair|fix)
      shift
      case "${1:-}" in
        web)  cmd_repair_web ;;
        crlf) cmd_repair_crlf ;;
        "")   cmd_repair ;;
        *)    die "모르는 repair 대상: $1   (web | crlf | 없음)" ;;
      esac
      ;;
    backup)            shift; cmd_backup "${1:-}" ;;
    data)              shift; cmd_data "${1:-}" ;;
    host|public)       shift; cmd_host "${1:-}" ;;
    use|server)        shift; cmd_use "${1:-}" ;;
    # **맞추기가 먼저다.**  `sync_repo` 는 자기 자신이 갱신되면 원래 명령줄로
    # 다시 실행한다(exec) -- 뒤에 두면 그 앞에서 이미 끝낸 일이 통째로 한 번
    # 더 돌고, 그 두 번째가 잠깐의 네트워크 사정으로 실패하면 **성공한 뒤에
    # 빨간 ✕ 가 찍힌다.**  사람은 마지막 줄을 믿는다.  앞에 두면 재실행은
    # 아무 일도 하기 전에 일어나고, 두 번째 sync 는 "Already up to date" 다.
    in|lan)            shift; sync_repo; cmd_slot in  "${1:-}"; cmd_connect ;;
    out|wan)           shift; sync_repo; cmd_slot out "${1:-}"; cmd_connect ;;
    # `out` 과 나눠 둔 이유는 cmd_only 의 주석에 있다 -- 멀쩡한 기계에서 sudo 를
    # 묻거나 hosts 를 건드리게 되면 안 된다.
    only)              shift; sync_repo; cmd_only "${1:-}" "${2:-}"; cmd_connect ;;
    password|passwd)   shift; cmd_password "${1:-}" ;;
    share|tunnel)
      shift
      # `bml share key ...` 는 터널을 열지 않는다 -- 어느 키로 열지만 적는다.
      if [ "${1:-}" = "key" ]; then shift; cmd_share_key "${1:-}"; else
        cmd_share "${1:-}"; fi
      ;;
    install)           shift; cmd_install "${1:-$HOME/.local/bin}" ;;
    help|-h|--help)    cmd_help ;;
    *) cmd_unknown "$1" ;;
  esac
}

# Sourcing this file defines the functions **including `main`**, so the tests can
# drive whole commands rather than counting strings in the source.  `main` used
# to sit below this guard, which is why the restart path had no behavioural test
# at all -- and why a `bml restart` that died half-way left a tunnel with no
# server behind it, unnoticed.  Nothing but the tests sets this.
if [ -n "${BML_SOURCE_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

# 이 한 줄이 파일의 마지막이어야 한다.
#
# bml 은 pull 을 먼저 하는데, 그 pull 이 바로 이 파일을 갈아치운다.  bash 는
# 스크립트를 통째로 읽지 않고 파일 오프셋을 기억했다가 다음 명령을 읽을 때
# 그 자리로 되돌아간다.  그래서 실행 중에 파일이 바뀌면 새 파일의 엉뚱한 바이트
# 위치에 착지해 줄 중간부터 실행한다 — 옛 코드와 새 코드가 섞여 돌고, 이미
# 고친 버그가 되살아난 것처럼 보인다 (실제로 그렇게 옛 에러 메시지가 나왔다).
#
# main 을 함수로 두면 본문 전체가 실행 전에 파싱돼 메모리에 남고, 중괄호 묶음은
# 하나의 복합 명령이라 exit 까지 함께 파싱된다.  따라서 main 이 끝나면 파일을
# 다시 읽지 않고 그대로 종료한다.  여기 뒤에 아무것도 두지 말 것.
{ main "$@"; exit $?; }
