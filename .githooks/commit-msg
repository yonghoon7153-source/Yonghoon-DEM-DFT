#!/usr/bin/env bash
#
# 커밋마다 docs/log.md 에 같은 제목의 한 줄이 있는지 본다 (bml 과 같은 규칙).
#   커밋 제목  `fix: 제목`   ↔   docs/log.md  `## [YYYY-MM-DD] fix | 제목`
# 다른 세션은 대화를 볼 수 없으므로 "왜" 는 로그에 남긴다. 막지는 않고 크게 말한다.
# NIHON_LOG_STRICT=1 이면 막는다.
set -uo pipefail
msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0
repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
subject="$(grep -v '^#' "$msg_file" 2>/dev/null | sed '/^[[:space:]]*$/d' | head -n 1)"
[ -n "$subject" ] || exit 0
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;; esac
git_dir="$(git rev-parse --git-dir 2>/dev/null)"
for marker in rebase-merge rebase-apply CHERRY_PICK_HEAD MERGE_HEAD; do [ -e "$git_dir/$marker" ] && exit 0; done
NIHON_SOURCE_ONLY=1 . "$repo/tools/nihon" 2>/dev/null || exit 0
command -v log_has_entry >/dev/null 2>&1 || exit 0
log_has_entry "$subject" "$repo/docs/log.md" && exit 0
printf '\n\033[33m!\033[0m docs/log.md 에 이 커밋의 기록이 없습니다. 같은 제목으로 한 줄 적어 주세요:\n' >&2
printf '    ## [%s] %s | %s\n' "$(date +%F)" "$(printf '%s' "$subject" | sed 's/:.*//')" "$(printf '%s' "${subject#*: }")" >&2
printf '  적은 뒤:  git add docs/log.md && git commit --amend --no-edit    현황: nihon feed\n\n' >&2
[ "${NIHON_LOG_STRICT:-}" = "1" ] && exit 1
exit 0
