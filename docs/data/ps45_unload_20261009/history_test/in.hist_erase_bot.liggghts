# ============================================================
# DEM 언로딩 키트 — 작은 침대 이력 시험 (H0–H5) · 바닥 소거
#   생성: history_test/make_history_decks.py (손으로 고치지 말 것 — 생성기를 고치고 다시 만든다 · SHA256SUMS)
#   정본: docs/data/ps45_unload_20261009/README.md §1 · 등록 §12-1 · §13-6 ③ · Codex 판정문 10-12 §5
#   변수: run_history.sh 가 -var 로 준다 — out (이 단계 폴더) · plate_stl (판 STL · 자료는 restart 에서) · ckpt (읽을 restart)
#   모델 머리 = r8 원 덱 글자 (재료 · pair · 벽 · 중력 9.81 · 감쇠 1.0e-5 · 메시) — 숫자를 다시 적지 않는다
#   소거 (H3): 소비자와 같은 관측 → run 0 (첫 초기화 · restart 보관자료 해제) → undump · uncompute → unfix zwall_bot → 진단 restart
# ============================================================

atom_style granular
atom_modify map array sort 0 0
boundary p p f
newton off
soft_particles yes
communicate single vel yes
units si

variable r_AM_P equal 4.5e-3
variable r_AM_S equal 2.0e-3
variable r_SE equal 0.5e-3
variable dt equal 1.0e-6
timestep ${dt}
processors * * 1

read_restart ${ckpt}

neighbor 0.002 bin
neigh_modify delay 0 check yes

fix m1 all property/global youngsModulus peratomtype 1.4e8 1.4e8 0.135e7
fix m2 all property/global poissonsRatio peratomtype 0.25 0.25 0.30
fix m3 all property/global coefficientRestitution peratomtypepair 3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3
fix m4 all property/global coefficientFriction peratomtypepair 3 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5
fix m5 all property/global coefficientRollingFriction peratomtypepair 3 0.2 0.2 0.1 0.2 0.2 0.1 0.1 0.1 0.1
fix m6 all property/global coefficientMaxElasticStiffness peratomtypepair 3 1.5 1.5 3.0 1.5 1.5 3.0 3.0 3.0 5.0
fix m7 all property/global coefficientAdhesionStiffness peratomtypepair 3 1.0e5 1.0e5 2.0e5 1.0e5 1.0e5 2.0e5 2.0e5 2.0e5 1.0e6
fix m8 all property/global coefficientPlasticityDepth peratomtypepair 3 0.05 0.05 0.01 0.05 0.05 0.01 0.01 0.01 0.005
fix m9 all property/global characteristicVelocity scalar 2.0

pair_style gran model hooke/hysteresis tangential history rolling_friction cdt
pair_coeff * *

compute strs all stress/atom
compute ke all ke/atom
compute cpl all pair/gran/local pos id force force_normal force_tangential torque contactArea delta contactPoint

fix zwall_bot all wall/gran model hooke/hysteresis tangential history rolling_friction cdt primitive type 1 zplane 0.0

fix integr all nve/sphere
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix top_mesh all mesh/surface/stress file ${plate_stl} type 1 scale 1.0 reference_point 0 0 0
fix zwall_top all wall/gran model hooke/hysteresis tangential history rolling_friction cdt mesh n_meshes 1 meshes top_mesh
fix damp all viscous 1.0e-5
fix_modify zwall_top energy yes

variable pressMPa equal abs(f_top_mesh[3])/0.0025/1000000
thermo_style custom step atoms ke cpu v_pressMPa

thermo 1
variable hb_step_now equal step
variable hb_step0 equal ${hb_step_now}
variable hb_n_now equal atoms
variable hb_n0 equal ${hb_n_now}
print "HIST_CONSUMER_START step=${hb_step0} atoms=${hb_n0}"
# PRE_SETUP — read_restart 뒤 벽 정의로 primitive 배열이 풀린 자리 · 첫 setup 전 (write_dump = 덤프 init → write · system setup 없음)
write_dump all custom ${out}/pre_atoms.dump id type x y z radius mass vx vy vz omegax omegay omegaz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4] modify format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
# POST_SETUP — run 0 의 setup · local 재평가 뒤 (deltaMax 상한 갱신 · 분리 소거 가능 · 시간 적분 없음)
compute hb_wh all wall/gran/local id history
compute hb_ph all pair/gran/local id history
dump hb_dw all local 1000000 ${out}/post_mesh_*.dump c_hb_wh[1] c_hb_wh[2] c_hb_wh[3] c_hb_wh[4] c_hb_wh[5] c_hb_wh[6] c_hb_wh[7]
dump_modify hb_dw first yes format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump hb_dp all local 1000000 ${out}/post_pair_*.dump c_hb_ph[1] c_hb_ph[2] c_hb_ph[3] c_hb_ph[4] c_hb_ph[5] c_hb_ph[6] c_hb_ph[7]
dump_modify hb_dp first yes format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump hb_da all custom 1000000 ${out}/post_atoms_*.dump id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4]
dump_modify hb_da first yes format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
undump hb_dw
undump hb_dp
undump hb_da
# 소거 경로 (판정문 §5-3): 활성 wall local compute 를 둔 벽 unfix 는 거부 → 덤프 · compute 를 먼저 푼다
uncompute hb_wh
uncompute hb_ph
unfix zwall_bot
write_restart ${out}/erased.bin
print "HIST_ERASE_DONE mode=bot step=${hb_step0}"
