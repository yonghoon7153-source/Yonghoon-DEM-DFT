+            self.assert_fail(rb.read_d2(aa,rebound(aa,am)))
+            self.assert_fail(dd.diff_d2_decks(aa,bb,rebound(aa,am),rebound(bb,bm)))
+
+    def test_meta_binding_and_numeric_boundaries(self):
