+def _pair_dup_counts(id1, id2):
+    """무순서 쌍 기준 (고유 쌍 수, 두 번 이상 나온 쌍 수, 초과 행 수, 자기쌍 행 수) — a–b 와 b–a 는 같은 쌍이다.
