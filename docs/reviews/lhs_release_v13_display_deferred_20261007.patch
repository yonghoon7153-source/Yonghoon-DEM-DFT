+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""LHS 인계 v1.3 의 웹앱 화면 (webapp/app.py · templates/single.html) — 고립 전해질 `se_isolated_pct` · τ 표시 이름 "수송 tortuosity"
+(1저자 비준 10-06 밤 · J20-l "코드 → 웹앱 순차").
+
+  python3 webapp/test_v13_webapp_display.py      # 종료코드 0 = PASS
+
+⚠ `webapp/app.py` 는 세대 2 194 배치의 **발사 봉인 29 파일** 중 하나다 (`docs/reviews/lhs_network_batch_registration_20261007_g2.md` §3 —
+화면 문구만 바꿔도 봉인 지문이 바뀐다).  그래서 v1.3 의 app.py · single.html 변경을 검사하는 것은 **이 파일에만** 모았다: 발사 전에 v1.3 생성기만
+먼저 들이고 화면은 발사 뒤에 들이려면 {app.py · single.html · 이 파일 · check_all 의 이 줄} 을 함께 빼면 나머지 시험은 그대로 초록이다
+(`docs/reviews/lhs_release_v13_plan_20261007.md` §7).
+
+[S] 고립 전해질 (= 100 − Top Reachable) — 인계 생성기 (`scripts/lhs_design_dataset.py` 유도 묶음 se_isolation) 가 `se_isolated_pct` =
+100 − `top_reachable_pct` 를 싣는 날, 웹앱도 **같은 이름 · 같은 정의 · 같은 한정어**로 보여 준다 — AM 경로 고립 (`am_ionic_isolated_pct` =
+100 − `ionic_active_pct` · test_ionic_isolation_labels.py) 과 같은 규칙: 등록된 상단 2r 경계 띠 (분리막 쪽) 와 SE 접촉 그래프로 이어지지 않은 SE ·
+외톨이 SE 를 연결로 세어 약간 적게 잡는다 · 비관통 침대에 몰린다 · 그래프 지표 (이온 전류 · 계면 저항은 계산하지 않는다).  웹앱은 계산하지 않고
+표시만 한다 (full_metrics 에 키가 없으면 100 − Top Reachable 로 유도).
+  영문 라벨 · 역방향 라벨 맵 · 케이스 툴팁 · 표 순서 · 옛 케이스 보정 · 그룹 비교 (열 · 보정 · 낮을수록 좋음) · MD 보고서 · 쉬운 설명
+[K] τ 표시 이름 (1저자 10-05 밤 *"τ² 이라 표현하지 말고 그냥 수송 tortuosity"* · 10-06 밤 비준 = v1.3 인계 묶음) — 키 (tau2_* · 원 라벨) 는 그대로 ·
+화면 이름 · 툴팁 · 쉬운 설명이 같은 이름을 쓴다 · √ 값에는 그 이름을 쓰지 않는다 (√T).  (COMSOL 2D · 5 조성 러너 · 열 사전 = webapp/test_tau_labels.py K6–K8)
+[B] 표 재구성기 (rebuild_tables_from_metrics) — 같은 줄 · 같은 키
+[G] 생성기 열 사전과 같은 한정어 (외톨이 · 비관통 · 100 − top_reachable_pct)
+"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+SCRIPTS = os.path.join(ROOT, 'scripts')
+sys.path.insert(0, HERE)
+sys.path.insert(0, SCRIPTS)
+
+_ok, _fail = 0, []
+ROW = 'SE Isolated(%)'
+TOP = 'Top Reachable(%)'
+
+
+def chk(name, cond, extra=''):
+    global _ok
+    if cond:
+        _ok += 1
+        print(f'  PASS  {name}')
+    else:
+        _fail.append(name)
+        print(f'  FAIL  {name}' + (f' — {str(extra)[:300]}' if extra else ''))
+    return bool(cond)
+
+
+def _tip_block(src, key):
+    i = src.find(f"'{key}': {{")
+    if i < 0:
+        return None
+    j = src.index('{', i)
+    depth = 0
+    for k in range(j, len(src)):
+        if src[k] == '{':
+            depth += 1
+        elif src[k] == '}':
+            depth -= 1
+            if depth == 0:
+                return src[j:k + 1]
+    return None
+
+
+def section_s():
+    print('[S] 웹앱 — 고립 전해질 = 100 − Top Reachable (AM 경로 고립과 같은 규칙)')
+    import app as A
+    en = next((v for v in vars(A).values() if isinstance(v, dict) and TOP in v and isinstance(v.get(TOP), str)), {})
+    lab = en.get(ROW, '')
+    chk('S1 영문 라벨 — isolated electrolyte · = 100 − f_SE^sep (Top Reachable 의 영문 이름) · 경로 (그래프) 기준', bool(lab) and 'solated' in lab
+        and '100 −' in lab and 'f_SE^sep' in lab, repr(lab))
+    html = open(os.path.join(HERE, 'templates', 'single.html'), encoding='utf-8').read()
+    chk('S2 single.html 역방향 라벨 맵 — 영문 라벨을 내부 이름으로 되돌린다', bool(lab) and f"'{lab}': '{ROW}'" in html)
+    b = _tip_block(html, ROW) or ''
+    need = ('100 −', 'Top Reachable', '외톨이', '비관통', '2r', '그래프', '이온 전류', '계산하지 않', 'am_ionic_isolated_pct')
+    chk('S3 케이스 툴팁 — = 100 − Top Reachable · AM 경로 고립과 같은 규칙 · 외톨이 SE 한정 · 비관통에 몰림 · 그래프 지표 (이온 전류 계산 안 함)',
+        bool(b) and all(w in b for w in need), [w for w in need if w not in b])
+    import ast
+    order = None
+    for node in ast.walk(ast.parse(open(os.path.join(HERE, 'app.py'), encoding='utf-8').read())):
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == '_CANONICAL_ROW_ORDER' for t in node.targets):
+            order = ast.literal_eval(node.value)
+    o = list(order or [])
+    chk('S4 표 순서 — Top Reachable 바로 뒤', TOP in o and ROW in o and o.index(ROW) == o.index(TOP) + 1, o[o.index(TOP) - 1:o.index(TOP) + 3] if TOP in o else o[:5])
+    tables = {'network_summary': {'data': [['── 이온경로 · 연결성 ──', '', '', ''], ['SE Percolation(%)', '80.0', '80.0', '0%'],
+                                           [TOP, '88.0', '88.0', '0%'], ['Tortuosity mean', '1.5', '1.5', '0%']]}}
+    A.normalize_network_summary_layout(tables, {'top_reachable_pct': 88.0, 'percolation_pct': 80.0})
+    labs = [r[0].strip() for r in tables['network_summary']['data'] if r and isinstance(r[0], str)]
+    rows = {r[0].strip(): r for r in tables['network_summary']['data'] if r and isinstance(r[0], str)}
+    chk('S5 옛 세대 케이스 (키 없음) — 줄 = 100 − Top Reachable (12.0) 을 Top Reachable 바로 뒤에', ROW in rows and rows[ROW][1] in ('12.0', 12.0)
+        and labs.index(ROW) == labs.index(TOP) + 1, tables['network_summary']['data'])
+    t2 = {'network_summary': {'data': [[TOP, '70.0', '70.0', '0%']]}}
+    A.normalize_network_summary_layout(t2, {'top_reachable_pct': 70.0, 'se_isolated_pct': 30.0})
+    r2 = {r[0].strip(): r for r in t2['network_summary']['data'] if r and isinstance(r[0], str)}
+    chk('S6 키가 있는 케이스 — full_metrics se_isolated_pct (30.0) 를 그대로', r2.get(ROW, [None, None])[1] in ('30.0', 30.0), t2['network_summary']['data'])
+    t3 = {'network_summary': {'data': [['SE Percolation(%)', '80.0', '80.0', '0%']]}}
+    A.normalize_network_summary_layout(t3, {'percolation_pct': 80.0})
+    chk('S6b Top Reachable 줄도 값도 없으면 줄을 만들지 않는다 (0 으로 안 채움)',
+        not any(r and isinstance(r[0], str) and r[0].strip() == ROW for r in t3['network_summary']['data']))
+    keys = [x[2] for x in getattr(A, 'GROUP_DISPLAY_KEYS', []) if isinstance(x, tuple) and len(x) == 4]
+    names = {x[2]: x[0] for x in getattr(A, 'GROUP_DISPLAY_KEYS', []) if isinstance(x, tuple) and len(x) == 4}
+    groups = {x[2]: x[3] for x in getattr(A, 'GROUP_DISPLAY_KEYS', []) if isinstance(x, tuple) and len(x) == 4}
+    chk('S7 그룹 비교 — se_isolated_pct 열 (SE 네트워크 · Percolation 바로 뒤) · 낮을수록 좋음 (같은 철자)',
+        'se_isolated_pct' in keys and 'percolation_pct' in keys and keys.index('se_isolated_pct') == keys.index('percolation_pct') + 1
+        and groups.get('se_isolated_pct') == 'SE 네트워크' and names.get('se_isolated_pct') in A.GROUP_LOWER_BETTER, keys[:3])
+    m = {'top_reachable_pct': 91.0}
+    fn = getattr(A, '_group_se_isolated_cell', None)
+    chk('S8 그룹 비교 옛 세대 보정 — se_isolated_pct 가 없으면 100 − top_reachable_pct (9.0) · 있으면 그대로 · top 도 없으면 비움 (0 아님)',
+        callable(fn) and fn(dict(m)).get('se_isolated_pct') == 9.0 and fn({'top_reachable_pct': 91.0, 'se_isolated_pct': 8.5}).get('se_isolated_pct') == 8.5
+        and fn({}).get('se_isolated_pct') is None)
+    src = open(os.path.join(HERE, 'app.py'), encoding='utf-8').read()
+    chk('S8b 그룹 경로가 보정 함수를 부른다', '_group_se_isolated_cell(metrics)' in src)
+    md = next((ln for ln in src.splitlines() if 'Isolated electrolyte' in ln and '| ' in ln and 'se_isolated_pct' in ln), '')
+    chk('S9 MD 보고서 — 고립 전해질 줄 (= 100 − top-reachable · se_isolated_pct)', bool(md) and '100 −' in md, md)
+    plain = getattr(A, '_GRADE_PLAIN', {}).get('se_isolated_pct', '')
+    chk('S10 쉬운 설명 (se_isolated_pct) — 위쪽 띠까지 이어지지 않은 고체전해질 · 100 − · 비관통 · 그래프 지표', all(w in plain for w in ('100 −', '분리막', '그래프')),
+        plain)
+
+
+#: 원 라벨 (키 — 바꾸지 않는다) · webapp/test_tau_labels.py 와 같은 문자열 (손 칸)
+NEW_HDR = '── τ 비교 (Dijkstra vs Laplace · tau2 = tortuosity factor) ──'
+NEW_TAU2 = 'tau2 = φ·σ₀/σ_full (tortuosity factor · 협착 포함)'
+NEW_SQRT = 'τ_Lap,eff = √tau2 (Laplace · 협착 포함)'
+
+
+def section_k():
+    print('[K] τ 표시 이름 — 수송 tortuosity (tau2 · 제곱근 아님) · √ 값은 √T')
