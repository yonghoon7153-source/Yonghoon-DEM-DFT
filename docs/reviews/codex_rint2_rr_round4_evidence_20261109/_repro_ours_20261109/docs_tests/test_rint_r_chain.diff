+def pa14_tau():
+    """증서 ⓓ 보장 상대 오차 τ = 생산 정본 (`step3_conv_cert.CERT_TARGET_TOL` · `target_judge` 기본값 · 사슬 사본 = `ca_ext_svcf.CERT_TARGET_TOL` · 시험 S8o 대조)."""
+    import step3_conv_cert as CCm
+    return CCm.CERT_TARGET_TOL
