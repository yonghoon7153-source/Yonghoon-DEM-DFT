#!/usr/bin/env bash
set -euo pipefail
umask 077
if [[ $# -ne 2 || ( $1 != CHECK_ONLY && $1 != GO_SUYOUNG_F16_CONTACT_ONCE ) ]]; then
    echo 'Usage: bash THIS.txt CHECK_ONLY|GO_SUYOUNG_F16_CONTACT_ONCE final_F8_result.tar.gz' >&2
    exit 2
fi
mode=$1
f8=$(realpath -e -- "$2")
[[ -f "$f8" ]]
expected_f8=9dbf1dda91de65ecdf83c37497b8be34e9a77c6868512d97b2b4a2a438c0a69b
line=$(sha256sum -- "$f8")
[[ ${line%% *} == "$expected_f8" ]] || { echo FINAL_F8_MISMATCH >&2; exit 2; }
pkg=$(cd -- "$(dirname -- "$0")" && pwd -P)
cd -- "$pkg"
pin='@PIN@'
sums='@SOURCE_SUMS@'
model=2cf17b1df57396ef01505a72641e01b19629bed5
kernel=8af03f07e8149219a13baa1d1ca79c2fc87940bb991c6055769ac0beeb3a8880
[[ "$pin" =~ ^[0-9a-f]{40}$ && "$sums" =~ ^[0-9a-f]{64}$ ]] || exit 2
printf '%s  SOURCE_SHA256SUMS\n' "$sums" | sha256sum -c --status -
sha256sum -c --status SOURCE_SHA256SUMS
printf '%s  scripts/suyoung_multicontact_dev.py\n' "$kernel" | sha256sum -c --status -
for tool in taskset timeout mktemp tar sha256sum; do command -v "$tool" >/dev/null; done
py="$HOME/Yonghoon-DEM-DFT/venv/bin/python"
[[ -x "$py" ]] || { echo 'Reference WSL venv missing' >&2; exit 2; }
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 BLIS_NUM_THREADS=1
cpu=(taskset -c 0 "$py" -I -B)
"${cpu[@]}" -c 'import numpy,sys; print(sys.version.split()[0],numpy.__version__); sys.exit(0 if sys.version_info[:3]==(3,12,3) and numpy.__version__=="2.5.2" else "Reference environment mismatch")'
dir="$pkg/docs/reviews/suyoung_u6c_updated_f16_20261122"
"${cpu[@]}" "$dir/f16_candidate.py" check-setup --repo "$pkg"
"${cpu[@]}" "$dir/read_f8_f16.py" --repo "$pkg" --f8 "$f8" --check-f8
printf 'RELEASE=%s\nCONTACT_SOURCE_PIN=%s\nFINAL_F8_SHA256=%s\n' "$pin" "$model" "$expected_f8"
if [[ "$mode" == CHECK_ONLY ]]; then echo CHECK_OK; exit 0; fi

once="$HOME/suyoung_f16_contact_once_${pin:0:12}"
mkdir -- "$once" || { echo "Attempt already reserved: $once" >&2; exit 2; }
work=$(mktemp -d "$HOME/suyoung_f16_contact_work_XXXXXXXX")
ret=$(mktemp -d "$HOME/suyoung_f16_contact_return_XXXXXXXX")
run="$work/run"
mkdir -- "$run"
screen="$run/screen.txt"
printf 'DEVELOPMENT_ONLY\n' | tee "$screen"
started=$(date -u +%FT%TZ)
printf 'STARTED_UTC=%s\nWORK=%s\nRETURN_DIRECTORY=%s\n' "$started" "$work" "$ret" | tee "$once/receipt.txt"
pack() {
    local rc=$?
    trap - EXIT INT TERM HUP
    set +e
    printf 'COMMAND_RC=%d\n' "$rc" | tee -a "$screen"
    cp -- "$screen" "$ret/screen.txt" &&
    tar -czf "$ret/suyoung_f16_contact_result.tar.gz" -C "$work" run &&
    (cd -- "$ret" && sha256sum suyoung_f16_contact_result.tar.gz screen.txt > SHA256SUMS &&
     sha256sum -c SHA256SUMS && cat SHA256SUMS) ||
    { printf 'ARCHIVE_INCOMPLETE WORK=%s RETURN_DIRECTORY=%s\n' "$work" "$ret"; exit 3; }
    printf 'RETURN_DIRECTORY=%s\n' "$ret"
    exit "$rc"
}
trap pack EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
printf 'release=%s\ncontact_source_pin=%s\nsource_sums=%s\nfinal_f8_sha256=%s\nkernel_sha256=%s\nCPU=0\narm_budget_s=1740\nper_arm_hard_s=1800\nstarted_utc=%s\n' \
    "$pin" "$model" "$sums" "$expected_f8" "$kernel" "$started" > "$run/origin.txt"
cp -- SOURCE_SHA256SUMS "$run/SOURCE_SHA256SUMS"
rc=0
printf 'F16_BEGIN=%s\n' "$(date -u +%FT%TZ)" | tee -a "$screen"
timeout --signal=TERM --kill-after=5s 1795s "${cpu[@]}" "$dir/f16_candidate.py" run \
    --repo "$pkg" --out "$run/F16" --budget 1740 > "$run/F16.log" 2>&1 || rc=$?
printf 'F16_RC=%d\n' "$rc" | tee -a "$screen"
if (( rc != 0 )); then
    printf 'command_rc=%d\n' "$rc" > "$run/F16_process_stop.txt"
    if [[ -f "$run/F16/trace.csv" ]]; then
        (cd -- "$run" && sha256sum -- F16/trace.csv) >> "$run/F16_process_stop.txt"
    fi
    exit "$rc"
fi
rc=0
timeout --signal=TERM --kill-after=5s 115s "${cpu[@]}" "$dir/read_f8_f16.py" \
    --repo "$pkg" --f8 "$f8" --f16 "$run/F16" --out "$run/grid_comparison.json" > "$run/summary.log" 2>&1 || rc=$?
[[ $rc != 0 || -s "$run/grid_comparison.json" ]] || rc=4
printf 'SUMMARY_RC=%d\n' "$rc" | tee -a "$screen"
[[ $rc != 0 ]] || echo READBACK_REQUIRED | tee -a "$screen"
exit "$rc"
