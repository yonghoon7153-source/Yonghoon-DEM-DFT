# 업로드 원본과 파싱 캐시 — 절대 커밋하지 않는다.
# 디렉터리 자체는 유지하되 내용물만 무시한다.
data/uploads/*
!data/uploads/.gitkeep
data/runs/*
!data/runs/.gitkeep
*.wrd
*.wis
*.cyc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Node
node_modules/
apps/web/dist/
*.tsbuildinfo

# bml 실행 상태 (pid, 로그, 의존성 스탬프)
.bml/

# 데이터베이스
*.db
*.db-journal
*.sqlite3

# 환경
.env
.env.local

# 에디터 / OS
.DS_Store
.idea/
.vscode/
*.swp
