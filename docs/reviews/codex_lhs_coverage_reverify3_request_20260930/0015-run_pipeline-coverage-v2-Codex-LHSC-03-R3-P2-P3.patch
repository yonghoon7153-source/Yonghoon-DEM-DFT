+def _v2_frac_ok(v, num, den):
+    """분율 = 생산자 규약 `round(num / den, 6)` (분모 0 이면 None 만) — 값 · 분모의 공존을 본다 (재계산이 아니라 장부 대조 · LHSC-03 R3)."""
+    if den == 0:
+        return v is None
+    return _v2_num(v) and float(v) == round(num / den, COVERAGE_V2_FRAC_ROUND)
 
 
