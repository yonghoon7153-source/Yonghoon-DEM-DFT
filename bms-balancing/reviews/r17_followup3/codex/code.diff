+def child_ok(proc) -> bool:
+    """자식이 증거를 낼 수 있는 상태로 끝났는가 (Codex R11 P1-11: payload 를 읽기 **전에** rc 를 본다)."""
+    return getattr(proc, "returncode", None) == 0
