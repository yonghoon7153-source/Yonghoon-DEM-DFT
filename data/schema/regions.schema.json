{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regions.json",
  "type": "object",
  "required": [
    "regions"
  ],
  "properties": {
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "name",
          "color",
          "ink"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "order": {
            "type": "integer"
          },
          "name": {
            "type": "object",
            "required": [
              "ja",
              "kana",
              "ko",
              "en"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "지도 채우기 색"
          },
          "ink": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "같은 계열의 진한 글자색"
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "묶음(groups)의 id — 지도·범례는 지방으로 나뉘고, 이름 앞에 「中部 ›」 처럼 붙는다"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "큰 지방 묶음 (中部). 지도는 그리지 않고, 소속 지방의 페이지 · 図鑑 제목과 내 지방 메모(notes.regions)의 키로만 쓴다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "ink"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "name": {
            "type": "object",
            "required": [
              "ja",
              "kana",
              "ko",
              "en"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "ink": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "_comment": {
      "type": "string"
    }
  }
}
