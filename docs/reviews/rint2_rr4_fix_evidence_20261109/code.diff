+def rr4_places(atts, machine=MACH):
+    """자리 둘 (원장만) — 끝 시도 결과 줄 (폴더 증거 · 옛 쓰기) 를 믿는 다음 --resume 1 차례 (`attempt_order_problem`) · 풀기 전 사슬 다시 셈 (`resume_chain_problem`)
