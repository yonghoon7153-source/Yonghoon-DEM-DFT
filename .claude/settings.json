{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "statusLine": {
    "type": "command",
    "command": "python3 tools/claude/statusline.py",
    "refreshInterval": 10
  },
  "autoCompactEnabled": true,

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/collab/check_collab_registry.py\" --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  },

  "skillOverrides": {
    "algorithmic-art": "off",
    "slack-gif-creator": "off",
    "canvas-design": "off",
    "theme-factory": "off",
    "web-artifacts-builder": "off",
    "brand-guidelines": "off",
    "internal-comms": "off",
    "mcp-builder": "off",
    "keybindings-help": "off",
    "session-start-hook": "off",
    "morning": "off"
  }
}
