variable z_max equal c_zmax
variable plate_z equal ${z_max}+${r_AM_P}+${plate_margin}
variable plate_z equal 0.136972437242453+${r_AM_P}+${plate_margin}
variable plate_z equal 0.136972437242453+0.003+${plate_margin}
variable plate_z equal 0.136972437242453+0.003+0.003
print "====== SETTLING COMPLETE ======"
====== SETTLING COMPLETE ======
print "====== Z_MAX (center): ${z_max} ======"
====== Z_MAX (center): 0.136972437242453 ======
