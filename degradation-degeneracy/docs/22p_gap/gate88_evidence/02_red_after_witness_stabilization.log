        if self._token is None:
            raise PreserveError(
                "plan", f"{self.leg_id!r} 의 claim 을 소유 증명 없이 열었다 — "
                        "phase 를 기록할 수 없다 (진단용 읽기다)")
        if phase not in CLAIM_PHASES:
