+    def swap(d: Path):
+        (d / "a.csv").write_text("a,b\n1,3\n", encoding="utf-8")   # 같은 길이
+    ev2 = _bundle(tmp_path / "t2", _yaml_index(tmp_path), tamper=swap)
+    bad = P._verify_declared_bundle(ev2, repo_root=tmp_path / "t2")
