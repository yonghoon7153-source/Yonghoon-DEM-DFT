+def coverage_wall(ids, labels, radius, z, c1, c2, carea, plate_z, z_floor=Z_FLOOR):
+    """item 1 (09-29 · 1저자 "권고대로") — ① **벽 분할**: AM 입자를 바닥 · 플래튼 기준 `WALL_CLASSES` 로 가르고 등급마다 수 ·
