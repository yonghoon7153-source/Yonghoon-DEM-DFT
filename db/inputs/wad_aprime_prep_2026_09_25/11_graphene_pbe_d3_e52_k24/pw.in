&CONTROL
  calculation = 'vc-relax'
  prefix = '11_graphene_pbe_d3_e52_k24'
  outdir = './tmp'
  pseudo_dir = '/data/work/pseudo'
  tprnfor = .true.
  tstress = .true.
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
  nstep = 100
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 52.0
  ecutrho = 520.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.5
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = '2Dxy'
  press = 0.0
  press_conv_thr = 0.1
/

ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  2.4600000000  0.0000000000  0.0000000000
  -1.2300000000  2.1304224933  0.0000000000
  0.0000000000  0.0000000000  15.0000000000

ATOMIC_POSITIONS crystal
  C  0.3333333333  0.6666666667  0.5000000000
  C  0.6666666667  0.3333333333  0.5000000000

K_POINTS automatic
  24 24 1 0 0 0
