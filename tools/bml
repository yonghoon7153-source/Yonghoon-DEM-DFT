#!/usr/bin/env bash
#
# bml — Battery Lab Workbench 한 줄 실행기
#
#   bml            최신으로 맞추고 웹앱을 띄운다 (http://localhost:5003)
#   bml dev        같은 주소, 핫 리로드 (코드 고칠 때)
#   bml stop       띄운 것들을 내린다
#   bml restart    내리고 다시 (pull 포함)
#   bml status     지금 뭐가 돌고 있는지 + 저장소 상태
#   bml use <주소> 이 기계가 볼 중추 서버를 정한다 — 그 뒤 `bml` 은 그것을 연다
#   bml use off    해제한다 (이 기계가 자기 서버를 띄운다)
#   bmlin  [주소]  랩 안(LAN) 주소로 갈아 끼우고 연다 — 주소는 한 번만 적으면 된다
#   bmlout [주소]  밖(터널) 주소로 갈아 끼우고 연다 — 터널은 열 때마다 주소가 바뀔 수 있다
#   bmlonly [주소] 이 기계의 DNS 가 터널 도메인을 거를 때 — 공용 DNS·hosts·접속을 한 번에
#   bml data       데이터가 어느 폴더에 있는지 (외장하드 등) — `bml data <경로>` 로 옮긴다
#   bml data off   저장소 안의 data/ 로 되돌린다 (원본은 그 드라이브에 그대로)
#   bml host open  이 서버를 네트워크에 연다 (다른 기계가 보게) — `bml host local` 로 닫는다
#   bml password <암호>  바깥에 열 때 쓸 공유 암호를 정한다
#   bml share      임시 터널을 열어 다른 공유기에서도 접속하게 한다
#   bml share stop 그 터널을 닫는다
#   bml share key <경로>  등록한 SSH 키로 연다 — 주소가 매번 바뀌지 않는다
#   bml feed       이 브랜치에서 무슨 일이 있었나 (커밋 ↔ docs/log.md 짝)
#   bml check      커밋 전 검사 (테스트·타입·린트·문서)
#   bml pull       실행 없이 최신으로만 맞춘다
#   bml logs       실행 로그 보기
#   bml mirrored   WSL 을 mirrored 로 (다른 기계가 이 서버를 보게, WSL 에서 실행)
#   bml doctor     환경 점검 (WSL 포함) — 안 되면 여기부터
#   bml repair     파이썬 환경을 새로 만든다 (의존성이 꼬였을 때)
#   bml repair web node_modules 와 빌드를 새로 만든다
#   bml repair crlf CRLF 로 체크아웃된 스크립트만 LF 로 되돌린다
#   bml backup <폴더> 다시 만들 수 없는 것만 다른 곳으로 복사한다
#   bml install    이 명령을 PATH 에 등록한다 (1회)
#
# 두 사람이 같은 브랜치를 쓰므로, 실행 전에 항상 pull --rebase --autostash 를
# 먼저 한다. 작업 중이던 변경은 자동으로 넣었다 빼주므로 커밋하지 않아도 된다.

set -uo pipefail

# --- 저장소 위치 (심볼릭 링크로 설치돼도 원본을 찾는다) --------------------
resolve() {
  # Follow symlinks and always return an absolute path.  `bml install` writes
  # this value into a symlink, so a relative result would produce a link that
  # only works from the directory it was created in.
  local target="$1"
  while [ -L "$target" ]; do
    local link
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *)  target="$(cd -P "$(dirname "$target")" && pwd)/$link" ;;
    esac
  done
  printf '%s/%s' "$(cd -P "$(dirname "$target")" && pwd)" "$(basename "$target")"
}

SCRIPT="$(resolve "${BASH_SOURCE[0]}")"
REPO="$(cd -P "$(dirname "$SCRIPT")/.." && pwd)"

#: 이 저장소는 브랜치마다 다른 프로젝트를 담는다 (DFT 판은 다른 브랜치에 있다).
#: 어느 브랜치가 워크벤치인지 한 곳에만 적어 둔다.
WORKBENCH_BRANCH="${WORKBENCH_BRANCH:-claude/battery-charge-discharge-webapp-dq4ja3}"

#: classify_process 가 "다른 폴더의 워크벤치" 를 만나면 그 폴더를 여기 남긴다.
OTHER_CHECKOUT=""

#: 이 기계의 설정.  `.bml/` 은 git 에 올리지 않으므로 여기 적은 것은 이 기계에만
#: 남는다 — 중추 서버 한 대만 WORKBENCH_DATA 를 외장 드라이브로 두고 나머지
#: 기계는 아무것도 안 건드린다는 뜻이다 (ADR 0011).
#:
#:   WORKBENCH_DATA=/mnt/e/bml-data
#:   WORKBENCH_HOST=0.0.0.0
#:
#: 셸에 이미 있는 값이 이긴다.  `WORKBENCH_PORT=5010 bml` 로 한 번만 다르게
#: 띄우는 일이 파일을 고쳤다 되돌리는 일보다 훨씬 자주 필요하다.
load_env_file() {
  local file="$REPO/.bml/env" line key value
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"; value="${line#*=}"
    # 앞뒤 공백과 감싼 따옴표를 떼어 낸다.  손으로 적는 파일이라 `KEY = "값"`
    # 이 들어오는 것이 정상이고, 그때 따옴표째 경로가 되면 폴더를 못 찾는다.
    key="${key//[[:space:]]/}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$value" in \"*\") value="${value#\"}"; value="${value%\"}" ;; esac
    case "$value" in "'"*"'") value="${value#\'}"; value="${value%\'}" ;; esac
    # `~/...` 는 셸이 펼쳐 주지 않는다 — 텍스트로 읽었기 때문이다.
    case "$value" in "~/"*) value="$HOME/${value#\~/}" ;; esac
    case "$key" in WORKBENCH_*) ;; *) continue ;; esac
    [ -n "${!key:-}" ] || export "$key=$value"
  done < "$file"
}
load_env_file

PORT="${WORKBENCH_PORT:-5003}"
API_PORT="${WORKBENCH_API_PORT:-8000}"
# WSL2 forwards localhost from Windows by default, so 127.0.0.1 is right and
# keeps the server off the network.  Set WORKBENCH_HOST=0.0.0.0 if that
# forwarding is disabled, or to reach the app from another machine.
HOST="${WORKBENCH_HOST:-127.0.0.1}"
URL="http://localhost:${PORT}"
#: 데이터가 어디 있는지.  기본은 저장소 안의 data/, 중추 서버는 외장 드라이브.
DATA_DIR="${WORKBENCH_DATA:-$REPO/data}"
#: 사람이 적은 주소를 브라우저가 받는 형태로 편다.  실제로 적어 넣는 것은
#: `192.168.0.7` 이나 `192.168.0.7:5003` 이지 완전한 URL 이 아니다.
#: 주소를 셸에 넘겨도, **화면에 명령으로 찍어도** 안전한가.
#:
#: 화면이 `bml use $url` · `curl … $url/api/health` · `WORKBENCH_SERVER=$url bml`
#: 를 인용 없이 찍는다.  그래서 주소에 `;touch /tmp/PWN;#` 이 섞여 있으면,
#: **사람이 화면대로 붙여넣는 순간 그것이 실행된다** (Codex 2차 리뷰 1번).
#: `url_host` 의 제한은 진단용 호스트에만 걸려서 이 출력을 못 막았다.
#:
#: 그래서 들어올 때 막는다.  우리 주소는 `scheme://host[:port][/path]` 뿐이라
#: RFC 3986 의 안전한 글자만 있으면 된다 — 셸에서 뜻이 있는 글자는 하나도
#: 필요 없다.
url_is_safe() {
  case "${1:-}" in
    '') return 1 ;;
    *[!A-Za-z0-9._~:/%?=@-]*) return 1 ;;
  esac
  return 0
}

normalize_server_url() {
  local raw="${1:-}"
  [ -n "$raw" ] || return 0
  url_is_safe "$raw" || return 1
  raw="${raw%/}"
  # 규칙을 짧게 둔다: 사람이 주소만 적었으면 우리 포트를 붙이고, 스킴까지 적어
  # 넣었으면 그대로 믿는다.  `https://lab.example` 에 :5003 을 붙이면 프록시
  # 뒤에 둔 설정이 깨지고, 그쪽은 우리가 고쳐 줄 수 있는 형태가 아니다.
  case "$raw" in
    http://*|https://*) printf '%s' "$raw"; return 0 ;;
  esac
  case "$raw" in
    */*|*:*) ;;
    *) raw="$raw:$PORT" ;;
  esac
  printf 'http://%s' "$raw"
}

#: 이 기계가 볼 중추 서버.  비어 있으면 자기 서버를 띄운다 (지금까지의 동작).
#: 적혀 있으면 `bml` 은 아무것도 띄우지 않고 그 주소를 연다 — 노트북에서
#: 무심코 자기 서버를 띄우면 빈 data/ 를 보게 되고, 화면은 멀쩡해서 데이터가
#: 날아간 것처럼 보인다 (ADR 0011).
SERVER="$(normalize_server_url "${WORKBENCH_SERVER:-}")"
RUN_DIR="$REPO/.bml"
LOG="$RUN_DIR/server.log"
PID_FILE="$RUN_DIR/server.pid"
#: 떠 있는 서버가 어느 커밋의 코드를 들고 있는지.
HEAD_FILE="$RUN_DIR/server.head"
DEV_PID_FILE="$RUN_DIR/dev.pid"
#: 열려 있는 터널.  주소는 열 때마다 바뀌므로 어딘가 적어 두지 않으면 창을
#: 닫은 뒤에는 무엇이 열려 있는지 알 수 없다.
TUNNEL_PID_FILE="$RUN_DIR/tunnel.pid"
TUNNEL_URL_FILE="$RUN_DIR/tunnel.url"
#: 어느 터널을 쓸지.  auto 는 밖으로 나가는 포트를 보고 고른다 (ADR 0014).
#: cloudflare · ssh · auto.
TUNNEL="${WORKBENCH_TUNNEL:-auto}"
STAMP="$RUN_DIR/deps.stamp"

#: 실행 상태를 둘 폴더.  만드는 것은 실제로 쓸 때까지 미룬다 — 워크벤치가 아닌
#: 체크아웃에서 bml 이 잘못 불려도 남의 저장소에 흔적을 남기지 않기 위해서다.
need_run_dir() { mkdir -p "$RUN_DIR"; }

# --- 출력 -------------------------------------------------------------------
if [ -t 1 ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
  RED=$'\033[31m'; BLUE=$'\033[34m'; OFF=$'\033[0m'
else
  B=""; DIM=""; GREEN=""; YELLOW=""; RED=""; BLUE=""; OFF=""
fi

say()  { printf '%s\n' "$*"; }
step() { printf '%s▸%s %s\n' "$BLUE" "$OFF" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$OFF" "$*"; }
die()  { printf '%s✕%s %s\n' "$RED" "$OFF" "$*" >&2; exit 1; }

#: **파일에 들어갈 내용** 한 줄.  명령이 아니다.
#:
#: 이 화면에서 초록색은 "그대로 붙여넣으면 되는 것" 이라는 뜻으로 써 왔다.
#: `.wslconfig` 의 두 줄을 같은 초록으로 찍었더니 PowerShell 에 그대로
#: 붙여넣었고, 돌아온 것은 `'networkingMode=mirrored' 용어가 ... 인식되지
#: 않습니다` 였다 — 오류 문구 어디에도 '파일' 이라는 말이 없어서, 화면을 준
#: 우리 말고는 원인을 알 수 없다.  그래서 파일 내용은 색을 바꾸고 왼쪽에
#: 세로줄을 세운다.  색이 꺼진 자리(파이프·로그)에서도 세로줄은 남는다.
file_line() { printf '%s       │%s %s%s%s\n' "$DIM" "$OFF" "$BLUE" "$*" "$OFF"; }

# --- 파이썬 ------------------------------------------------------------------
python_bin() {
  if [ -x "$REPO/.venv/bin/python" ]; then
    printf '%s' "$REPO/.venv/bin/python"
  else
    command -v python3 || die "python3 을 찾을 수 없습니다."
  fi
}

# --- 프로세스 ----------------------------------------------------------------
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

running_pid() {
  local file="$1"
  [ -f "$file" ] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null)"
  alive "$pid" && printf '%s' "$pid"
}

port_owner() {
  # Which pid is listening.  Three tools, because none of them is guaranteed:
  # lsof is missing on minimal images, ss is missing on others, fuser lives in
  # psmisc.  An empty answer means "could not tell", not "nobody".
  local pid=""
  if command -v lsof >/dev/null 2>&1; then
    pid="$(lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null | head -1)"
  fi
  if [ -z "$pid" ] && command -v ss >/dev/null 2>&1; then
    pid="$(ss -lptnH "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
  fi
  if [ -z "$pid" ] && command -v fuser >/dev/null 2>&1; then
    pid="$(fuser -n tcp "$1" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | head -1)"
  fi
  printf '%s' "$pid"
}

#: 포트를 실제로 물고 있는 pid 를 파일에 기록한다.
#:
#: `port_owner "$p" > "$file"` 로 바로 리다이렉트하면 안 된다.  셸은 명령을
#: 실행하기 *전에* 파일을 잘라 내므로, 소유자를 알아낼 수 없는 머신
#: (lsof·ss·fuser 가 모두 없는 최소 이미지 — port_busy 의 /dev/tcp 폴백과
#: owns_port 의 recorded-pid 폴백이 바로 그 환경을 위해 있다) 에서는 시작할 때
#: 적어 둔 pid 까지 함께 사라진다.  그러면 bml stop 이 자기 서버를 남의 것으로
#: 오인하고 영영 내리지 못한다.  답을 못 얻으면 있던 값을 그대로 둔다.
record_port_owner() {
  local pid
  pid="$(port_owner "$1")"
  [ -n "$pid" ] && printf '%s' "$pid" > "$2"
  return 0
}

port_busy() {
  # A named owner is definitive, so ask the tools first.
  [ -n "$(port_owner "$1")" ] && return 0

  # Nothing could name it.  Fall back to asking the kernel by connecting,
  # which needs no package at all -- but only as a fallback: a listener whose
  # accept backlog is full refuses new connections, and this test would then
  # report a busy port as free.  The timeout keeps a filtered port from
  # hanging the launcher.
  timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null
}

#: 0 = healthy, 1 = answering but not healthy, 2 = nothing listening.
#: A broken server answers 500 on every request, which `curl -f` reports the
#: same way as an empty port -- and those need opposite responses.
server_state() {
  # curl already prints 000 on failure via -w, so a `|| echo 000` fallback
  # concatenates two codes and every comparison below misses.
  local code
  code="$(curl -s -o /dev/null -m 2 -w '%{http_code}' "$URL/api/health" 2>/dev/null)"
  code="$(printf '%s' "$code" | tr -dc '0-9' | tail -c 3)"
  case "${code:-000}" in
    200) return 0 ;;
    000|"") return 2 ;;
    *)   return 1 ;;
  esac
}

#: Is the process on this port one of ours?  If it is, replacing it is what
#: the user wants; making them run `bml stop` first is friction with no
#: benefit.  Anything else is left alone.
#: Given a listener's command line and working directory, decide whether it is
#: ours.  0 = ours, 1 = someone else's.
#:
#: Split out from owns_port so this judgment can be tested without a live
#: process -- four separate bugs have hidden here, every one of them a case
#: where a plausible-looking marker was either absent when needed or present
#: on a stranger.  tools/tests/test_bml_ownership.sh pins all four.
classify_process() {
  local cmd="$1" cwd="$2" argv0

  # Match the command line, not /proc/pid/exe: for a virtualenv the latter
  # resolves the symlink back to the system interpreter, so the venv path --
  # the one unambiguous marker -- disappears exactly when it is needed.
  #
  # Nothing but our own launcher runs our own venv's interpreter, so this is
  # the one test that is both safe and sufficient.
  case "$cmd" in *"$REPO/.venv/"*) return 0 ;; esac

  # ...but only `bml` spells that path absolutely.  `make serve` runs
  # `.venv/bin/python -m uvicorn`, and so does anyone debugging by hand, so
  # argv[0] arrives relative.  Resolve it against the process's own cwd before
  # concluding it is a stranger's.
  argv0="${cmd%% *}"
  case "$argv0" in
    /*) ;;
    # Join textually -- never `readlink -f`.  A venv's bin/python is a symlink
    # to the system interpreter, so resolving it deletes the very marker being
    # looked for, the same trap /proc/pid/exe sets.
    *) [ -n "$cwd" ] && argv0="$cwd/${argv0#./}" ;;
  esac
  case "$argv0" in "$REPO"/.venv/*) return 0 ;; esac

  # A uvicorn naming our tree is ours wherever it was started from.
  #
  # 경계 없는 부분일치는 안 된다.  "$REPO" 를 접두사로만 공유하는 이웃 폴더
  # ("$REPO-old", "$REPO-backup", worktree 이름 뒤에 접미사를 붙인 폴더)의
  # 경로가 명령줄에 있으면 전부 우리 것으로 판정돼, 아래 --app-dir 분기(3)가
  # 아예 실행되지 않는다 — 남의 data/ 를 가진 서버를 "이미 돌고 있습니다" 로
  # 열어 주거나, 아예 죽인다.  경로 구분자나 인자 경계를 요구한다.
  # 그런데 "$REPO/" 아래라는 것만으로도 부족하다.  다른 checkout 을
  # "$REPO/.worktrees/other" 처럼 우리 안에 두는 것은 흔한 배치이고, 그때
  # 그 서버의 --app-dir 도 "$REPO/" 로 시작한다.  아래 3 번 분기가 볼 기회를
  # 갖도록, 우리 트리의 apps/api 를 가리킬 때만 우리 것으로 본다.
  case "$cmd" in
    *uvicorn*"$REPO/apps/api"*|*uvicorn*"$REPO "*|*uvicorn*"$REPO") return 0 ;;
  esac

  # A workbench started from *another* checkout of this same project.  It is
  # not a stranger, but it is not ours either: its data/ is a different
  # directory, so silently replacing it would look like the uploads vanished.
  # Report it separately so the caller can name the folder and let the user
  # choose.
  case "$cmd" in
    *--app-dir*)
      local appdir root
      appdir="${cmd##*--app-dir }"
      appdir="${appdir%% *}"
      root="${appdir%/apps/api}"
      if [ "$root" != "$appdir" ]; then
        # 폴더에 워크벤치가 그대로 있으면 확실하다.
        if [ -d "$root/packages/wrdkit/src/wrdkit" ]; then
          OTHER_CHECKOUT="$root"
          return 3
        fi
        # 없어도 포기하지 않는다.  그 폴더가 다른 브랜치로 넘어간 뒤에도
        # 서버 프로세스는 계속 살아서 포트를 물고 있다 — 오히려 그때가 원인을
        # 찾기 가장 어려운 상황이다.  실행 파일이 그 폴더의 venv 인지까지
        # 맞으면 우리 실행기가 띄운 것으로 본다.
        #
        # 여기서 틀려도 프로세스를 죽이지는 않는다.  3 은 "이름을 알려주고
        # 사용자에게 묻는다" 이지 "갈아끼운다" 가 아니므로, 판단을 조금
        # 넉넉히 해도 잃을 것이 없다.
        case "$cmd" in
          "$root/.venv/"*|*" $root/.venv/"*)
            OTHER_CHECKOUT="$root"
            return 3
            ;;
        esac
      fi
      ;;
  esac

  # `uvicorn app.main:app` on its own is not evidence: that module path is the
  # FastAPI tutorial's, so half the world's side projects answer to it.  Claim
  # it only when the process is also sitting in our API directory.
  case "$cmd" in
    *uvicorn*app.main*)
      case "$cwd" in "$REPO"/apps/api|"$REPO"/apps/api/*) return 0 ;; esac
      ;;
  esac

  case "$cmd" in
    *vite*|*"npm run dev"*)
      case "$cwd" in "$REPO"/apps/web|"$REPO"/apps/web/*) return 0 ;; esac
      ;;
  esac
  return 1
}

#: pid 하나가 우리 프로세스인지.  0 = ours, 그 외 = 죽이면 안 된다.
#:
#: PID 파일은 재부팅이나 비정상 종료 뒤에도 그대로 남고, 커널은 pid 번호를
#: 재사용한다 (WSL 재시작 직후엔 낮은 번호 재사용이 흔하다).  kill -0 는
#: "살아 있다" 만 말해 주므로, 그것만 믿고 죽이면 같은 번호를 물려받은 남의
#: 프로세스를 — cmd_stop 은 그룹째 — 죽인다.  규칙 8: 우리 것임을 증명한
#: 뒤에만 죽인다.
owns_pid() {
  local pid="$1" cmd cwd
  [ -n "$pid" ] || return 1
  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  [ -n "$cmd" ] || cmd="$(ps -p "$pid" -o args= 2>/dev/null)"
  # 정체를 설명할 수 없는 프로세스는 죽이지 않는다 (owns_port 와 같은 원칙).
  [ -n "$cmd" ] || return 1
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"
  classify_process "$cmd" "$cwd"
}

#: 포트를 잡고 있는 프로세스를 사람이 읽을 수 있게 한 줄로.
#:
#: "다른 프로그램이 쓰고 있습니다" 만으로는 사용자가 다음에 뭘 해야 할지 알 수
#: 없다.  pid 와 명령줄을 보여 주면 대개 한눈에 정체가 드러난다.
describe_port_owner() {
  local pid cmd cwd
  pid="$(port_owner "$1")"
  [ -n "$pid" ] || return 1

  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  [ -n "$cmd" ] || cmd="$(ps -p "$pid" -o args= 2>/dev/null)"
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"

  say "  ${DIM}      pid ${pid}${OFF}"
  [ -n "$cmd" ] && say "  ${DIM}      $(printf '%.140s' "$cmd")${OFF}"
  [ -n "$cwd" ] && say "  ${DIM}      실행 위치: ${cwd}${OFF}"
}

#: 0 = ours, 1 = someone else's, 2 = cannot tell, 3 = another checkout of this
#: same project (folder left in OTHER_CHECKOUT).
#: The third answer matters: refusing to start because we *assumed* the port
#: belongs to a stranger is as wrong as killing a stranger's process.
owns_port() {
  local pid cmd cwd
  pid="$(port_owner "$1")"

  if [ -z "$pid" ]; then
    # No tool could name the owner.  Fall back to what we recorded when we
    # started it ourselves.
    # 살아 있다는 것만으로는 부족하다 — 그 번호를 물려받은 남의 프로세스일 수
    # 있으므로, 적어 둔 pid 도 명령줄로 확인한다.
    local recorded
    recorded="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$recorded" ] && alive "$recorded" && owns_pid "$recorded" && return 0
    return 2
  fi

  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  [ -n "$cmd" ] || cmd="$(ps -p "$pid" -o args= 2>/dev/null)"
  # A listener we cannot describe is not a listener we may kill.
  [ -n "$cmd" ] || return 2
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"

  classify_process "$cmd" "$cwd"
}

wait_for_url() {
  local url="$1" tries="${2:-40}"
  for _ in $(seq "$tries"); do
    if curl -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null; then return 0; fi
    sleep 0.5
  done
  return 1
}

#: Log lines that mean the server will never come up, so waiting is pointless.
_FATAL='Traceback|Error loading ASGI app|address already in use|ModuleNotFoundError|Address already in use'

wait_for_server() {
  # Wait for the server, but give up the moment the log says it is doomed.
  # `setsid` detaches the process, so $! is not the server's pid and cannot be
  # watched -- the log is the reliable signal.
  local url="$1" log="$2" tries="${3:-60}" spun=0
  for _ in $(seq "$tries"); do
    if curl -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null; then
      [ "$spun" -eq 1 ] && printf '\r%*s\r' 40 ''
      return 0
    fi
    if [ -f "$log" ] && grep -qE "$_FATAL" "$log" 2>/dev/null; then
      [ "$spun" -eq 1 ] && printf '\r%*s\r' 40 ''
      return 2
    fi
    # A silent wait reads as a hang; show that something is happening.
    if [ -t 1 ]; then
      printf '\r  %s기다리는 중…%s' "$DIM" "$OFF"
      spun=1
    fi
    sleep 0.5
  done
  [ "$spun" -eq 1 ] && printf '\r%*s\r' 40 ''
  return 1
}

#: Turn a log into one sentence and one command.  A 25-line traceback is not
#: an answer -- the reader has to know which line matters and what to do.
explain_log() {
  local log="$1"
  [ -s "$log" ] || return 1

  if grep -qE "module 'sniffio' has no attribute|module 'anyio' has no attribute" "$log"; then
    say "  ${B}원인${OFF}  가상환경의 async 패키지(sniffio/anyio)가 서로 안 맞습니다."
    say "  ${B}해결${OFF}  ${GREEN}bml repair${OFF}"
    return 0
  fi
  if grep -qE "ModuleNotFoundError|ImportError" "$log"; then
    local missing
    missing="$(grep -oE "No module named '[^']+'" "$log" | tail -1)"
    say "  ${B}원인${OFF}  패키지가 빠졌습니다${missing:+ (${missing})}."
    say "  ${B}해결${OFF}  ${GREEN}bml repair${OFF}"
    return 0
  fi
  if grep -qiE "address already in use" "$log"; then
    say "  ${B}원인${OFF}  포트 ${PORT} 를 이미 다른 프로세스가 쓰고 있습니다."
    # mirrored 네트워크를 켠 뒤로 이 자리가 달라졌다: WSL 이 Windows 의 망을
    # 그대로 쓰므로 **Windows 쪽이 잡은 포트도 여기서 보인다.**  그것을
    # `bml stop` 으로 끄라고 하면 영영 안 된다 — WSL 안에서는 끌 수 없다.
    # 가장 흔한 범인은 예전에 걸어 둔 portproxy 다 (mirrored 에서는 필요 없다).
    if is_wsl && ! owns_port "$PORT"; then
      say "  ${DIM}      우리 프로세스가 아닙니다. mirrored 네트워크에서는 Windows 쪽이 잡은 포트도${OFF}"
      say "  ${DIM}      이렇게 보이고, WSL 안에서는 끌 수 없습니다 —${OFF} ${GREEN}bml stop${OFF} ${DIM}은 소용없습니다.${OFF}"
      say "  ${B}해결${OFF}  ${DIM}먼저 예전에 걸어 둔 포워딩을 지웁니다 (mirrored 에서는 필요 없습니다).${OFF}"
      say "        ${DIM}관리자 PowerShell:${OFF} ${GREEN}netsh interface portproxy reset${OFF}"
      say "        ${DIM}그래도 남으면 무엇이 잡고 있는지 여기서 볼 수 있습니다:${OFF}"
      say "        ${GREEN}netstat.exe -ano | grep :${PORT}${OFF}   ${DIM}맨 오른쪽이 PID 입니다${OFF}"
      say "        ${GREEN}tasklist.exe /FI \"PID eq <그 PID>\"${OFF}"
      say "        ${DIM}이 기계만 다른 포트로 쓰려면${OFF} ${GREEN}WORKBENCH_PORT=6001 bml${OFF}"
    else
      say "  ${B}해결${OFF}  ${GREEN}bml stop${OFF} 후 다시, 또는 ${GREEN}WORKBENCH_PORT=6001 bml${OFF}"
    fi
    return 0
  fi
  if grep -q "Error loading ASGI app" "$log"; then
    say "  ${B}원인${OFF}  앱을 찾지 못했습니다 — 저장소가 온전하지 않을 수 있습니다."
    say "  ${B}해결${OFF}  ${GREEN}bml doctor${OFF}"
    return 0
  fi
  if grep -qE "sqlite3.OperationalError|no such column" "$log"; then
    say "  ${B}원인${OFF}  DB 스키마가 코드보다 오래됐습니다."
    say "  ${B}해결${OFF}  ${GREEN}mv data/workbench.db data/workbench.db.bak && bml${OFF}"
    say "  ${DIM}      (업로드한 .wrd 원본은 data/uploads/ 에 그대로 있습니다)${OFF}"
    return 0
  fi
  return 1
}

#: `bml restart` 는 터널을 살려 둔 채 서버를 내린다.  그것은 **"곧 돌아온다"
#: 는 약속**이고, 약속을 못 지키고 나가면 그 주소는 남에게 오류 화면만 띄운다.
#:
#: 나가는 길이 하나가 아니라서 함수마다 정리를 붙일 수 없다 -- `guard_data_dir`
#: 은 그 자리에서 exit 하고, 빌드 실패는 `die` 로 나가고, Ctrl-C 는 아무 데서나
#: 온다.  예전에는 `report_failure` 를 지나는 길에만 정리가 있어서, 데이터
#: 폴더가 빠진 채 restart 하면 서버 없는 터널이 그대로 남았다.  약속을 건 뒤의
#: **모든** 퇴장에 걸리도록 trap 으로 잡는다.
TUNNEL_PROMISE=0

keep_tunnel_promise() {
  TUNNEL_PROMISE=1
  trap 'break_tunnel_promise' EXIT INT TERM
}

#: 약속을 지켰다 (서버가 다시 떴다).
promise_kept() {
  TUNNEL_PROMISE=0
  trap - EXIT INT TERM
}

break_tunnel_promise() {
  [ "$TUNNEL_PROMISE" = "1" ] || return 0
  TUNNEL_PROMISE=0
  # report_failure 가 이미 닫았으면 여기서 할 일이 없다 -- 두 번 불려도 안전.
  if tunnel_running && close_tunnel; then
    warn "터널도 닫았습니다 — 뒤에 서버가 없는 주소를 남기지 않습니다."
  fi
}

report_failure() {
  local log="$1" reason="$2"
  warn "$reason"

  # 서버가 안 떴는데 터널이 열려 있으면 그 주소는 남에게 오류 화면만 띄운다.
  # `bml restart` 가 터널을 살려 두고 다시 띄우다 실패한 경우가 이것이다 --
  # 살려 두는 것은 "곧 돌아온다" 는 약속이고, 여기서 그 약속이 깨졌다.
  if tunnel_running && close_tunnel; then
    warn "터널도 닫았습니다 — 뒤에 서버가 없는 주소를 남기지 않습니다."
  fi
  say ""

  if explain_log "$log"; then
    say ""
    say "${DIM}자세한 로그: bml logs${OFF}"
    return 0
  fi

  if [ -s "$log" ]; then
    say "${DIM}--- 로그 마지막 25줄 ---${OFF}"
    tail -25 "$log" | sed 's/^/  /'
    say "${DIM}------------------------${OFF}"
  else
    say "${DIM}로그가 비어 있습니다: $log${OFF}"
  fi
  say ""
  say "다음을 확인해 보세요:"
  say "  bml doctor      환경 점검"
  say "  bml repair      파이썬 환경 재설치"
  say "  bml stop        남은 프로세스 정리 후 다시 bml"
}

cmd_repair() {
  step "파이썬 환경을 새로 만듭니다"
  say "  ${DIM}업로드한 데이터(data/)는 건드리지 않습니다.${OFF}"

  rm -rf "$REPO/.venv" "$STAMP"
  # --clear so a half-built venv left by an interrupted run cannot survive.
  python3 -m venv --clear "$REPO/.venv" \
    || die "venv 생성 실패 — sudo apt install -y python3-venv"
  local py="$REPO/.venv/bin/python"

  say "  ${DIM}pip 갱신…${OFF}"
  "$py" -m pip install --quiet --upgrade pip setuptools wheel || die "pip 갱신 실패"
  say "  ${DIM}wrdkit…${OFF}"
  "$py" -m pip install --quiet -e "$REPO/packages/wrdkit[dev]" || die "wrdkit 설치 실패"
  say "  ${DIM}API 의존성…${OFF}"
  "$py" -m pip install --quiet -r "$REPO/apps/api/requirements-dev.txt" \
    || die "API 의존성 설치 실패"

  if ! python_ready; then
    # A poisoned wheel cache survives a fresh venv, because pip reuses it.
    # Reinstalling the async stack from the network is the one thing left to
    # try before handing the problem back.
    warn "런타임 점검 실패 — async 스택을 캐시 없이 다시 받습니다."
    "$py" -m pip install --quiet --upgrade --force-reinstall --no-cache-dir \
      anyio sniffio || true
  fi

  if python_ready; then
    printf '%s' "$(deps_fingerprint)" > "$STAMP"
    ok "파이썬 환경 정상."
    say "  ${DIM}이제 'bml' 로 실행하세요.${OFF}"
  else
    warn "재설치했는데도 런타임 점검을 통과하지 못했습니다:"
    python_problem | tail -12 | sed 's/^/  /'
    say ""
    say "  ${DIM}설치된 버전:${OFF}"
    "$py" -m pip list 2>/dev/null | grep -iE '^(anyio|sniffio|fastapi|starlette|uvicorn) ' \
      | sed 's/^/    /'
    say ""
    say "  ${DIM}시스템 패키지가 섞였을 수 있습니다. 확인:${OFF}"
    say "    grep include-system-site-packages $REPO/.venv/pyvenv.cfg"
    say "    ${DIM}(false 여야 합니다)${OFF}"
    return 1
  fi
}

cmd_repair_web() {
  step "node_modules 를 새로 만듭니다"
  rm -rf "$REPO/apps/web/node_modules" "$REPO/apps/web/dist" "$STAMP"
  ( cd "$REPO/apps/web" && npm install --no-audit --no-fund ) || die "npm install 실패"
  ok "web 환경 정상."
}

is_wsl() {
  [ -n "${WSL_DISTRO_NAME:-}" ] && return 0
  grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease 2>/dev/null
}

open_browser() {
  local url="$1"
  [ -n "${BML_NO_OPEN:-}" ] && return 0

  if is_wsl; then
    # xdg-open inside WSL either does nothing or opens a Linux browser that
    # is not installed.  The Windows browser is what the user is looking at.
    if command -v wslview >/dev/null 2>&1; then
      (wslview "$url" >/dev/null 2>&1 &)
    elif command -v explorer.exe >/dev/null 2>&1; then
      # explorer.exe returns 1 even on success; ignore its status.
      (explorer.exe "$url" >/dev/null 2>&1 || true &)
    elif command -v powershell.exe >/dev/null 2>&1; then
      (powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1 &)
    fi
    return 0
  fi

  if command -v xdg-open >/dev/null 2>&1; then (xdg-open "$url" >/dev/null 2>&1 &)
  elif command -v open >/dev/null 2>&1; then (open "$url" >/dev/null 2>&1 &)
  fi
}

# --- 최신화 ------------------------------------------------------------------
#: 워크벤치임을 알아보는 표식 파일 중 없는 것들 (전부 있으면 빈 문자열).
workbench_missing() {
  local required out=""
  for required in Makefile packages/wrdkit/src/wrdkit apps/api/app apps/web/src; do
    [ -e "$REPO/$required" ] || out="$out $required"
  done
  printf '%s' "${out# }"
}

#: 이 폴더가 워크벤치가 아니면, 무엇이 들어 있는지 말하고 멈춘다.
#:
#: 이 저장소는 브랜치마다 전혀 다른 프로젝트를 담고 있다.  한 폴더에서 브랜치를
#: 바꾸면 상대 프로젝트의 파일이 통째로 사라지고, 그쪽 실행기는 원인 대신
#: "No such file" 만 뱉는다.  pull 전에 잡아야 한다 — 남의 브랜치를 rebase 하고
#: 나서 알아차리면 이미 늦다.
guard_workbench_checkout() {
  local missing branch
  missing="$(workbench_missing)"
  [ -z "$missing" ] && return 0

  branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"

  if [ -z "$(git -C "$REPO" ls-tree -r --name-only HEAD 2>/dev/null | head -1)" ]; then
    say "${RED}✕${OFF} 이 브랜치(${branch})는 비어 있습니다."
    say "  ${DIM}작업 브랜치로 옮기세요:${OFF}"
    say "    git -C \"$REPO\" fetch origin"
    say "    git -C \"$REPO\" checkout $WORKBENCH_BRANCH"
    exit 1
  fi

  say "${RED}✕${OFF} 이 폴더에는 다른 프로젝트가 체크아웃돼 있습니다 (브랜치 ${branch})."
  say "  ${DIM}없는 워크벤치 파일: ${missing}${OFF}"
  say ""
  say "  ${DIM}한 폴더를 두 프로젝트가 나눠 쓰면, 브랜치를 바꿀 때마다 상대 파일이${OFF}"
  say "  ${DIM}사라집니다. worktree 로 각자 폴더를 주세요 (저장소는 한 번만 받습니다):${OFF}"
  say "    git -C \"$REPO\" worktree add ~/bml $WORKBENCH_BRANCH"
  say "    cd ~/bml && ./tools/bml install && bml"
  exit 1
}

#: `.githooks` 를 이 클론에 물린다.
#:
#: `make setup-git` 이 하는 일이지만, 클론 직후 한 번 실행하라는 절차는 두 사람
#: 중 한쪽에서 반드시 빠진다 — 그러면 그 사람의 커밋만 기록 없이 쌓이고,
#: 아무도 눈치채지 못한다.  훅은 저장소 안의 파일이고 설정은 이 클론에만
#: 남으므로, 조용히 물려도 되돌리기 쉽다 (`git config --unset core.hooksPath`).
#: 이미 다른 값이 잡혀 있으면 건드리지 않는다 — 남의 설정을 덮지 않는다.
ensure_hooks_path() {
  [ -d "$REPO/.githooks" ] || return 0
  local current
  current="$(git -C "$REPO" config --local core.hooksPath 2>/dev/null)"
  [ -n "$current" ] && return 0
  git -C "$REPO" config core.hooksPath .githooks 2>/dev/null || true
}

#: 설치된 별칭 중 빠진 것을 채운다.
#:
#: `bml install` 은 그 시점에 있던 이름만 만든다.  나중에 이름이 하나 늘면
#: (`bmlonly` 가 그랬다) 이미 설치한 기계에는 **영영 안 생긴다** -- 화면은
#: 그 명령을 쓰라고 안내하는데 셸은 `command not found` 를 낸다.  안내와 실물이
#: 어긋나는 그 자리가 사람을 가장 오래 붙잡는다.
#:
#: 조용히 채운다.  같은 파일을 부르는 실행기 하나 더 쓰는 일이라 위험이 없고,
#: 못 써도 그냥 넘어간다 -- `pull` 이 권한 문제로 멈출 이유는 없다.
heal_launchers() {
  local self dir name
  self="$(command -v bml 2>/dev/null)" || return 0
  [ -n "$self" ] || return 0
  dir="$(dirname "$self")"
  # `bml install` 이 만든 실행기인지 확인한다.  PATH 어딘가의 남의 `bml` 옆에
  # 우리 이름을 뿌리지 않는다.
  grep -q '`bml install` 이 만든 실행기' "$self" 2>/dev/null || return 0
  for name in bmlin bmlout bmlonly; do
    [ -e "$dir/$name" ] && continue
    write_launcher "$dir/$name" "$name" 2>/dev/null \
      && ok "새 명령을 설치했습니다: ${B}$name${OFF} ${DIM}($dir)${OFF}"
  done
}

sync_repo() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다: $REPO"
  guard_workbench_checkout
  ensure_hooks_path

  local branch
  branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD)"
  # 갱신을 받기 **전에** 한 번 본다.  이 실행이 이미 새 코드라면 (자기 갱신
  # 뒤의 재실행) 여기서 빠진 이름이 채워진다.
  heal_launchers
  step "최신으로 맞추는 중 (${branch})"

  if ! git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
    warn "origin 이 없어 pull 을 건너뜁니다."
    return 0
  fi

  # pull 이 이 스크립트 자신을 갈아치울 수 있으므로, 전후를 비교할 수 있게
  # 먼저 지문을 떠 둔다.
  local script_before
  script_before="$(cksum < "$SCRIPT" 2>/dev/null)"

  # --autostash 덕분에 작업 중 변경이 있어도 안전하다.
  if git -C "$REPO" pull --rebase --autostash 2>&1 | sed 's/^/  /'; then
    :
  else
    warn "pull 실패 — 네트워크나 충돌을 확인하세요. 로컬 상태로 계속합니다."
    if [ -d "$REPO/.git/rebase-merge" ] || [ -d "$REPO/.git/rebase-apply" ]; then
      die "rebase 가 진행 중입니다. 충돌을 해결하고 'git rebase --continue' 하세요."
    fi
  fi

  local behind
  behind="$(git -C "$REPO" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo 0)"
  [ "$behind" != "0" ] && warn "업스트림보다 ${behind} 커밋 뒤에 있습니다."

  local recent
  recent="$(git -C "$REPO" log --oneline -3 --format='  %C(dim)%h%C(reset) %s' --color=always 2>/dev/null)"
  [ -n "$recent" ] && { say "${DIM}최근 커밋${OFF}"; say "$recent"; }

  # rebase·autostash 가 충돌을 남겼는지 먼저 본다 (Codex 리뷰 6번).
  #
  # `git pull --rebase --autostash` 는 **autostash 를 되돌리다 충돌해도 0 을
  # 돌려주는 경우가 있다.**  그러면 작업 트리에 `<<<<<<<` 가 든 tools/bml 이
  # 남고, 아래 재실행이 그것을 실행한다 — 셸 구문 오류로 죽고, 사람은 방금
  # 친 명령을 의심한다.  변경은 stash 에 살아 있는데 그 사실도 안 보인다.
  local unmerged
  unmerged="$(git -C "$REPO" diff --name-only --diff-filter=U 2>/dev/null)"
  if [ -n "$unmerged" ]; then
    warn "충돌이 남았습니다 — 여기서 멈춥니다 (이 상태로 실행하면 엉뚱한 오류가 납니다)."
    printf '%s\n' "$unmerged" | while IFS= read -r ff; do say "    ${DIM}$ff${OFF}"; done
    say "  ${DIM}작업 중이던 변경은${OFF} ${GREEN}git stash list${OFF} ${DIM}에 남아 있을 수 있습니다.${OFF}"
    say "  ${DIM}충돌을 풀고${OFF} ${GREEN}git add <파일>${OFF} ${DIM}후${OFF} ${GREEN}git rebase --continue${OFF}${DIM},${OFF}"
    say "  ${DIM}되돌리려면${OFF} ${GREEN}git rebase --abort${OFF} ${DIM}— 그다음 다시 실행하세요.${OFF}"
    exit 1
  fi

  # 방금 받은 것 중에 이 스크립트가 있었다면, 지금 돌고 있는 것은 옛 버전이다.
  # 새 것으로 다시 시작한다 — 안 그러면 "고쳤다는 걸 받았는데 왜 증상이
  # 똑같냐" 가 된다.  BML_REEXECED 가 무한 재실행을 막는다.
  if [ "$script_before" != "$(cksum < "$SCRIPT" 2>/dev/null)" ] \
     && [ -z "${BML_REEXECED:-}" ]; then
    ok "bml 이 갱신됐습니다 — 새 버전으로 다시 시작합니다."
    export BML_REEXECED=1
    exec "$SCRIPT" ${BML_ARGV+"${BML_ARGV[@]}"}
  fi
}

# --- 의존성 ------------------------------------------------------------------
deps_fingerprint() {
  cat "$REPO/apps/api/requirements.txt" \
      "$REPO/apps/api/requirements-dev.txt" \
      "$REPO/packages/wrdkit/pyproject.toml" \
      "$REPO/apps/web/package-lock.json" 2>/dev/null | cksum | awk '{print $1}'
}

python_ready() {
  # Importing is not enough.  A stale sniffio imports fine and then breaks on
  # the first request, so the check runs the async path the server actually
  # uses: anyio -> sniffio.current_async_library().
  "$(python_bin)" - <<'PY' >/dev/null 2>&1
import asyncio

import fastapi, numpy, sqlmodel, uvicorn, wrdkit  # noqa: F401
from anyio.to_thread import run_sync

asyncio.run(run_sync(lambda: None))
PY
}

python_problem() {
  # The same check, but let the error through so it can be reported.
  "$(python_bin)" - 2>&1 <<'PY'
import asyncio

import fastapi, numpy, sqlmodel, uvicorn, wrdkit  # noqa: F401
from anyio.to_thread import run_sync

asyncio.run(run_sync(lambda: None))
PY
}

ensure_deps() {
  local current previous need_py=0 need_web=0
  current="$(deps_fingerprint)"
  previous="$(cat "$STAMP" 2>/dev/null || echo none)"

  [ -d "$REPO/apps/web/node_modules" ] || need_web=1
  python_ready || need_py=1

  if [ "$previous" = "none" ]; then
    # First run on this machine.  A missing stamp means "never checked", not
    # "dependencies changed" -- if everything already imports, record what is
    # installed and move on rather than reinstalling for several minutes.
    if [ $need_py -eq 0 ] && [ $need_web -eq 0 ]; then
      printf '%s' "$current" > "$STAMP"
      return 0
    fi
  elif [ "$current" != "$previous" ]; then
    need_py=1
    need_web=1
  fi

  [ $need_py -eq 0 ] && [ $need_web -eq 0 ] && return 0

  if [ "$previous" = "none" ]; then
    step "의존성 설치 — 처음이라 1~3분 걸립니다"
  else
    step "의존성이 바뀌어 다시 설치합니다"
  fi

  if [ $need_py -eq 1 ]; then
    local py
    py="$(python_bin)"
    # 만들다 만 venv 는 **다음 실행을 계속 망가뜨린다.**  `python3 -m venv` 가
    # 도중에 죽어도 `.venv/bin/python` 은 남는데, 아래 검사는 그 파일만 보고
    # "환경이 있다" 로 넘어가 pip 을 부른다 -- 그러면 매번 `No module named
    # pip` 로 끝나고, 화면은 venv 가 아니라 wrdkit 을 탓한다.  실제로 그렇게
    # 두 번 죽었다.  껍데기만 남았으면 통째로 다시 만든다 (`bml repair` 가
    # 같은 이유로 `--clear` 를 쓴다).
    if [ -x "$REPO/.venv/bin/python" ] && [ -z "${VIRTUAL_ENV:-}" ] \
       && ! "$REPO/.venv/bin/python" -m pip --version >/dev/null 2>&1; then
      warn "가상환경이 만들다 말았습니다 (pip 이 없습니다) — 새로 만듭니다."
      rm -rf "$REPO/.venv"
    fi
    if [ ! -x "$REPO/.venv/bin/python" ] && [ -z "${VIRTUAL_ENV:-}" ]; then
      say "  ${DIM}가상환경 생성 (.venv)${OFF}"
      # 여기서 그냥 죽으면 화면에 파이썬의 영어 안내만 남는다.  그것은 "이
      # 패키지를 까세요" 까지만 말하고, **이 기계에 그게 정말 필요한지**는
      # 말해 주지 않는다 -- 남의 서버만 볼 기계라면 필요 없다 (ADR 0011).
      if ! python3 -m venv --clear "$REPO/.venv"; then
        printf '%s✕%s venv 생성 실패\n' "$RED" "$OFF" >&2
        say ""
        say "  ${B}이 기계에서 서버를 띄울 거라면${OFF} ${DIM}— 파이썬의 venv 패키지가 없습니다:${OFF}"
        say "    ${GREEN}sudo apt install -y python3-venv${OFF}   ${DIM}(안 되면 위 안내가 짚어 준 python3.XX-venv)${OFF}"
        say ""
        say "  ${B}남의 서버(중추 서버)만 볼 거라면${OFF} ${DIM}— 필요 없습니다. 주소만 정하면 됩니다:${OFF}"
        say "    ${GREEN}bmlin  <랩 안 주소>${OFF}    ${DIM}같은 공유기 안일 때${OFF}"
        say "    ${GREEN}bmlout <터널 주소>${OFF}    ${DIM}다른 공유기일 때 (중추 서버에서 bml share)${OFF}"
        say "    ${DIM}그러면 이 기계는 브라우저 노릇만 하므로 파이썬이 아예 필요 없습니다.${OFF}"
        exit 1
      fi
      py="$REPO/.venv/bin/python"
    fi
    say "  ${DIM}python 패키지 설치…${OFF}"
    "$py" -m pip install --quiet --upgrade pip >/dev/null 2>&1
    "$py" -m pip install --quiet -e "$REPO/packages/wrdkit[dev]" \
      || die "wrdkit 설치 실패 — 'pip install -e packages/wrdkit' 로 원인을 보세요."
    "$py" -m pip install --quiet -r "$REPO/apps/api/requirements-dev.txt" \
      || die "API 의존성 설치 실패"
    ok "python 준비 완료"
  fi

  if [ $need_web -eq 1 ]; then
    say "  ${DIM}npm 패키지 설치…${OFF}"
    ( cd "$REPO/apps/web" && npm install --silent --no-audit --no-fund ) \
      || die "npm install 실패"
    ok "web 준비 완료"
  fi

  printf '%s' "$current" > "$STAMP"
}

# --- 빌드 --------------------------------------------------------------------
web_needs_build() {
  local dist="$REPO/apps/web/dist/index.html"
  [ -f "$dist" ] || return 0
  # 소스가 빌드보다 새로우면 다시 빌드한다.
  #
  # package.json/package-lock.json 도 소스다.  상대가 프론트 의존성만 올린
  # 커밋(라이브러리 버그 픽스)을 받으면 src 는 그대로라, 이 목록에서 빠지면
  # ensure_deps 가 npm install 은 해도 dist 는 옛 라이브러리가 구워진 채로
  # 서빙된다 — "고친 걸 받았는데 증상이 똑같다" 가 프론트엔드에서 재현된다.
  # tsconfig.json 은 빌드 산출물을 바꾸므로 같이 본다.
  [ -n "$(find "$REPO/apps/web/src" "$REPO/apps/web/index.html" \
           "$REPO/apps/web/vite.config.ts" "$REPO/apps/web/tsconfig.json" \
           "$REPO/apps/web/package.json" "$REPO/apps/web/package-lock.json" \
           -newer "$dist" -print -quit 2>/dev/null)" ]
}

build_web() {
  if web_needs_build; then
    step "프론트엔드 빌드"
    ( cd "$REPO/apps/web" && npm run build >/dev/null 2>&1 ) || die "빌드 실패 — 'bml check' 로 원인을 보세요."
    ok "빌드 완료"
  else
    ok "빌드 최신"
  fi
}

# --- 실행 --------------------------------------------------------------------
#: `cmd_stop [--keep-tunnel]`
#:
#: `--keep-tunnel` 은 `bml restart` 만 쓴다.  터널은 localhost:5003 을 가리키고,
#: 그 뒤의 서버가 몇 초 내려갔다 올라오는 것은 터널이 견디도록 만들어진 일이다.
#: 그런데 restart 가 터널을 닫으면 **주소가 바뀐다** (실측: 열 때마다 다른
#: 이름 — 70a2261f8bc0e8 → 683dafde44f8ea → 41c016078f751e).  그러면 코드를
#: 고칠 때마다 다른 기계마다 `bmlout <새 주소>` 를 다시 쳐야 하고, 그 사이
#: 노트북은 HTTP 503 을 본다.
cmd_stop() {
  local stopped=0 keep_tunnel=""
  case "${1:-}" in --keep-tunnel) keep_tunnel=1 ;; esac
  # 서버가 없어지면 "어느 커밋을 서비스 중" 이라는 표식도 사실이 아니다.
  rm -f "$HEAD_FILE"
  # 서버 없이 남은 터널은 남에게 Cloudflare 오류 화면을 띄우는 주소일 뿐이다 --
  # 다시 띄울 것이 아니라면.
  if [ -z "$keep_tunnel" ] && close_tunnel; then
    ok "터널도 닫았습니다."
    stopped=1
  fi
  for file in "$PID_FILE" "$DEV_PID_FILE"; do
    local pid
    # 파일에 적혀 있고 살아 있다는 것만으로는 죽일 근거가 못 된다.  낡은 PID
    # 파일이 가리키는 번호를 그 사이 남의 프로세스가 물려받았을 수 있고, 아래는
    # 그룹째 죽인다.  포트 쪽(owns_port)과 같은 기준으로 신원을 확인한다.
    if pid="$(running_pid "$file")" && owns_pid "$pid"; then
      kill "$pid" 2>/dev/null
      # 프로세스 그룹째 내린다 (uvicorn reload, vite 는 자식을 만든다).
      kill -- "-$pid" 2>/dev/null
      stopped=1
    fi
    rm -f "$file"
  done

  # Only ever kill our own processes.  `bml stop` on a machine where something
  # else happens to hold 5003 must not take that down.
  for port in "$PORT" "$API_PORT"; do
    local owner
    owner="$(port_owner "$port")"
    if [ -n "$owner" ] && owns_port "$port"; then
      kill "$owner" 2>/dev/null && stopped=1
    fi
  done
  unset owner

  # SIGTERM 은 uvicorn 에게 "하던 요청 끝내고 내려가" 다.  이벤트 스트림은
  # 스스로 끝나는 응답이 아니라서, 브라우저 탭이 하나라도 열려 있으면 그
  # "끝내기" 를 기다리며 포트를 붙잡고 있다.  uvicorn 쪽에 3초 상한을 걸어
  # 뒀고, 여기서는 그 뒤에도 남아 있으면 확실히 내린다 — 우리 것임은 위에서
  # 이미 확인했다.
  local waited=0
  while [ "$waited" -lt 45 ]; do
    port_busy "$PORT" || port_busy "$API_PORT" || break
    sleep 0.1
    waited=$((waited + 1))
  done
  for port in "$PORT" "$API_PORT"; do
    if port_busy "$port" && owns_port "$port"; then
      local stubborn
      stubborn="$(port_owner "$port")"
      [ -n "$stubborn" ] && kill -9 "$stubborn" 2>/dev/null
    fi
  done

  sleep 0.4

  # Claiming success without checking is how "내렸습니다" gets followed by
  # "포트가 사용 중" one command later.
  local still="" foreign=""
  for port in "$PORT" "$API_PORT"; do
    if port_busy "$port"; then
      owns_port "$port"
      case $? in
        0) still="$still $port" ;;
        *) foreign="$foreign $port" ;;
      esac
    fi
  done

  if [ -n "$foreign" ]; then
    say "${DIM}포트$foreign 는 bml 이 아닌 다른 프로그램의 것이라 두었습니다.${OFF}"
  fi

  if [ -n "$still" ]; then
    warn "포트가 아직 잡혀 있습니다:$still"
    if is_wsl; then
      say "  ${DIM}WSL 미러 네트워크에서는 Windows 쪽 프로그램의 포트도 이렇게 보이며,${OFF}"
      say "  ${DIM}WSL 안에서는 종료할 수 없습니다. Windows 에서 확인하세요:${OFF}"
      say "    ${DIM}PowerShell:  Get-NetTCPConnection -LocalPort $PORT | Select OwningProcess${OFF}"
      say "  ${DIM}또는 다른 포트를 쓰세요:  WORKBENCH_PORT=6001 bml${OFF}"
    else
      say "  ${DIM}다른 프로그램이 쓰고 있습니다. WORKBENCH_PORT=6001 bml 로 옮길 수 있습니다.${OFF}"
    fi
    return 1
  fi

  if [ $stopped -eq 1 ]; then ok "내렸습니다."; else say "${DIM}돌고 있는 게 없습니다.${OFF}"; fi
}

start_serve() {
  if port_busy "$PORT"; then
    # 소유부터 가린다.  "정상 응답하니 이미 돌고 있다" 로 먼저 판단하면, 다른
    # 폴더의 워크벤치를 우리 것인 양 브라우저로 열어 준다 — 그쪽은 data/ 가
    # 다르므로 사용자 눈에는 올려 둔 .wrd 가 통째로 사라진 것으로 보인다.
    #
    # 갈아끼우는 것도 우리 것임을 확인한 뒤에만 한다.  500 을 뱉는 포트가
    # 남의 망가진 서비스일 수도 있고, 그걸 죽이는 쪽이 안 뜨는 것보다 훨씬
    # 나쁜 결과다.
    owns_port "$PORT"
    local owner=$?

    if [ $owner -eq 3 ]; then
      # 같은 프로젝트지만 다른 폴더의 워크벤치다.  자동으로 갈아끼우지 않는다 —
      # 두 폴더는 data/ 가 서로 달라서, 조용히 바꾸면 올려 둔 파일이 사라진
      # 것처럼 보인다.  어디에 있는지 말해 주고 사용자가 고르게 한다.
      say ""
      say "  ${B}원인${OFF}  포트 ${PORT} 를 ${B}다른 폴더의 워크벤치${OFF}가 쓰고 있습니다."
      say "  ${DIM}      ${OTHER_CHECKOUT}${OFF}"
      describe_port_owner "$PORT"
      say ""
      say "  ${DIM}두 폴더는 data/ 가 서로 다릅니다 — 올린 .wrd 도 따로입니다.${OFF}"
      say "  ${B}선택${OFF}  그쪽을 계속 쓴다   ${GREEN}cd ${OTHER_CHECKOUT} && bml${OFF}"
      # 그 폴더가 지금은 다른 브랜치라 tools/bml 이 없을 수 있다 -- 브랜치를
      # 바꾸면 상대 프로젝트 파일이 통째로 사라지기 때문이다.  그때 "거기서
      # stop 하세요" 는 통하지 않는 명령이다.  그 서버가 우리 것임은 이미
      # 확인했으므로(owns_port), 내리는 방법을 대신 알려 준다.
      if [ -r "$OTHER_CHECKOUT/tools/bml" ]; then
        say "        이쪽으로 옮긴다   ${GREEN}${OTHER_CHECKOUT}/tools/bml stop${OFF} 후 ${GREEN}bml${OFF}"
      else
        say "        ${DIM}그 폴더는 지금 다른 브랜치라 거기서 stop 할 수 없습니다.${OFF}"
        say "        이쪽으로 옮긴다   ${GREEN}kill $(port_owner "$PORT")${OFF} 후 ${GREEN}bml${OFF}"
      fi
      say "        둘 다 띄운다      ${GREEN}WORKBENCH_PORT=5004 bml${OFF}"
      exit 1
    fi

    if [ $owner -eq 1 ]; then
      say ""
      say "  ${B}원인${OFF}  포트 ${PORT} 를 bml 이 아닌 다른 프로그램이 쓰고 있습니다."
      describe_port_owner "$PORT"
      if is_wsl; then
        say "  ${DIM}      WSL 미러 네트워크에서는 Windows 쪽 프로그램도 이렇게 보입니다.${OFF}"
        say "  ${DIM}      PowerShell:  Get-NetTCPConnection -LocalPort ${PORT} | Select OwningProcess${OFF}"
      fi
      say "  ${B}해결${OFF}  ${GREEN}WORKBENCH_PORT=6001 bml${OFF}"
      exit 1
    fi

    server_state
    local state=$?

    if [ $state -eq 0 ]; then
      # 우리 것이거나(0), 누구 것인지 모르지만 우리 API 로 정상 응답한다(2).
      # 다만 "돌고 있다" 와 "지금 코드를 돌고 있다" 는 다르다.
      local serving current stale=""
      serving="$(cat "$HEAD_FILE" 2>/dev/null)"
      current="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"

      if [ $owner -eq 0 ]; then
        if [ -z "$serving" ]; then
          # 이전 버전 bml 이 띄운 서버는 이 표식을 남기지 않는다.  "모르니까
          # 그대로 둔다" 를 고르면 갱신을 받은 뒤에도 옛 코드가 계속 서비스되고,
          # 사용자는 고친 것이 반영된 줄 안다 — 실제로 그렇게 삭제 버튼이
          # 없다는 신고가 들어왔다.  증명하지 못하면 새로 띄운다.
          stale="어느 커밋인지 알 수 없는"
        elif [ -n "$current" ] && [ "$serving" != "$current" ]; then
          stale="이전 커밋(${serving:0:8})의"
        elif web_needs_build; then
          # HEAD 가 같아도 프론트 번들이 소스보다 낡을 수 있다 (빌드 전에 죽었거나,
          # 소스만 건드린 경우).  "이미 돌고 있습니다" 로 끝내면 아래 build_web 이
          # 아예 실행되지 않는다.
          stale="옛 화면을 담은"
        fi
      fi

      if [ -n "$stale" ]; then
        warn "떠 있는 서버가 ${stale} 것입니다 — 새로 띄웁니다."
        cmd_stop >/dev/null 2>&1 || true
        sleep 1
      else
        ok "이미 돌고 있습니다 → ${B}${URL}${OFF}"
        open_browser "$URL"
        return 0
      fi
    fi

    if [ $owner -eq 2 ]; then
      say ""
      say "  ${B}원인${OFF}  포트 ${PORT} 가 사용 중인데, 무엇이 쓰는지 확인할 수 없습니다."
      say "  ${DIM}      (lsof/ss/fuser 가 없어서 소유자를 알아낼 수 없습니다)${OFF}"
      say "  ${B}해결${OFF}  ${GREEN}WORKBENCH_PORT=6001 bml${OFF}"
      say "  ${DIM}      또는 소유자를 확인할 수 있게: sudo apt install -y lsof${OFF}"
      exit 1
    fi

    if [ $state -eq 1 ]; then
      warn "이전 서버가 떠 있지만 정상 응답하지 않습니다 — 내리고 다시 시작합니다."
    else
      warn "이전 bml 서버가 남아 있습니다 — 내리고 다시 시작합니다."
    fi
    cmd_stop >/dev/null 2>&1 || true

    # 포트가 풀리는 데 걸리는 시간은 붙어 있던 연결 수에 달렸다.  1초를 딱
    # 기다렸다 포기하면, 브라우저 탭 몇 개 열어 둔 것만으로 "포트를 옮기세요"
    # 가 나온다 — 옮길 이유가 없는데도.
    local freed=0
    while [ "$freed" -lt 80 ]; do
      port_busy "$PORT" || break
      sleep 0.1
      freed=$((freed + 1))
    done
    if port_busy "$PORT"; then
      die "포트 ${PORT} 가 아직 잡혀 있습니다. WORKBENCH_PORT=6001 bml 로 옮기세요."
    fi
  fi

  guard_data_dir
  build_web
  step "서버 시작 (포트 ${PORT})"
  (
    cd "$REPO"
    WORKBENCH_PORT="$PORT" \
    PYTHONPATH="$REPO/packages/wrdkit/src:$REPO/apps/api" \
    setsid nohup "$(python_bin)" -m uvicorn app.main:app \
      --host "$HOST" --port "$PORT" --app-dir "$REPO/apps/api" \
      --timeout-graceful-shutdown 3 \
      > "$LOG" 2>&1 < /dev/null &
    printf '%s' "$!" > "$PID_FILE"
  )

  case "$(wait_for_server "$URL/api/health" "$LOG"; echo $?)" in
    0)
      # setsid detaches the process, so record what is actually holding the
      # port -- that is what `bml stop` needs to kill.
      record_port_owner "$PORT" "$PID_FILE"
      # 이 서버가 어느 커밋의 코드를 들고 있는지 남긴다.  uvicorn 은 --reload
      # 없이 뜨므로 pull 을 해도 계속 옛 코드를 서비스하는데, 다음 `bml` 은
      # "이미 돌고 있습니다" 로 끝나 사용자는 갱신이 반영된 줄 안다.
      git -C "$REPO" rev-parse HEAD > "$HEAD_FILE" 2>/dev/null || : > "$HEAD_FILE"
      ok "실행 중 → ${B}${URL}${OFF}"
      say "${DIM}  멈추려면: bml stop   ·  로그: bml logs${OFF}"
      # 터널이 restart 를 살아서 넘어왔으면 그렇게 말한다.  예전에는 restart 가
      # 터널을 닫아서 주소가 매번 바뀌었으므로, "안 바뀌었다" 는 것 자체가
      # 알려야 할 소식이다 — 안 그러면 습관대로 bmlout 을 다시 치게 된다.
      if tunnel_running && [ -n "$(tunnel_url)" ]; then
        say "  ${DIM}공유 주소는 그대로입니다 →${OFF} ${B}$(tunnel_url)${OFF}"
      fi
      # 자기 데이터가 비어 있는데 중추 서버도 안 정해져 있으면, 화면에는 아무
      # 오류 없이 셀 0개짜리 워크벤치가 뜬다.  주소까지 늘 같은 localhost:5003
      # 이라 어느 쪽을 보고 있는지 화면으로는 알 수 없다 — 여기서 말해 준다.
      if [ -z "$SERVER" ] && [ "$(ls "$DATA_DIR/uploads" 2>/dev/null | wc -l | tr -d ' ')" = "0" ]; then
        say ""
        warn "이 화면은 ${B}이 기계의${OFF} 데이터입니다 — ${DATA_DIR} ${DIM}(원본 0개)${OFF}"
        say "  ${DIM}중추 서버를 보려면${OFF}  ${GREEN}bml use <주소>${OFF} ${DIM}후${OFF} ${GREEN}bml${OFF}"
        say "  ${DIM}주소는 중추 서버에서${OFF} ${GREEN}bml status${OFF} ${DIM}또는${OFF} ${GREEN}bml share${OFF} ${DIM}가 알려 줍니다.${OFF}"
      fi
      open_browser "$URL"
      ;;
    2) report_failure "$LOG" "서버가 시작하자마자 멈췄습니다."; exit 1 ;;
    *) report_failure "$LOG" "30초 동안 서버가 응답하지 않았습니다."; exit 1 ;;
  esac
}

start_dev() {
  if port_busy "$PORT" || port_busy "$API_PORT"; then
    die "포트 ${PORT} 또는 ${API_PORT} 가 사용 중입니다. 'bml stop' 을 먼저 하세요."
  fi

  step "개발 서버 시작 (핫 리로드)"
  (
    cd "$REPO"
    PYTHONPATH="$REPO/packages/wrdkit/src:$REPO/apps/api" \
    setsid nohup "$(python_bin)" -m uvicorn app.main:app \
      --reload --host 127.0.0.1 --port "$API_PORT" --app-dir "$REPO/apps/api" \
      --timeout-graceful-shutdown 3 \
      > "$LOG" 2>&1 < /dev/null &
    printf '%s' "$!" > "$PID_FILE"
  )
  (
    cd "$REPO/apps/web"
    WORKBENCH_PORT="$PORT" WORKBENCH_API_PORT="$API_PORT" \
    setsid nohup npm run dev > "$RUN_DIR/vite.log" 2>&1 < /dev/null &
    printf '%s' "$!" > "$DEV_PID_FILE"
  )

  if wait_for_server "$URL" "$RUN_DIR/vite.log"; then
    record_port_owner "$PORT" "$DEV_PID_FILE"
    record_port_owner "$API_PORT" "$PID_FILE"
    ok "개발 서버 → ${B}${URL}${OFF}   ${DIM}(API :${API_PORT})${OFF}"
    say "${DIM}  파일을 고치면 자동 반영됩니다  ·  멈추려면: bml stop${OFF}"
    open_browser "$URL"
  else
    report_failure "$RUN_DIR/vite.log" "개발 서버가 뜨지 않았습니다."
    say "${DIM}--- API 로그 ---${OFF}"
    tail -15 "$LOG" 2>/dev/null | sed 's/^/  /'
    exit 1
  fi
}

#: `/mnt/d/bml-data` 에서 **`/mnt/d` 가 마운트인가**.
#:
#: WSL 에서 이 차이가 전부다.  `/mnt/d` 가 드라이브면 그 아래는 D: 이고, 마운트가
#: 아니면 그냥 리눅스 루트의 빈 폴더다 — 이름이 같고, `ls` 도 `[ -d ]` 도 둘을
#: 구분하지 못한다.
#:
#: 경로가 `/mnt/<한 글자>/...` 꼴이면 그 마운트 지점을 찍는다.  아니면 실패.
wsl_drive_mount_of() {
  case "${1:-}" in
    /mnt/[A-Za-z]|/mnt/[A-Za-z]/*) ;;
    *) return 1 ;;
  esac
  printf '/mnt/%s' "$(printf '%s' "${1#/mnt/}" | cut -d/ -f1)"
}

#: 이 경로가 마운트 지점인가.  `mountpoint(1)` 은 없는 기계가 있어서 직접 본다.
#: /proc/mounts 는 공백을 \040 으로 이스케이프하지만 `/mnt/d` 에는 공백이 없다.
path_is_mounted() {
  [ -r /proc/mounts ] || return 1
  LC_ALL=C awk -v want="${1:-}" '$2 == want { hit = 1; exit } END { exit(hit ? 0 : 1) }' \
    /proc/mounts 2>/dev/null
}

#: 지금 붙어 있는 Windows 드라이브들 (`/mnt/c /mnt/d` 꼴).
#:
#: 예전에는 `/mnt` 아래 폴더를 전부 찍었다.  그러면 `/mnt/wslg /mnt/wsl` 이 섞여
#: 나오고 — 둘 다 드라이브가 아니다 — 무엇보다 **마운트가 아닌 빈 폴더가
#: 드라이브인 척** 목록에 들어간다.  마운트된 것만 센다.
wsl_mounted_drives() {
  local d out=""
  [ -d /mnt ] || return 0
  for d in /mnt/?; do
    [ -d "$d" ] || continue
    case "$d" in /mnt/[A-Za-z]) ;; *) continue ;; esac
    path_is_mounted "$d" && out="$out $d"
  done
  printf '%s' "${out# }"
}

#: 외장 드라이브에 데이터를 둔 중추 서버가, 드라이브가 안 잡힌 채로 뜨는 것을
#: 막는다.  그냥 두면 uvicorn 이 그 경로에 빈 data/ 를 새로 만들고 화면에는
#: 셀이 하나도 없는 멀쩡한 워크벤치가 뜬다 — 사람은 데이터가 날아갔다고 읽고,
#: 그 상태로 올린 파일은 나중에 드라이브를 꽂으면 보이지 않는 곳에 남는다.
#:
#: WORKBENCH_DATA 를 쓸 때만 검사한다.  저장소 안의 기본 data/ 는 첫 실행에
#: 만들어지는 것이 정상이라 없다고 막으면 안 된다.
guard_data_dir() {
  [ -n "${WORKBENCH_DATA:-}" ] || return 0
  [ -d "$WORKBENCH_DATA" ] && return 0
  printf '%s✕%s 데이터 폴더가 없습니다: %s\n' "$RED" "$OFF" "$WORKBENCH_DATA" >&2
  say "  ${DIM}(.bml/env 의 WORKBENCH_DATA 가 이 경로를 가리킵니다)${OFF}"
  data_dir_help "$WORKBENCH_DATA"
  exit 1
}

#: 없는 데이터 폴더를 어떻게 되살릴지.  `guard_data_dir` 과 `cmd_data` 가 같은
#: 화면을 쓴다 — 한쪽에만 맞는 안내를 하면 다른 쪽에서 그대로 틀린다.
data_dir_help() {
  local want="$1" mount letter

  #: **드라이브가 안 붙어 있는 경우를 먼저 가른다.**  실측: T7 외장 SSD 를 WSL
  #: 이 뜬 뒤에 꽂았더니 탐색기에는 D: 가 보이는데 `/mnt/d` 는 없었다.  그때
  #: 예전 안내는 `mkdir -p /mnt/d/bml-data` 를 시켰는데, 그것은 드라이브가
  #: 아니라 **리눅스 루트에 같은 이름의 빈 폴더**를 만든다.  그 뒤로는 검사가
  #: 통과하고, 워크벤치는 셀 0개로 멀쩡히 뜨고, 거기 올린 `.wrd` 는 드라이브를
  #: 꽂아도 안 보이는 곳에 쌓인다 — 이 가드가 막으려던 사고를, 가드의 안내문이
  #: 시키고 있었다.
  if is_wsl && mount="$(wsl_drive_mount_of "$want")" && ! path_is_mounted "$mount"; then
    letter="$(printf '%s' "${mount#/mnt/}" | tr '[:lower:]' '[:upper:]')"
    say ""
    say "  ${B}${letter}: 가 WSL 에 안 붙어 있습니다.${OFF} ${DIM}(폴더가 없는 것이 아니라, 드라이브가 없습니다)${OFF}"
    say "  ${DIM}WSL2 는 VM 이 뜰 때 붙어 있던 드라이브만 자동으로 붙입니다.  외장 SSD 를${OFF}"
    say "  ${DIM}나중에 꽂으면 Windows 탐색기에는 보이는데 여기서는 안 보입니다.${OFF}"
    say ""
    say "  ${B}지금 붙이기${OFF}   ${GREEN}sudo mkdir -p ${mount} && sudo mount -t drvfs ${letter}: ${mount}${OFF}"
    say "  ${B}재부팅해도${OFF}     ${GREEN}echo '${letter}: ${mount} drvfs defaults,nofail 0 0' | sudo tee -a /etc/fstab${OFF}"
    say ""
    say "  ${RED}mkdir -p \"$want\" 는 하지 마세요${OFF} ${DIM}— ${mount} 가 마운트가 아니라, 그 명령은${OFF}"
    say "  ${DIM}리눅스 쪽에 같은 이름의 빈 폴더를 만듭니다.  그 뒤로는 이 검사가 통과하고,${OFF}"
    say "  ${DIM}화면은 셀 0개로 멀쩡히 뜨고, 거기 올린 .wrd 는 드라이브에 안 남습니다.${OFF}"
    local drives; drives="$(wsl_mounted_drives)"
    [ -n "$drives" ] && say "" && say "  ${DIM}지금 붙어 있는 드라이브: ${drives}${OFF}"
    return 0
  fi

  # 드라이브는 붙어 있는데 그 안의 폴더가 없는 경우.  이때만 mkdir 이 맞다.
  say ""
  if [ -d "$(dirname "$want")" ]; then
    say "  ${B}이 자리가 맞다면${OFF}     ${GREEN}mkdir -p \"$want\"${OFF} ${DIM}(빈 워크벤치로 시작합니다)${OFF}"
  else
    say "  ${B}윗 폴더부터 없습니다${OFF} ${DIM}$(dirname "$want")${OFF} — 경로를 다시 보세요."
  fi
  say "  ${B}다른 곳에 둘 거라면${OFF}   ${GREEN}bml data <경로>${OFF}"
  say "  ${B}이 기계만의 데이터로${OFF}  ${GREEN}bml data off${OFF} ${DIM}— 저장소 안의 data/ 를 씁니다${OFF}"
  say "    ${DIM}중추 서버였다면 이건 빈 화면이 된다는 뜻입니다 (원본은 그 드라이브에 그대로).${OFF}"
  say "    ${DIM}보기만 할 거라면 띄우지 말고 중추 서버 주소를 브라우저로 여세요.${OFF}"
}

#: `bml data` — 데이터가 어디 있는지 보고, 옮기고, 되돌린다.
#:
#: `.bml/env` 를 손으로 고치라고 안내하던 자리다.  그 안내는 두 가지로 샜다.
#: 파일이 `.bml/` 안에 있어서 **지우는 것**이 제일 쉬운 되돌리기처럼 보이는데
#: (`rm .bml/env`), 그러면 외장하드를 쓰던 중추 서버가 조용히 빈 데이터로
#: 갈아탄다.  그리고 새 경로가 진짜 있는 자리인지 아무도 안 본다.
cmd_data() {
  local want="${1:-}"

  if [ -z "$want" ]; then
    if [ -n "${WORKBENCH_DATA:-}" ]; then
      say "데이터: ${B}${WORKBENCH_DATA}${OFF} ${DIM}(.bml/env)${OFF}"
    else
      say "데이터: ${B}${REPO}/data${OFF} ${DIM}(기본 — 이 기계만의 데이터)${OFF}"
    fi
    if [ -d "$DATA_DIR" ]; then
      say "  ${DIM}원본 $(uploads_count "$DATA_DIR/uploads")개 ${DIM}(.wrd · .mpr · .mpt · .mps)${OFF}"
    else
      printf '%s✕%s 그 폴더가 지금 없습니다.\n' "$RED" "$OFF" >&2
      data_dir_help "$DATA_DIR"
      return 1
    fi
    say ""
    say "  ${DIM}옮기기: bml data <경로>   ·   되돌리기: bml data off${OFF}"
    return 0
  fi

  if [ "$want" = "off" ] || [ "$want" = "기본" ]; then
    # 지금 보고 있던 것이 무엇이었는지 말하고 끈다.  중추 서버에서 이걸 치면
    # 화면이 비는데, 그 이유가 화면에 안 나오면 "데이터가 날아갔다" 가 된다.
    if [ -n "${WORKBENCH_DATA:-}" ]; then
      say "${DIM}${WORKBENCH_DATA} 는 그대로 둡니다 — 보지 않을 뿐입니다.${OFF}"
    fi
    if ! write_env_key WORKBENCH_DATA ""; then env_write_failed; return 1; fi
    ok "데이터: ${REPO}/data ${DIM}(이 기계만의 데이터)${OFF}"
    say "  ${DIM}되돌리려면: bml data <그 경로>${OFF}"
    return 0
  fi

  # `~/...` 는 우리가 편다 — 따옴표 안에 넣어 오면 셸이 안 펴 준다.
  case "$want" in "~/"*) want="$HOME/${want#\~/}" ;; esac
  # 절대 경로로 못 박는다.  `.bml/env` 는 어디서 실행하든 같은 곳을 가리켜야 한다.
  case "$want" in /*) ;; *) want="$PWD/$want" ;; esac
  want="${want%/}"

  if [ ! -d "$want" ]; then
    printf '%s✕%s 그런 폴더가 없습니다: %s\n' "$RED" "$OFF" "$want" >&2
    data_dir_help "$want"
    return 1
  fi

  if ! write_env_key WORKBENCH_DATA "$want"; then env_write_failed; return 1; fi
  ok "데이터: ${B}${want}${OFF}"
  say "  ${DIM}원본 $(uploads_count "$want/uploads")개  ·  적용하려면: bml restart${OFF}"
}

#: uploads/ 안의 원본 개수 — 종류를 가리지 않고 전부 센다.
#:
#: `-name '*.wrd'` 로 세던 자리다.  충방전만 있던 시절의 흔적인데, 그 뒤로
#: EIS 의 `.mpr`/`.mpt`/`.mps` 와 GITT 파일이 **같은 폴더**에 들어오면서
#: 임피던스만 담긴 외장하드가 "0개" 로 보였다 — 백업이 안 됐다는 뜻으로
#: 읽히는 화면이다 (`tools/backup.py` 는 처음부터 전부 복사한다).
uploads_count() {
  local dir="$1"
  [ -d "$dir" ] || { printf '0'; return 0; }
  find "$dir" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' '
}

#: `bml host` — 이 서버가 이 기계 안에서만 열릴지, 네트워크에 열릴지.
#:
#: `.bml/env` 에 `WORKBENCH_HOST=0.0.0.0` 을 손으로 적으라고 안내하던 자리다.
#: 손으로 적는 파일에는 이미 WORKBENCH_DATA 같은 다른 줄이 있고, 한 줄을 넣는
#: 가장 쉬운 방법이 `> .bml/env` 라서 나머지가 함께 날아간다 (실측: 그래서
#: 중추 서버가 localhost 전용이 되었고 노트북 두 대가 못 붙었다).
#: `write_env_key` 는 그 줄 하나만 바꾼다.
cmd_host() {
  case "${1:-}" in
    '')
      if [ "$HOST" = "0.0.0.0" ]; then
        say "공개: ${B}네트워크${OFF} ${DIM}(WORKBENCH_HOST=0.0.0.0)${OFF}"
        say "  ${DIM}이 기계 안에서만 열려면: bml host local${OFF}"
      else
        say "공개: ${B}이 기계 안에서만${OFF} ${DIM}(${HOST})${OFF}"
        say "  ${DIM}다른 기계에서 보게 하려면: bml host open${OFF}"
      fi
      ;;
    open|network|0.0.0.0)
      if ! write_env_key WORKBENCH_HOST "0.0.0.0"; then env_write_failed; return 1; fi
      ok "공개: 네트워크 ${DIM}(적용하려면 bml restart)${OFF}"
      # "접속 가능" 이 무슨 뜻인지 여기서 말한다.  status 가 같은 말을 하지만,
      # 이 줄을 친 그 순간에 안 나오면 나중에 status 를 볼 이유가 없다.
      if [ -z "${WORKBENCH_PASSWORD:-}" ]; then
        say "  ${DIM}이 주소에 닿는 사람은 암호 없이 전부 보고 고칩니다 — 랩 안에서는 이대로가 맞습니다.${OFF}"
        say "  ${DIM}걸려면: bml password <암호>${OFF}"
      fi
      ;;
    local|localhost|off|127.0.0.1)
      if ! write_env_key WORKBENCH_HOST ""; then env_write_failed; return 1; fi
      ok "공개: 이 기계 안에서만 ${DIM}(적용하려면 bml restart)${OFF}"
      say "  ${DIM}다른 기계에서 보던 중이었다면 그쪽은 이제 못 붙습니다.${OFF}"
      ;;
    *) die "모르는 값: $1   (open | local | 없음)" ;;
  esac
}

#: 다시 만들 수 없는 것만 다른 폴더로 복사한다.  자세한 것은 tools/backup.py.
cmd_backup() {
  local destination="${1:-${WORKBENCH_BACKUP:-}}"
  if [ -z "$destination" ]; then
    die "어디로 복사할지 알려 주세요:  bml backup /mnt/e/bml-backup
   ${DIM}매번 같은 곳이라면 .bml/env 에 WORKBENCH_BACKUP=... 를 적어 두세요.${OFF}"
  fi
  step "백업"
  ( cd "$REPO" && "$(python_bin)" "$REPO/tools/backup.py" "$destination" ) || exit 1
  ok "백업 완료."
}

#: 지금 떠 있는 서버가 실제로 어디에 열려 있는가.  `ss -ltn` 의 출력을 받는다.
#:
#: `.bml/env` 만 읽고 "공개" 라고 찍으면 안 된다.  설정을 나중에 넣고 서버를
#: 안 내렸으면 status 는 접속 가능하다고 하는데 다른 기계는 계속 못 붙는다 —
#: 그러면 멀쩡한 방화벽만 몇 번씩 다시 확인하게 된다.
listening_scope() {
  local text="$1"
  case "$text" in
    "") printf 'unknown' ;;
    *"0.0.0.0:$PORT"*|*"*:$PORT"*|*"[::]:$PORT"*) printf 'all' ;;
    *":$PORT"*) printf 'local' ;;
    *) printf 'unknown' ;;
  esac
}

#: 다른 기계가 칠 수 있는 주소만 남긴다.  `<종류> <주소>` 를 한 줄씩 찍는다.
#:
#: `hostname -I` 는 있는 것을 다 뱉는다 — 루프백, 주소를 못 받았을 때 붙는
#: 169.254.x, 도커 브리지, VirtualBox 호스트 전용 어댑터, WSL NAT.  그중
#: 어느 것을 골라도 다른 기계에서는 똑같이 "연결할 수 없음" 이라, 목록만
#: 보고는 어느 것이 맞는지 알 수가 없다.  실제로 첫 줄(169.254.x)을 골라
#: 한참 헤맸다.
#:
#: 종류를 나누는 이유: LAN 주소는 같은 공유기 안에서만 통한다.  두 사람이
#: 다른 공유기에 있으면 (실험실 PC 와 집 노트북이 그렇다) 사설망 주소가
#: 유일하게 통하는 주소인데, LAN 주소만 찍으면 그것을 안 알려 주게 된다.
reachable_addresses() {
  local addr octet
  for addr in $1; do
    case "$addr" in
      192.168.56.*) ;;                  # VirtualBox 호스트 전용 — 그 PC 안에서만
      10.*|192.168.*) printf 'lan %s\n' "$addr" ;;
      100.*)
        # 사설망(VPN)·이동통신이 쓰는 100.64.0.0/10.  공인 100.x 와 섞이지
        # 않게 두 번째 옥텟을 실제로 본다.
        octet="${addr#100.}"; octet="${octet%%.*}"
        case "$octet" in ''|*[!0-9]*) continue ;; esac
        [ "$octet" -ge 64 ] && [ "$octet" -le 127 ] && printf 'vpn %s\n' "$addr"
        ;;
      # 나머지는 버린다.  127.x 는 루프백, 169.254.x 는 주소를 못 받았다는
      # 뜻이고, 172.16–31.x 는 도커 브리지이거나 WSL NAT 안쪽이다.
    esac
  done
}

#: NAT 뒤의 WSL 이 Windows 에서 보이는 주소.  `hostname -I` 의 출력을 받는다.
#:
#: 이 값 하나가 `netsh ... connectaddress=` 에 들어간다.  사람이 손으로 옮겨
#: 적어야 하는 것이 정확히 이것이고, 가이드 자신이 적어 두었듯이 자리표시자를
#: 그대로 붙여넣어 "구문이 올바르지 않습니다" 를 보는 일이 실제로 일어난다.
#:
#: 사설망 대역만 남긴다.  `hostname -I` 는 있는 것을 다 뱉는데, 맨 앞이
#: `169.254.x`(= DHCP 를 못 받았다는 뜻)인 경우가 실제로 있었다 — 그것을 넘겨
#: 주면 포워딩은 걸리지만 아무것도 안 지나간다.
wsl_nat_address() {
  printf '%s' "${1:-}" | tr ' ' '\n' \
    | grep -E '^(172\.(1[6-9]|2[0-9]|3[01])\.|10\.)' | head -1
  return 0
}

#: WSL 에서 Windows 프로그램(`.exe`)을 부를 수 있는가.
#: `ok` | `wiped` | `disabled` | `unknown`.
#:
#: 인자는 (`/proc/sys/fs/binfmt_misc` 목록, `WSLInterop` 항목 내용) — 시험할 수
#: 있게 밖에서 받는다.
#:
#: 왜 이걸 보나.  `.exe` 를 부르면 커널이 `binfmt_misc` 의 `WSLInterop` 등록을
#: 보고 `/init` 에 넘긴다.  그런데 `/etc/wsl.conf` 에 `systemd=true` 를 두면
#: **systemd 가 부팅 때 binfmt 등록을 정리하면서 그것까지 지운다.**  그 뒤로
#: 모든 `.exe` 가 이렇게 죽는다:
#:
#:     -bash: /mnt/c/Windows/system32/ipconfig.exe: cannot execute binary file:
#:            Exec format error
#:
#: 이 문구에는 systemd 도 WSL 도 interop 도 나오지 않는다.  §0.5 의 CRLF,
#: `python3-venv`, `0x80370114` 와 같은 종류다 — 증상이 원인을 안 가리킨다.
#: 그리고 이 저장소는 이제 `.exe` 에 기댄다 (`bml mirrored`, LAN 주소 읽기).
interop_state() {
  local names="${1:-}" entry="${2:-}"
  [ -n "$names" ] || { printf 'unknown'; return; }
  case "$names" in
    *WSLInterop*) : ;;
    *) printf 'wiped'; return ;;
  esac
  case "$entry" in
    *disabled*) printf 'disabled' ;;
    *enabled*)  printf 'ok' ;;
    *)          printf 'unknown' ;;
  esac
}

#: 그 등록을 되살리는 명령들.
#:
#: **`/usr/lib/binfmt.d/` 에 파일을 두는 것만으로는 WSL 에서 아무 일도 안
#: 일어난다.**  처음에 그 두 줄을 안내했다가 실측에서 틀렸다:
#:
#:     systemd-binfmt.service - Set Up Additional Binary Formats was skipped
#:     because of an unmet condition check (ConditionVirtualization=!wsl)
#:
#: systemd 는 WSL 안에서 `systemd-binfmt` 를 **아예 건너뛴다.**  그래서 그
#: 디렉터리의 `.conf` 를 적용해 줄 사람이 없다.  (그 기계의 `binfmt_misc` 는
#: 멀쩡히 마운트돼 있었고 등록 목록만 비어 있었다 — systemd 가 지운 것이
#: 아니라 애초에 아무도 안 건 것이다.)
#:
#: 그래서 둘로 나눈다:
#:   1. **지금 살리기** — 커널에 직접 등록한다.  systemd 를 거치지 않는다.
#:      다만 커널 상태라 WSL 을 껐다 켜면 사라진다.
#:   2. **다음 부팅에도 살리기** — `ConditionVirtualization=` 를 빈 값으로 두는
#:      드롭인.  빈 값은 조건 목록을 초기화하므로 WSL 안에서도 서비스가 돌고,
#:      그때 `/usr/lib/binfmt.d/` 의 파일이 적용된다.
#:
#: `:WSLInterop:M::MZ::/init:PF` 는 WSL 이 원래 걸던 줄이다: 매직 `MZ`(DOS
#: 헤더)로 알아보고 `/init` 에 넘기며, `P` 는 argv[0] 보존, `F` 는 인터프리터를
#: 미리 열어 둔다.
interop_repair_now() {
  cat <<'FIXNOW'
sudo sh -c 'echo ":WSLInterop:M::MZ::/init:PF" > /proc/sys/fs/binfmt_misc/register'
FIXNOW
}

interop_repair_persist() {
  # 따옴표와 역슬래시를 있는 그대로 두려고 heredoc 을 쓴다 (셸이 손대지 않는다).
  cat <<'FIXLINES'
sudo mkdir -p /etc/systemd/system/systemd-binfmt.service.d
sudo sh -c 'printf "[Unit]\nConditionVirtualization=\n" > /etc/systemd/system/systemd-binfmt.service.d/wsl.conf'
sudo sh -c 'echo :WSLInterop:M::MZ::/init:PF > /usr/lib/binfmt.d/WSLInterop.conf'
sudo systemctl daemon-reload && sudo systemctl restart systemd-binfmt
FIXLINES
}

#: Windows 프로그램 하나를 WSL 에서 부를 길.  PATH 에 없으면 System32 에서
#: 직접 찾는다.  못 찾으면 빈 값과 1.
#:
#: `command -v ipconfig.exe` 가 빈손으로 오는 기계가 실제로 있다:
#: `/etc/wsl.conf` 에 `appendWindowsPath=false` 를 두면 Windows 의 PATH 가 안
#: 붙는다 (PATH 가 지저분해지는 것을 싫어해서 그렇게 두는 사람이 있다).  그때
#: 화면은 "주소를 못 찾았습니다" 로만 끝나서, 왜 못 찾았는지가 안 보인다.
#: System32 위치는 변수로 둔다 — 시험에서 갈아 끼울 수 있어야 이 갈래가
#: 실제로 도는지 확인된다 (Codex 리뷰의 테스트 지적: 예전 시험은 가짜 폴더를
#: 만들기만 하고 쓰지 않아, 이 분기를 지워도 통과했다).
WIN_SYSTEM32="${WIN_SYSTEM32:-/mnt/c/Windows/System32}"

win_exe() {
  local name="${1:-}"
  [ -n "$name" ] || return 1
  command -v "$name" >/dev/null 2>&1 && { printf '%s' "$name"; return 0; }
  [ -x "$WIN_SYSTEM32/$name" ] && { printf '%s/%s' "$WIN_SYSTEM32" "$name"; return 0; }
  return 1
}

#: `ipconfig` 출력을 **어댑터 단위로** 읽어 "이름 <TAB> IPv4" 목록을 낸다.
#:
#: 어댑터 이름 줄은 맨 왼쪽에서 시작하고 `:` 로 끝난다.  나머지는 들여쓴다.
#: `IPv4` 라는 낱말은 어느 언어의 Windows 에서도 번역되지 않는다.
windows_ipv4_by_adapter() {
  printf '%s\n' "${1:-}" | LC_ALL=C awk '
    /^[^ \t]/ { name = $0; sub(/:[ \t]*$/, "", name); next }
    /IPv4/    { if (match($0, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/))
                  print name "\t" substr($0, RSTART, RLENGTH) }
  '
}

#: `route print -4 0.0.0.0` 출력에서 **기본 경로가 나가는 인터페이스의 주소**.
#:
#: 이름으로 고르던 것을 여기로 옮겼다 (Codex 리뷰 7번).  어댑터 이름은 정체성이
#: 아니다: `VMware Network Adapter VMnet8` 이 `192.168.231.1` 을 들고 있으면
#: 이름 규칙은 그것을 LAN 으로 보고 노트북에 그 주소를 쓰라고 한다.  반대로
#: 사람이 어댑터 이름을 바꾸면(Windows 가 공식 지원한다) 진짜 LAN 을 버린다.
#:
#: 기본 경로는 짐작이 아니다 — **Windows 자신이 밖으로 나갈 때 쓰는 길**이고,
#: 다른 기계가 이 PC 로 들어올 때 쓰는 주소도 거기에 붙어 있다.  경로가 여럿이면
#: 메트릭이 가장 낮은 것이 이긴다 (Windows 가 고르는 규칙 그대로).
#:
#: 표의 열: 대상 / 마스크 / 게이트웨이 / **인터페이스** / 메트릭.
windows_default_route_ip() {
  printf '%s\n' "${1:-}" | LC_ALL=C awk '
    $1 == "0.0.0.0" && $2 == "0.0.0.0" && NF >= 5 &&
    $4 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $5 ~ /^[0-9]+$/ {
      if (best == "" || $5 + 0 < metric) { best = $4; metric = $5 + 0 }
    }
    END { if (best != "") print best }
  '
}

#: 그중 다른 기계가 칠 수 있는 것 하나.  없으면 빈 값.
#:
#: **대역이 아니라 어댑터 이름으로 거른다.**  처음에는 `reachable_addresses`
#: 를 그대로 썼는데 — 그것은 `hostname -I` 처럼 이름이 없는 목록을 받으므로
#: `172.16–31` 을 통째로 버린다 (WSL NAT·도커 브리지가 거기 있다) — 랩·사내
#: 망이 `172.16–31` 사설 대역을 쓰는 곳이 **실제로 있다.**  그러면 진짜 LAN
#: 주소를 버리고 "쓸 만한 것이 없습니다" 로 끝난다.  이름이 있으면 그럴 이유가
#: 없다: WSL 것은 어댑터 이름에 `vEthernet (WSL)` 이라고 적혀 있다.
windows_lan_pick() {
  printf '%s\n' "${1:-}" | LC_ALL=C awk -F'\t' '
    $1 ~ /vEthernet|WSL|Loopback|VirtualBox|Hyper-V|Bluetooth|Teredo|isatap/ { next }
    $2 ~ /^169\.254\./ || $2 ~ /^127\./ || $2 ~ /^0\./ { next }
    { print $2; exit }
  '
}

#: Windows 쪽 LAN 주소.  `ipconfig.exe` 출력을 받는다 (없으면 직접 부른다).
#:
#: NAT 모드의 WSL 에서는 `hostname -I` 가 `172.x` 밖에 못 준다 — 그 값은 밖에서
#: 못 쓴다.  다른 기계가 실제로 칠 주소는 **Windows 쪽 어댑터의 IPv4** 이고,
#: 그것을 사람에게 "ipconfig 를 쳐서 IPv4 를 찾아 적으세요" 로 넘겨 왔다.
#: WSL 에서 `ipconfig.exe` 를 부를 수 있으므로 우리가 읽어 준다 (§0.3).
#: 못 찾으면 빈 값 — 짐작하지 않는다 (§0.4).
windows_lan_address() {
  local out ip
  # 1) 기본 경로가 나가는 주소.  이름 규칙이 아니라 Windows 자신의 판단이다.
  if [ $# -eq 0 ]; then
    ip="$(windows_default_route_ip "$(windows_route_print)")"
    case "$ip" in
      ''|0.0.0.0|127.*|169.254.*) ip="" ;;
    esac
    [ -n "$ip" ] && { printf '%s' "$ip"; return 0; }
  fi
  # 2) 그것을 못 읽으면 어댑터 목록에서 고른다 (이름 규칙 — 덜 확실하다).
  out="$(windows_ipconfig ${1+"$1"})" || return 0
  windows_lan_pick "$(windows_ipv4_by_adapter "$out")"
}

#: `route.exe print -4 0.0.0.0` 을 부른 결과.  못 부르면 1.
#: `windows_ipconfig` 과 같은 이유로 출력이 비면 실패로 본다.
windows_route_print() {
  local exe out
  exe="$(win_exe route.exe)" || return 1
  out="$("$exe" print -4 0.0.0.0 2>/dev/null | tr -d '\r')"
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

#: `ipconfig.exe` 를 부른 결과.  인자를 주면 그것을 그대로 쓴다 (시험용).
#:
#: 바이트로만 읽는다: 한국어 Windows 는 CP949 로 찍는데, UTF-8 로케일의 grep·
#: awk 는 올바르지 않은 멀티바이트가 섞인 줄에서 매칭을 조용히 놓친다 —
#: 주소는 ASCII 인데 같은 줄의 '주소' 두 글자 때문에 못 찾는다.
windows_ipconfig() {
  local exe out="${1:-}"
  if [ -z "$out" ]; then
    exe="$(win_exe ipconfig.exe)" || return 1
    out="$("$exe" 2>/dev/null | tr -d '\r')"
  fi
  # **실행 가능해 보이는 것과 실제로 도는 것은 다르다.**  drvfs 는 /mnt/c 의
  # 모든 파일에 실행 비트를 붙이므로 `[ -x ]` 는 interop 이 꺼져 있어도 참이다.
  # 그때 ipconfig.exe 는 한 줄도 못 내놓고 죽는데, 화면은 그것을 "부를 수는
  # 있는데 쓸 주소가 없습니다" 라는 **틀린 진단**으로 냈다 (실제로 그랬다).
  # 출력이 비면 못 부른 것이다.
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

#: `.wslconfig` 에 `networkingMode=mirrored` 를 넣는 PowerShell **한 줄**.
#:
#: 예전에는 파일 두 줄(`[wsl2]` / `networkingMode=mirrored`)을 화면에 그냥
#: 찍었다.  붙여넣을 명령과 같은 초록이라 구분이 안 됐고, 실제로 PowerShell 에
#: 그대로 붙여넣어 `'networkingMode=mirrored' 용어가 ... 인식되지 않습니다` 를
#: 두 번 봤다.  그래서 **파일을 고치는 일까지 명령 한 줄로 준다.**
#:
#: 이 한 줄이 지키는 것:
#:   - 이미 있는 `.wslconfig` 를 덮어쓰지 않는다 (memory·processors 등이 산다).
#:   - `[wsl2]` 절이 이미 있으면 **그 절 안에** 넣는다.  절을 하나 더 붙이지
#:     않는다 — 같은 절이 두 번 나올 때 WSL 이 어느 쪽을 읽는지 확인한 바가
#:     없다.  확인 못 한 것에 기대지 않는다 (§0.4).
#:   - `networkingMode` 가 이미 있으면 그 줄을 mirrored 로 **바꾼다**.  NAT 이라고
#:     적혀 있는 파일에 아무것도 안 하고 끝나면, 사람은 켰다고 믿는다.
#:   - 끝에 파일을 그대로 찍는다 — 사람이 결과를 눈으로 본다.
#:
#: 관리자 권한은 필요 없다 (자기 홈의 파일이다).  줄바꿈이 들어가면 안 된다 —
#: 붙여넣기 한 번에 끝나야 하고, PowerShell 은 잘린 줄을 계속 프롬프트로
#: 기다리기만 한다.  `test_bml_client.sh` 가 그 한 줄임을 고정한다.
wslconfig_mirror_command() {
  # 따옴표를 있는 그대로 두려고 heredoc 을 쓴다 (셸이 손대지 않는다).
  cat <<'PSLINE'
$f="$env:USERPROFILE\.wslconfig"; $e=New-Object System.Text.UTF8Encoding($false); $t=''; if(Test-Path -LiteralPath $f){if((Get-Item -LiteralPath $f -Force).LinkType){throw "$f 는 링크입니다 - 무엇을 고치게 될지 알 수 없어 멈춥니다"}; $t=[IO.File]::ReadAllText($f,$e)}; if($t -notmatch '(?m)^[ \t]*networkingMode[ \t]*=[ \t]*mirrored[ \t]*\r?$'){if((Test-Path -LiteralPath $f) -and -not (Test-Path -LiteralPath "$f.bml-bak")){Copy-Item -LiteralPath $f -Destination "$f.bml-bak" -ErrorAction Stop}; if($t -match '(?m)^[ \t]*networkingMode'){$t=$t -replace '(?m)^[ \t]*networkingMode[ \t]*=[^\r\n]*','networkingMode=mirrored'}elseif($t -match '(?m)^\[wsl2\]'){$t=$t -replace '(?m)^\[wsl2\]',"[wsl2]`r`nnetworkingMode=mirrored"}else{$t="[wsl2]`r`nnetworkingMode=mirrored`r`n$t"}; [IO.File]::WriteAllText($f,$t,$e)}; Get-Content -LiteralPath $f
PSLINE
}

#: `/mnt/c/Users` 아래에서 사람의 폴더를 고른다.  못 고르면 빈 값.
#:
#: 상호운용(`cmd.exe`)이 꺼져 있는 기계가 실제로 있어서 대비가 필요하다.
#: 다만 **짐작해서 남의 폴더에 쓰지는 않는다** (§0.4) — 확실한 신호가 있을
#: 때만 고른다: 이미 `.wslconfig` 가 있는 폴더가 하나뿐이거나, WSL 사용자
#: 이름과 같은 폴더가 있거나, 시스템 폴더를 뺀 사람 폴더가 딱 하나거나.
windows_home_candidate() {
  local users="${1:-/mnt/c/Users}" me="${2:-$(id -un 2>/dev/null)}"
  local d n=0 hit="" name
  [ -d "$users" ] || return 0
  # 1) 이미 .wslconfig 가 있는 폴더가 하나뿐이면 그것이다.
  for d in "$users"/*; do
    [ -f "$d/.wslconfig" ] || continue
    hit="$d"; n=$((n + 1))
  done
  [ "$n" = 1 ] && { printf '%s' "$hit"; return 0; }
  # 2) WSL 사용자 이름과 같은 폴더.  Windows 는 대소문자를 안 가리므로 맞춘다.
  for d in "$users"/*; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    case "$name" in Public|Default|"Default User"|"All Users") continue ;; esac
    if [ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" \
       = "$(printf '%s' "$me" | tr '[:upper:]' '[:lower:]')" ]; then
      printf '%s' "$d"; return 0
    fi
  done
  # 3) 시스템 폴더를 뺀 사람 폴더가 딱 하나면 그것.
  n=0; hit=""
  for d in "$users"/*; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in Public|Default|"Default User"|"All Users") continue ;; esac
    hit="$d"; n=$((n + 1))
  done
  [ "$n" = 1 ] && printf '%s' "$hit"
  return 0
}

#: Windows 사용자 폴더를 WSL 에서 본 경로로.  못 찾으면 빈 값.
#: **Windows 가 스스로 말한** 사용자 폴더.  interop 으로 `%USERPROFILE%` 을
#: 직접 물어본 것만 여기로 나온다.  못 물어봤으면 빈 값이다.
#:
#: 이 구분이 왜 필요한가 (Codex 리뷰 1번).  `windows_home_candidate` 의 세
#: 규칙(`.wslconfig` 가 하나뿐 / WSL 사용자명과 같음 / 사람 폴더가 하나뿐)은
#: **지금 로그인한 Windows 사용자라는 증거가 아니다.**  `C:\Users\Alice` 에만
#: `.wslconfig` 가 있고 실제 사용자가 Bob 이면, 짐작은 Alice 를 고르고 화면은
#: 그것을 `%USERPROFILE%\.wslconfig` 라고 부른 뒤 **남의 파일을 고친다.**
#: §0.3 으로 자동화해도 되는 값이 아니라 §0.4 로 "모른다" 고 해야 하는 값이다.
#: 그래서 **쓰기는 이 함수의 결과로만 한다.**  짐작은 화면에 제안으로만 쓴다.
windows_home_verified() {
  local p="" cmdexe=""
  cmdexe="$(win_exe cmd.exe)" || return 0
  command -v wslpath >/dev/null 2>&1 || return 0
  # /mnt/c 에서 부른다.  WSL 경로에서 cmd.exe 를 부르면 "UNC 경로는
  # 지원되지 않습니다" 를 먼저 뱉고 제멋대로 C:\Windows 로 옮겨 간다.
  p="$( (cd /mnt/c 2>/dev/null && "$cmdexe" /C 'echo %USERPROFILE%') 2>/dev/null | tr -d '\r\n' )"
  case "$p" in
    [A-Za-z]:\\*)
      p="$(wslpath -u "$p" 2>/dev/null)"
      [ -n "$p" ] && [ -d "$p" ] && printf '%s' "$p"
      ;;
  esac
  return 0
}

#: 읽기 전용으로 쓸 때의 사용자 폴더 — 증명된 것이 있으면 그것, 없으면 짐작.
#: **여기 값으로 파일을 쓰지 않는다.**
windows_home() {
  local p; p="$(windows_home_verified)"
  [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  windows_home_candidate
}

#: `.wslconfig` 를 mirrored 로 고친다.  경로 하나만 받는다 — 그래야 시험한다.
#:
#: 세 경우가 있고 셋 다 다르게 다뤄야 한다:
#:   - `networkingMode` 가 이미 있으면 **그 줄만** 바꾼다.  `NAT` 이라고 적혀
#:     있는 파일에 두 줄을 더 얹고 끝나면, 사람은 켰다고 믿는데 안 켜져 있다.
#:   - `[wsl2]` 절이 있으면 그 절 **안에** 넣는다.  절을 하나 더 만들지 않는다
#:     — 같은 절이 두 번 나올 때 WSL 이 어느 쪽을 읽는지 확인한 바가 없다.
#:     확인 못 한 것에 기대지 않는다 (§0.4).
#:   - 둘 다 없으면 맨 앞에 절째로 넣는다.  뒤에 있던 것은 그대로 산다.
#:
#: 줄바꿈은 **그 파일이 쓰던 것을 그대로 쓴다.**  Windows 가 읽는 파일에 LF 와
#: CRLF 를 섞어 놓는 것은 이 저장소가 §0.5 로 이미 값을 치른 종류의 사고다.
#:
#: 0 = 고쳤다, 1 = 이미 mirrored 라 손대지 않았다, 2 = 쓰지 못했다.
#: `[wsl2]` 절 **안에서만** 키 하나를 찾는다.  찾으면 그 값을 찍는다.
#:
#: 절 범위를 안 보면 이렇게 틀린다 (Codex 2차 리뷰 5번):
#:
#:     [wsl2]
#:     memory=8GB
#:     [experimental]
#:     networkingMode=NAT      ← 이것을 고치고 "됐다" 고 한다
#:
#: `[wsl2]` 에는 설정이 안 들어가고, 반대로 엉뚱한 절의 mirrored 를 보고
#: "이미 되어 있다" 고도 한다.  둘 다 사람은 켰다고 믿는데 안 켜져 있다.
wslconfig_value_in_wsl2() {
  local f="$1" key="$2"
  [ -r "$f" ] || return 2
  LC_ALL=C awk -v key="$key" '
    { line = $0; sub(/\r$/, "", line) }
    line ~ /^[ \t]*\[/ { insec = (line ~ /^[ \t]*\[wsl2\][ \t]*$/); next }
    insec && line ~ ("^[ \t]*" key "[ \t]*=") {
      sub(/^[ \t]*[^=]*=[ \t]*/, "", line); sub(/[ \t]*$/, "", line)
      print line; found = 1; exit
    }
    END { exit(found ? 0 : 1) }
  ' "$f"
}

#: 이미 mirrored 인가.  읽지 못하면 2 (모름) — "아니다" 로 세지 않는다.
wslconfig_is_mirrored() {
  local f="$1" v
  [ -f "$f" ] || return 1
  [ -r "$f" ] || return 2
  v="$(wslconfig_value_in_wsl2 "$f" networkingMode)" || return 1
  [ "$v" = "mirrored" ]
}

#: 이 파일을 우리가 고쳐도 되는가.  된다면 0, 아니면 1 과 이유를 표준출력으로.
#:
#: 링크를 따라가면 안 된다 (Codex 리뷰 2번).  `.wslconfig` 가
#: `~/.ssh/config` 로 가는 심볼릭 링크면, 화면은 `.wslconfig` 를 고친다고
#: 말하면서 **SSH 설정을 덮어쓴다.**  `-f`·`grep`·`cat >` 가 전부 링크를
#: 따라가므로 우리는 눈치도 못 챈다.  BOM 도 마찬가지다: 앞에 BOM 이 있는
#: 파일에 절을 앞에 붙이면 BOM 이 파일 한가운데로 간다.
wslconfig_writable_reason() {
  local f="$1"
  [ -L "$f" ] && { printf '심볼릭 링크입니다 — 무엇을 고치게 될지 알 수 없습니다'; return 1; }
  [ -L "$f.bml-bak" ] && { printf '백업 자리(%s.bml-bak)가 심볼릭 링크입니다' "$f"; return 1; }
  if [ -e "$f" ]; then
    [ -f "$f" ] || { printf '보통 파일이 아닙니다'; return 1; }
    [ -r "$f" ] || { printf '읽을 수 없습니다'; return 1; }
    [ -w "$f" ] || { printf '쓸 수 없습니다'; return 1; }
    local head_hex
    head_hex="$(head -c 4 "$f" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
    case "$head_hex" in
      efbbbf*) printf 'UTF-8 BOM 이 붙어 있습니다 — 손대면 BOM 이 파일 중간으로 갑니다'; return 1 ;;
      fffe*|feff*) printf 'UTF-16 파일입니다 — 우리 도구는 바이트로 다뤄서 섞어 놓게 됩니다'; return 1 ;;
    esac
    # BOM 이 없는 UTF-16 도 있다.  NUL 바이트가 그 표식이고, 텍스트 설정
    # 파일에는 원래 없어야 한다 (Codex 2차 리뷰 3번).
    # bash 는 문자열에 NUL 을 담지 못한다 — `grep -q $'\000'` 은 **빈 패턴**이
    # 되어 모든 파일에 걸린다 (여기서 한 번 걸렸다: 멀쩡한 CRLF 파일을 전부
    # 거부했다).  지워서 크기가 달라지는지로 본다.
    if ! LC_ALL=C tr -d '\000' < "$f" 2>/dev/null | cmp -s - "$f"; then
      printf 'NUL 바이트가 있습니다 — 텍스트가 아닌 인코딩입니다'
      return 1
    fi
  else
    [ -d "$(dirname "$f")" ] || { printf '폴더가 없습니다: %s' "$(dirname "$f")"; return 1; }
    [ -w "$(dirname "$f")" ] || { printf '그 폴더에 쓸 수 없습니다'; return 1; }
  fi
  return 0
}

#: `.wslconfig` 를 mirrored 로 고친다.  경로 하나만 받는다 — 그래야 시험한다.
#:
#: 세 경우가 있고 셋 다 다르게 다뤄야 한다:
#:   - `networkingMode` 가 이미 있으면 **그 줄만** 바꾼다.  `NAT` 이라고 적혀
#:     있는 파일에 두 줄을 더 얹고 끝나면, 사람은 켰다고 믿는데 안 켜져 있다.
#:   - `[wsl2]` 절이 있으면 그 절 **안에** 넣는다.  절을 하나 더 만들지 않는다
#:     — 같은 절이 두 번 나올 때 WSL 이 어느 쪽을 읽는지 확인한 바가 없다 (§0.4).
#:   - 둘 다 없으면 맨 앞에 절째로 넣는다.  뒤에 있던 것은 그대로 산다.
#:
#: 줄바꿈은 **그 파일이 쓰던 것을 그대로 쓴다** (§0.5).
#:
#: **읽기 실패를 성공으로 세지 않는다** (Codex 리뷰 3번).  예전에는 `grep`·
#: `awk`·`cat` 의 실패를 아무도 안 봤고, 마지막 `cat "$tmp" > "$f"` 가 원본을
#: 먼저 비우므로 **불완전한 결과를 쓰고도 성공 화면에 도착**할 수 있었다.
#: 이제 각 단계를 확인하고, 완성된 임시 파일이 그럴듯한지(우리가 넣은 줄이
#: 실제로 들어갔는지) 본 뒤에야 원본에 손댄다.
#:
#: 0 = 고쳤다, 1 = 이미 mirrored 라 손대지 않았다, 2 = 못 했다.
wslconfig_set_mirrored() {
  local f="$1" tmp rc=0 cr st
  wslconfig_is_mirrored "$f"; st=$?
  [ "$st" = 0 ] && return 1
  [ "$st" = 2 ] && return 2
  wslconfig_writable_reason "$f" >/dev/null || return 2

  # 임시 파일은 **대상과 같은 폴더**에 만든다 — 그래야 mv 가 같은 파일시스템
  # 안에서 일어나고, 되면 통째로 갈아 끼울 수 있다.
  tmp="$(mktemp "${f}.bml-new.XXXXXX" 2>/dev/null)" || return 2

  if [ ! -e "$f" ]; then
    printf '[wsl2]\r\nnetworkingMode=mirrored\r\n' > "$tmp" || rc=2
  elif wslconfig_value_in_wsl2 "$f" networkingMode >/dev/null; then
    # `[wsl2]` 절 **안의** 그 줄만 바꾼다.  다른 절의 같은 이름은 남의 설정이다.
    LC_ALL=C awk '
      { line = $0; sub(/\r$/, "", line); cr = ($0 ~ /\r$/) ? "\r" : "" }
      line ~ /^[ \t]*\[/ { insec = (line ~ /^[ \t]*\[wsl2\][ \t]*$/); print; next }
      insec && !done && line ~ /^[ \t]*networkingMode[ \t]*=/ {
        print "networkingMode=mirrored" cr; done = 1; next
      }
      { print }
    ' "$f" > "$tmp" || rc=2
  elif grep -qE '^[[:space:]]*\[wsl2\][[:space:]]*$' "$f"; then
    LC_ALL=C awk 'BEGIN { put = 0 }
         { print
           if (!put && $0 ~ /^[ \t]*\[wsl2\][ \t\r]*$/) {
             cr = ($0 ~ /\r$/) ? "\r" : ""; print "networkingMode=mirrored" cr; put = 1
           } }' "$f" > "$tmp" || rc=2
  else
    cr=$'\r'
    # 빈 파일이면 Windows 가 읽는 파일이니 CRLF 로 시작한다.
    [ -s "$f" ] && { head -1 "$f" | grep -q $'\r$' || cr=""; }
    { printf '[wsl2]%s\nnetworkingMode=mirrored%s\n' "$cr" "$cr" && cat "$f"; } > "$tmp" || rc=2
  fi

  # 만든 것이 그럴듯한가.  여기서 걸러야 원본이 무사하다.
  if [ "$rc" = 0 ]; then
    # 만든 것이 **`[wsl2]` 절 안에서** mirrored 인가.  파일 어딘가에 그 글자가
    # 있는 것으로는 부족하다 — 엉뚱한 절에 넣고 통과하면 안 된다.
    [ "$(wslconfig_value_in_wsl2 "$tmp" networkingMode)" = "mirrored" ] || rc=2
  fi
  if [ "$rc" = 0 ] && [ -s "$f" ]; then
    # **길이로 재지 않는다** (Codex 2차 리뷰 12번).  `networkingMode=virtioproxy`
    # (공식 값이다) 를 mirrored 로 바꾸면 파일이 짧아져서, 길이 검사는 멀쩡한
    # 설정을 거부하고 화면은 권한 문제로 오진한다.  대신 **줄 수**를 본다 —
    # 우리는 줄을 넣거나 한 줄을 바꾸기만 하므로 줄이 줄어들 수는 없다.
    [ "$(wc -l < "$tmp")" -ge "$(wc -l < "$f")" ] || rc=2
  fi
  [ "$rc" = 0 ] || { rm -f "$tmp"; return 2; }

  # 통째로 갈아 끼운다.  **못 하면 원본을 건드리지 않는다** (Codex 2차 리뷰
  # 2번).  예전에는 `cat "$tmp" > "$f"` 로 물러섰는데, 그것은 원본을 **먼저
  # 비우고** 쓰는 것이라 도중에 실패하면 설정이 조각난 채 남는다 — 리뷰어가
  # `mv`·`cat` 을 실패시켜 37바이트 원본이 7바이트로 잘리는 것을 재현했다.
  # 되돌릴 백업이 있어도, 화면이 실패라고 말하는데 파일이 망가져 있으면 안 된다.
  if mv -f "$tmp" "$f" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp"
  return 2
}

#: **지금 설정한 암호가 떠 있는 서버의 문을 여는가.**
#:
#: 401 은 문이 있다는 증거일 뿐 그 문이 **이 암호의 것**이라는 증거가 아니다
#: (Codex 리뷰 9번).  `bml password 새암호` 를 적고 `bml restart` 를 안 하면
#: 서버는 옛 암호를 들고 있는데 무인증 요청은 똑같이 401 이다 — 화면은 잠겼다고
#: 하고, 사람은 새 암호를 남에게 알려 주고, 그 사람은 못 들어온다.
#: 문을 실제로 두드려 봐야 안다.  성공은 303 (로그인 뒤 리다이렉트)이다.
door_password_works() {
  local url="${1:-}" pass="${2:-}" code
  [ -n "$url" ] && [ -n "$pass" ] || return 1
  code="$(curl -s -o /dev/null -m 6 -w '%{http_code}' \
          --data-urlencode "password=$pass" "$url/__login" 2>/dev/null \
          | tr -dc '0-9' | tail -c 3)"
  [ "$code" = "303" ]
}

#: 지금 떠 있는 서버에 문이 있는가.  (`/api/samples` 의 HTTP 코드, 설정된 암호)
#: 를 받아 낱말 하나로 답한다.
#:
#: **설정에 암호가 있는 것과 떠 있는 서버가 그것을 들고 있는 것은 다르다.**
#: 암호를 적어 두고 `bml restart` 를 안 하면 문이 없는 채로 열려 있는데, 화면에
#: '암호 있음' 만 보이면 사람은 잠갔다고 믿는다.  `bml share` 가 터널을 열기
#: 전에 같은 확인을 하는 이유와 같다 (ADR 0014).
door_state() {
  local code="${1:-}" pass="${2:-}"
  case "$code" in
    401)     printf 'locked' ;;
    ''|000)  printf 'unknown' ;;
    *)       [ -n "$pass" ] && printf 'pending' || printf 'open' ;;
  esac
}

#: 이 스크립트가 아는 명령 목록.  main() 의 case 라벨에서 뽑는다.
#:
#: 목록을 따로 손으로 두면 반드시 어긋나고, 어긋난 쪽이 하필 화면에 나온다.
#: 안쪽 case (repair web/crlf) 는 들여쓰기가 깊어서 걸리지 않는다.
known_commands() {
  awk '/^  case "\$\{1:-serve\}" in/,/^  esac$/' "$SCRIPT" \
    | grep -E '^    [^ ]' | sed 's/).*//' | tr '|' '\n' | tr -d '"' \
    | sed 's/[[:space:]]//g' | grep -v '^\*$' | grep -v '^$'
}

#: 오타에 가장 가까운 명령들.  없으면 빈 값.
#:
#: 정규식으로 하지 않는다 — 사람이 친 문자열이 그대로 패턴이 되면 `bml *` 같은
#: 입력에 엉뚱한 것이 걸린다.  셋을 순서대로 본다: 내가 친 것으로 시작하는 명령,
#: 내가 친 것이 그 명령으로 시작하는 경우, 그리고 앞 세 글자가 같은 경우
#: (`mirrorred` → `mirrored` 는 앞뒤 어느 쪽으로도 접두사가 아니다).
suggest_commands() {
  local typed="${1:-}" c out=""
  [ -n "$typed" ] || return 0
  while read -r c; do case "$c" in "$typed"*) out="$out $c" ;; esac; done < <(known_commands)
  if [ -z "$out" ]; then
    while read -r c; do case "$typed" in "$c"*) out="$out $c" ;; esac; done < <(known_commands)
  fi
  if [ -z "$out" ] && [ "${#typed}" -ge 3 ]; then
    local head3="${typed:0:3}"
    while read -r c; do case "$c" in "$head3"*) out="$out $c" ;; esac; done < <(known_commands)
  fi
  printf '%s' "${out# }"
}

#: 모르는 명령을 만났을 때.
#:
#: `모르는 명령: mirrored` 는 사람에게 **"네가 잘못 쳤다"** 로 읽힌다.  그런데
#: 실제로 가장 흔한 이유는 오타가 아니라 **이 기계의 bml 이 옛것**인 것이다:
#: 화면이나 문서가 알려 준 새 명령을 그대로 쳤는데 여기엔 아직 없다.  bml 은 늘
#: pull 을 먼저 하지만, 명령을 못 알아보는 자리는 그 pull 보다 **앞**이라 옛
#: 목록으로 판단하고 끝나 버린다 (실제로 `bml mirrored` 가 그렇게 튕겼다).
#:
#: 그래서 여기서 한 번 맞춰 본다.  새 bml 이 실려 있으면 sync_repo 가 그것을
#: 받고 **이 명령 그대로 다시 실행한다** — BML_REEXECED 가 무한 반복을 막는다.
#: 맞춰 봐도 없으면 그때가 진짜 오타이고, 그때 가까운 이름을 짚어 준다.
cmd_unknown() {
  local cmd="${1:-}" guess
  if [ -z "${BML_REEXECED:-}" ] && git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
    warn "'$cmd' 를 모릅니다 — 이 기계의 bml 이 옛것일 수 있어 먼저 맞춰 봅니다."
    sync_repo
    say ""
  fi
  guess="$(suggest_commands "$cmd")"
  [ -n "$guess" ] && say "  ${DIM}혹시:${OFF} ${GREEN}${guess}${OFF}"
  say "  ${DIM}전체 목록은${OFF} ${GREEN}bml help${OFF}"
  die "모르는 명령: $cmd"
}

#: 다른 기계가 칠 수 있는 주소가 하나도 없을 때의 안내.
#:
#: 거의 항상 WSL 의 NAT 모드다: `172.x` 사설망 안에 있어서 `hostname -I` 의
#: 주소로는 밖에서 못 닿는다.  여기서 문서로만 넘기면 안 된다 (§0.3: 계측기가
#: 아는 것을 사람에게 다시 묻지 않는다) — 우리는 그 `172.x` 를 알고 있고,
#: 사람이 손으로 옮겨 적어야 하는 값이 정확히 그것이다.
#:
#: 화면 전체에 규칙 하나를 건다: **들여쓴 초록 줄은 그대로 붙여넣는 명령,
#: `│` 로 시작하는 줄은 파일에 들어갈 내용.**  이 구분이 없어서 파일 내용을
#: PowerShell 에 붙여넣는 일이 실제로 일어났다.
nat_hint() {
  local nat="${1:-}"
  say ""
  say "  ${B}두 가지 길이 있습니다.${OFF}"
  say "  ${DIM}들여쓴 줄은 그대로 붙여넣는 명령이고, │ 로 시작하는 줄은 파일 내용입니다.${OFF}"
  say ""
  say "  ${B}A. mirrored 모드${OFF} ${DIM}(권장 — 한 번만 하면 끝)${OFF}"
  say "     ${DIM}WSL 이 Windows 의 주소를 그대로 씁니다. 포워딩도, 재시작마다 다시 하는 일도 없습니다.${OFF}"
  say "     ${DIM}창을 옮길 것 없이 여기서:${OFF}"
  say "       ${GREEN}bml mirrored${OFF}"
  say "     ${DIM}Windows 쪽 %USERPROFILE%\\.wslconfig 를 찾아 고치고, 그다음 할 일을 이어서 찍습니다.${OFF}"
  say "     ${DIM}(고치는 것은 이 두 줄뿐입니다 — 명령이 아니라 파일 내용입니다:)${OFF}"
  file_line "[wsl2]"
  file_line "networkingMode=mirrored"
  say "     ${DIM}Windows 11 22H2 미만이면 mirrored 는 오류 없이 무시됩니다. 그때는 B 로 갑니다.${OFF}"
  say ""
  say "  ${B}B. NAT 그대로 두고 포워딩${OFF} ${DIM}(WSL 을 재시작하면 다시 해야 합니다)${OFF}"
  if [ -n "$nat" ]; then
    say "     ${DIM}관리자 PowerShell — 아래를 그대로 붙여넣으면 됩니다:${OFF}"
    say "       ${GREEN}netsh interface portproxy add v4tov4 listenport=${PORT} listenaddress=0.0.0.0 connectport=${PORT} connectaddress=${nat}${OFF}"
  else
    say "     ${DIM}관리자 PowerShell. 먼저${OFF} ${GREEN}wsl hostname -I${OFF} ${DIM}로 172.x 를 확인하고,${OFF}"
    say "     ${DIM}아래의${OFF} <그 172.x> ${DIM}를 그 값으로 바꿔서 붙여넣습니다 — 자리표시자를 그대로 두면 '구문이 올바르지 않습니다' 가 납니다:${OFF}"
    say "       ${GREEN}netsh interface portproxy add v4tov4 listenport=${PORT} listenaddress=0.0.0.0 connectport=${PORT} connectaddress=<그 172.x>${OFF}"
  fi
  say ""
  say "  ${B}둘 중 어느 쪽이든 방화벽은 한 번 열어야 합니다${OFF} ${DIM}(관리자 PowerShell, 1회):${OFF}"
  say "     ${GREEN}New-NetFirewallRule -DisplayName \"BML ${PORT}\" -Direction Inbound -LocalPort ${PORT} -Protocol TCP -Action Allow${OFF}"
  say ""
  # 어느 쪽 길을 가든 다른 기계가 칠 주소는 Windows 쪽 IPv4 다.  우리가 읽을 수
  # 있으면 읽어서 그대로 준다 — 사람이 ipconfig 출력에서 골라 적는 자리가
  # 정확히 틀리는 자리다 (게이트웨이·마스크·172.x 가 나란히 있다).
  local lan; lan="$(windows_lan_address)"
  if [ -n "$lan" ]; then
    say "  ${B}어느 쪽이든, 다른 기계가 칠 주소는 이것입니다${OFF} ${DIM}(이 PC 의 Windows 쪽 IPv4):${OFF}"
    say "     ${GREEN}bml use ${lan}${OFF}   ${DIM}← 노트북에서${OFF}"
    say "  ${DIM}브라우저로만 볼 거면${OFF} ${GREEN}http://${lan}:${PORT}${OFF}"
  else
    # 왜 못 읽었는지까지 말한다.  "직접 찾아 적으세요" 만 남으면, 우리가 읽어
    # 주기로 한 값이 왜 안 나왔는지 아무도 모른다.
    # 셋을 갈라야 한다.  대처가 전부 다르다:
    #   못 불렀다      → interop 문제.  주소를 아무리 봐도 안 나온다.
    #   불렀는데 빈손  → 랜선·Wi-Fi 가 안 붙었다.
    #   있는데 다 뺐다 → 우리 판정이 틀렸을 수 있다.  본 것을 보여 준다.
    local ipc="" seen=""
    if ipc="$(windows_ipconfig)"; then seen="$(windows_ipv4_by_adapter "$ipc")"; fi
    if [ -z "$ipc" ]; then
      say "  ${DIM}이 WSL 에서 Windows 프로그램을 부르지 못해 (interop) 주소를 대신 읽지 못했습니다.${OFF}"
      say "  ${GREEN}bml doctor${OFF} ${DIM}가 원인과 고치는 명령까지 짚어 줍니다 (systemd 가 지운 binfmt 등록이 흔한 원인입니다).${OFF}"
    elif [ -z "$seen" ]; then
      say "  ${DIM}ipconfig 에 IPv4 가 하나도 없습니다 — 랜선·Wi-Fi 가 붙어 있나요?${OFF}"
    else
      say "  ${DIM}이 PC 의 LAN 주소를 읽어 봤지만 쓸 만한 것이 없었습니다. 본 것은 이렇습니다:${OFF}"
      printf '%s\n' "$seen" | while IFS="$(printf '\t')" read -r nic ip; do
        file_line "$(printf '%-34s %s' "$nic" "$ip")"
      done
      say "  ${DIM}이 중에 다른 기계가 칠 주소가 보이는데 우리가 빼 버렸다면 알려 주세요 — 판정을 고칩니다.${OFF}"
    fi
    say "  ${DIM}Windows 쪽에서${OFF} ${GREEN}ipconfig${OFF} ${DIM}의 IPv4 를 보고, 노트북에서${OFF} ${GREEN}bml use <그 IPv4>${OFF} ${DIM}를 씁니다.${OFF}"
    # "172. 는 WSL 것" 이라고 뭉뚱그리면 안 된다 (Codex 리뷰 8번).  랩 망이
    # 172.16-31 대역을 쓰는 곳이 있고(이 데스크톱이 그렇다), 그러면 유일하게
    # 맞는 주소를 버리게 된다.  버릴 것은 대역이 아니라 **그 어댑터**다.
    say "  ${DIM}(${OFF}${GREEN}vEthernet (WSL)${OFF}${DIM} 어댑터에 붙은 주소만 빼면 됩니다 — 대역으로 고르지 마세요.)${OFF}"
  fi
  say "  ${DIM}자세히는 docs/guides/central-server.md.${OFF}"
}

#: `bml mirrored` — WSL 을 mirrored 네트워크로 바꾼다.
#:
#: 왜 명령으로 만들었나.  이 안내를 읽는 사람은 **WSL 터미널 앞에 앉아 있다.**
#: 그런데 고쳐야 하는 파일은 Windows 쪽에 있어서, 여태 화면은 "PowerShell 을
#: 열고 이걸 붙여넣으세요" 였다.  창을 옮기는 순간 붙여넣기가 어긋나고 — 실제로
#: 파일 두 줄을 PowerShell 에 붙여넣어 "용어가 ... 인식되지 않습니다" 를 봤다 —
#: 무엇보다 우리는 그 파일이 어디 있는지 **알 수 있다**.  §0.3 그대로다.
#:
#: 여기서 바꾸는 것은 이 저장소 바깥의 파일이다.  그래서 셋을 지킨다:
#:   1. 어디를 고칠 것인지 **먼저 화면에 적고** 고친다.
#:   2. 고치기 전 파일을 `.bml-bak` 로 남긴다.
#:   3. 경로가 확실하지 않으면 아무것도 안 하고 PowerShell 한 줄을 준다 (§0.4).
cmd_mirrored() {
  step "WSL 네트워크를 mirrored 로"
  is_wsl || die "여기는 WSL 이 아닙니다 — mirrored 는 Windows 의 WSL 설정입니다."

  # **짐작한 경로에는 쓰지 않는다** (Codex 리뷰 1번).  interop 으로 Windows 가
  # 스스로 말한 %USERPROFILE% 일 때만 고친다.  못 물어봤으면 남의 폴더를 고칠
  # 수 있으므로, 짐작은 화면에 '아마 여기' 로만 보여 주고 손은 사람이 댄다.
  local home f guess
  home="$(windows_home_verified)"
  if [ -z "$home" ]; then
    warn "지금 로그인한 Windows 사용자를 확인하지 못했습니다 — 짐작으로 파일을 고치지 않습니다."
    say "  ${DIM}(이 WSL 에서 Windows 프로그램을 부르지 못했습니다.${OFF} ${GREEN}bml doctor${OFF} ${DIM}가 그 이유를 짚어 줍니다.)${OFF}"
    guess="$(windows_home_candidate)"
    [ -n "$guess" ] && say "  ${DIM}폴더는 아마 여기입니다 —${OFF} ${B}${guess}/.wslconfig${OFF} ${DIM}(확인은 사람 몫입니다)${OFF}"
    say ""
    say "  ${DIM}PowerShell 에 이 한 줄을 붙여넣으면 Windows 자신이 자기 경로에 씁니다:${OFF}"
    say "    ${GREEN}$(wslconfig_mirror_command)${OFF}"
    return 1
  fi
  f="$home/.wslconfig"
  say "대상        ${B}${f}${OFF}  ${DIM}(Windows 가 말한 %USERPROFILE%)${OFF}"

  local why
  if ! why="$(wslconfig_writable_reason "$f")"; then
    warn "이 파일은 건드리지 않습니다 — ${why}."
    say "  ${DIM}무엇을 고치게 될지 확실하지 않으면 고치지 않습니다. 직접 확인해 주세요:${OFF}"
    say "    ${GREEN}ls -l \"$f\"${OFF}"
    return 1
  fi

  # 이미 되어 있으면 **백업도 만들지 않는다** (Codex 리뷰 5번).  예전에는
  # 먼저 백업을 뜨고 나중에 지웠는데, 두 번째 실행이 '이미 mirrored 인 파일' 로
  # 첫 실행의 NAT 원본 백업을 덮어써 버렸다 — 되돌릴 것이 사라졌다.
  if wslconfig_is_mirrored "$f"; then
    ok "이미 mirrored 입니다 — 손대지 않았습니다."
  else
    local bak="$f.bml-bak"
    if [ -e "$f" ]; then
      if [ -e "$bak" ]; then
        # 남의(또는 예전의) 백업을 덮지 않는다.  그것이 되돌릴 유일한 원본일 수
        # 있다.  다만 **그것이 실제로 되돌릴 수 있는 것인지**는 봐야 한다
        # (Codex 2차 리뷰 4번): 빈 파일이나 폴더를 그 이름으로 만들어 두면
        # "백업이 있습니다" 라고 한 뒤 원본을 고쳤다 — 되돌릴 것이 없는 채로.
        if [ ! -f "$bak" ] || [ ! -r "$bak" ] || [ ! -s "$bak" ]; then
          warn "백업 자리가 쓸 수 없는 것입니다 — 고치지 않았습니다: $bak"
          say "  ${DIM}보통 파일이 아니거나, 비어 있거나, 읽을 수 없습니다. 치우거나 다른 곳으로 옮긴 뒤 다시 하세요.${OFF}"
          return 1
        fi
        say "  ${DIM}백업이 이미 있습니다 — 그대로 둡니다: ${bak}${OFF}"
      elif cp -p "$f" "$bak" 2>/dev/null && cmp -s "$f" "$bak"; then
        say "  ${DIM}고치기 전 파일을 ${bak} 에 두었습니다.${OFF}"
      else
        rm -f "$bak" 2>/dev/null
        warn "백업을 만들지 못해 고치지 않았습니다: $bak"
        say "  ${DIM}되돌릴 것이 없는 채로 남의 설정 파일을 고치지 않습니다.${OFF}"
        return 1
      fi
    fi
    wslconfig_set_mirrored "$f"
    case "$?" in
      0) ok "고쳤습니다." ;;
      1) ok "이미 mirrored 입니다 — 손대지 않았습니다." ;;
      *) warn "쓰지 못했습니다: $f"
         say "  ${DIM}그 파일이 Windows 쪽에서 열려 있거나 권한이 막힌 경우입니다."
         say "  PowerShell 에 이 한 줄을 붙여넣으면 같은 일을 합니다:${OFF}"
         say "    ${GREEN}$(wslconfig_mirror_command)${OFF}"
         return 1
         ;;
    esac
  fi

  say ""
  say "  ${DIM}지금 파일 내용:${OFF}"
  if [ -r "$f" ]; then
    while IFS= read -r l; do file_line "$(printf '%s' "$l" | tr -d '\r')"; done < "$f"
  else
    say "  ${DIM}(읽지 못했습니다)${OFF}"
  fi

  say ""
  say "  ${B}다음 — 이 터미널에서${OFF}"
  # appendWindowsPath=false 인 기계에서는 맨 이름이 안 먹는다 (Codex 리뷰 13번).
  local wslexe; wslexe="$(win_exe wsl.exe)" || wslexe=""
  if [ -n "$wslexe" ]; then
    say "    ${GREEN}${wslexe} --shutdown${OFF}"
  else
    say "    ${DIM}이 터미널에서는 wsl.exe 를 부를 수 없습니다 — Windows PowerShell 에서:${OFF}"
    say "    ${GREEN}wsl --shutdown${OFF}"
  fi
  say "     ${DIM}WSL 전체가 내려갑니다. 이 터미널도 닫힙니다 (다른 창에서 돌던 것도요).${OFF}"
  say "     ${DIM}그다음 WSL 터미널을 새로 열고${OFF} ${GREEN}bml${OFF} ${DIM}→${OFF} ${GREEN}bml status${OFF}"
  say ""
  say "  ${DIM}방화벽을 아직 안 열었다면 관리자 PowerShell 에서 한 번 (권한이 필요해 여기서는 못 합니다):${OFF}"
  say "    ${GREEN}New-NetFirewallRule -DisplayName \"BML ${PORT}\" -Direction Inbound -LocalPort ${PORT} -Protocol TCP -Action Allow${OFF}"
  say ""
  say "  ${DIM}Windows 11 22H2 미만이면 mirrored 는 오류 없이 무시됩니다. 재시작 후에도${OFF}"
  say "  ${DIM}${GREEN}bml status${OFF} ${DIM}가 주소를 못 찾으면 그 경우이니, 화면의 B(netsh)로 갑니다.${OFF}"
}

#: 그 주소에 우리 워크벤치가 살아 있는가.  server_state 와 달리 임의의 주소를
#: 받는다 — 아직 저장하지 않은 후보를 확인해야 하기 때문이다.
#: 두 번째 인자는 기다릴 초.
#:
#: 코드를 그대로 돌려주는 쪽을 따로 둔다.  "응답이 없습니다" 는 세 가지를 한
#: 덩어리로 만든다 — 못 닿음(000), 터널이 끊김(530), 엉뚱한 서버(404).
#: 대처가 전혀 다른데 화면에서는 구분이 안 된다.
http_code_of() {
  local code
  code="$(curl -s -o /dev/null -m "${2:-4}" -w '%{http_code}' "$1/api/health" 2>/dev/null)"
  printf '%s' "$(printf '%s' "$code" | tr -dc '0-9' | tail -c 3)"
}

server_alive() {
  [ "$(http_code_of "$1" "${2:-4}")" = "200" ]
}

#: 열릴 때까지 <초> 만큼 기다린다.
#:
#: **횟수가 아니라 시간으로 센다.**  아직 안 붙은 터널은 Cloudflare 가 530 을
#: 곧바로 돌려주므로 한 번 시도가 1초도 안 걸린다 — 횟수로 세면 "다섯 번
#: 해 봤다" 가 실제로는 7초고, 준비 중인 터널을 우리가 먼저 죽인다.  실제로
#: 그렇게 했다: 로그에 남은 것은 막힌 포트가 아니라 우리가 보낸 SIGTERM 이었다.
#: 세 번째 인자로 pid 를 주면 그 프로그램이 살아 있는 동안만 기다린다.
#: ssh 가 "remote port forwarding failed" 로 3초 만에 끝나도 우리는 남은 57초를
#: 죽은 주소에 대고 물어보게 되는데, 화면에는 그저 "느리다" 로 보인다.
wait_until_alive() {
  local url="$1" limit="${2:-45}" pid="${3:-}" start=$SECONDS
  while :; do
    server_alive "$url" 8 && return 0
    if [ -n "$pid" ] && ! process_alive "$pid"; then
      return 1
    fi
    [ $((SECONDS - start)) -ge "$limit" ] && return 1
    sleep 3
  done
}

#: 그 pid 가 아직 일하고 있는가.
#:
#: `kill -0` 만으로는 부족하다.  터널은 `disown` 한 자식이라 끝나도 우리가
#: 거두지 않아 **좀비로 남고, 좀비에게도 `kill -0` 은 성공한다** — 그러면 이미
#: 죽은 터널을 상한까지 기다리게 되고, 화면에는 "느리다" 로만 보인다.
#: `/proc/<pid>/stat` 의 상태 글자를 본다.  comm 에 괄호·공백이 들어갈 수
#: 있으므로 마지막 `)` 뒤부터 자른다.
process_alive() {
  local pid="$1" state=""
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [ -r "/proc/$pid/stat" ]; then
    state="$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f1)"
  else
    state="$(ps -p "$pid" -o state= 2>/dev/null | tr -d ' ' | cut -c1)"
  fi
  [ "$state" = "Z" ] && return 1
  return 0
}

#: 밖으로 나가는 7844/TCP 가 열려 있는가.
#:
#: cloudflared 는 QUIC 이든 http2 든 **이 포트로** 엣지에 붙는다.  443 이
#: 열려 있어도 7844 가 막히면 터널은 안 된다 — 그런데 그때도 주소는 발급되고
#: 로그에는 "dial tcp ...:7844" 만 남아서, 포트 문제인지 아닌지가 안 보인다.
edge_port_open() {
  timeout 8 bash -c 'exec 3<>/dev/tcp/region1.v2.argotunnel.com/7844' 2>/dev/null
}

#: 000 은 어느 층에서 끊겼는지를 말해 주지 않는다.  한 층씩 짚어서 그것을 낸다.
#:
#:   dns   이름을 못 찾는다 — 터널이 닫혔거나 DNS 가 막혔다
#:   tcp   이름은 찾는데 443 에 못 붙는다 — 이 망이 나가는 길을 막는다
#:   tls   443 에는 붙는데 손을 잡다가 끊긴다 (curl: SSL_ERROR_SYSCALL).
#:         **중간 장비가 SNI 의 도메인을 보고 끊는 신호다.**  이때 그 주소는
#:         다른 망에서 멀쩡히 열린다 — 여기서 터널을 닫으면 안 된다.  7844 를
#:         막는 망이 처음 보는 터널 도메인도 같이 막는 일이 흔해서, 실제로
#:         이렇게 됐다 (lhr.life, 2026-08-22).
#:   open  거기까지 됐다 — 000 이 아니라 HTTP 코드가 나왔어야 한다
#:
#: 도구가 없으면 그 층은 건너뛴다.  없는 것을 "막혔다" 로 읽으면 안 된다.
#: 주소에서 호스트만.  셸에 넘길 것이므로 글자를 좁혀서 돌려준다 —
#: 못 쓸 모양이면 빈 값과 1.
url_host() {
  local h="${1:-}"; h="${h#*://}"
  # **authority 를 먼저 끊는다** — `/`·`?`·`#` 중 가장 먼저 오는 것까지가
  # 호스트 자리다.  이 순서를 뒤집으면 `https://custom.example#@x.lhr.life` 의
  # 호스트를 `x.lhr.life` 로 읽는다 (Codex 2차 리뷰 13번): 실제로는
  # custom.example 로 가는데 우리는 남의 도메인을 우리 터널로 판정하게 된다.
  h="${h%%/*}"; h="${h%%\?*}"; h="${h%%#*}"
  # 그 안에서만 userinfo 를 뗀다.  `https://u:p@real.example/` 에서 `u` 가
  # 나오면 curl 은 real.example 로 가는데 우리는 u 를 진단한다.
  case "$h" in *@*) h="${h##*@}" ;; esac
  h="${h%%:*}"
  case "$h" in
    ''|-*|.*|*..*|*.) return 1 ;;
    *[!A-Za-z0-9.-]*) return 1 ;;
  esac
  printf '%s' "$h"
}

#: 공용 DNS 가 준 JSON 을 낱말 하나로.  RFC 8484 의 JSON 형식(Cloudflare)이다.
#:
#: 확실한 신호가 있을 때만 단정한다: 답이 실려 있으면 exists, `Status:3`
#: (NXDOMAIN)이면 missing, 나머지는 전부 unknown 이다.  틀리게 단정하면
#: 살아 있는 터널을 닫거나, 죽은 터널을 기다리게 만든다 (§0.4).
dns_public_json_verdict() {
  local out="${1:-}"
  [ -n "$out" ] || { printf 'unknown'; return; }
  # 없는 이름이라고 **응답한** 경우만 missing 이다.
  case "$out" in *'"Status":3'*|*'"Status": 3'*) printf 'missing'; return ;; esac
  # Status 가 0 이 아니면 답이 아니다 (2 = SERVFAIL 등).  예전에는 "Answer" 라는
  # 글자만 보고 exists 로 셌는데, `{"Status":2,"Answer":[]}` 가 그렇게 통과했다.
  case "$out" in *'"Status":0'*|*'"Status": 0'*) ;; *) printf 'unknown'; return ;; esac
  # Status 0 이어도 Answer 가 비어 있으면 주소가 없는 것이다.
  case "$out" in
    *'"Answer":[]'*|*'"Answer": []'*) printf 'unknown'; return ;;
    *'"Answer"'*)                     printf 'exists';  return ;;
  esac
  printf 'unknown'
}

#: 물어볼 공용 resolver 들.  `평문DNS주소|DoH주소` 꼴이고, 위에서부터 쓴다.
#:
#: **하나로는 모자란다.**  1.1.1.1 하나만 물어보던 때, 실측 학교망에서 셋이
#: 다 실패했다 -- 평문 53 은 막히고(흔하다), DoH 도 안 갔다.  1.1.1.1 은 사설
#: 게이트웨이 대역과 부딪히거나 아예 차단되는 망이 있어서, "공용 DNS 가 막힌
#: 망" 이 아니라 "이 한 곳이 막힌 망" 인 경우가 많다.  그런데 화면에는 전자로
#: 나왔고, 사람은 고칠 수 있는 것을 못 고쳤다.
#:
#: 셋 다 IP 로 적는다 -- 이름으로 적으면 그것부터 이 기계의 resolver 를 탄다.
DNS_PROVIDERS="1.1.1.1|https://1.1.1.1/dns-query
8.8.8.8|https://8.8.8.8/resolve
9.9.9.9|https://9.9.9.9:5053/dns-query"

#: 이 기계의 resolver 를 **일부러 건너뛰고** 공용 DNS 에 직접 물어본다.
#: 'exists' | 'missing' | 'unknown'.
#:
#: **이것으로 아는 것은 "이 기계의 DNS 가 막는가" 하나뿐이다.**  터널이 살아
#: 있는지는 알 수 없다 — `lhr.life` 는 와일드카드라 없는 이름도 같은 IP 로
#: 잡힌다 (`getent hosts <아무거나>.lhr.life` 로 확인했다).  그래서 exists 를
#: "터널이 살아 있다" 로 읽어서는 안 된다.  `trycloudflare.com` 처럼
#: 와일드카드가 아닌 도메인에서만 missing 이 의미를 가진다.
#:
#: 이름이 안 잡히는 데에는 두 가지 이유가 있고 대처가 정반대다: 터널이 닫혔거나,
#: 이 망의 DNS 가 그 도메인을 거르거나.  화면에서는 똑같이 "응답하지 않습니다"
#: 로 보인다.  랩 망은 터널 도메인을 거르는 일이 흔해서, 여기서 안 가르면
#: 사람은 멀쩡한 터널을 닫고 다시 열기를 반복한다.
dns_public_state() {
  local host="${1:-}" out plain doh verdict
  [ -n "$host" ] || { printf 'unknown'; return; }
  while IFS='|' read -r plain doh; do
    [ -n "$plain" ] || continue
    if command -v nslookup >/dev/null 2>&1; then
      out="$(nslookup "$host" "$plain" 2>/dev/null)"
      case "$out" in
        *NXDOMAIN*|*"can't find"*) printf 'missing'; return ;;
        *Name:*)                   printf 'exists';  return ;;
      esac
    fi
    # dig 는 실패와 NXDOMAIN 이 똑같이 빈 줄이라, 있다는 쪽으로만 쓴다.
    if command -v dig >/dev/null 2>&1; then
      out="$(dig +short +time=4 +tries=1 @"$plain" "$host" A 2>/dev/null)"
      [ -n "$out" ] && { printf 'exists'; return; }
    fi
    # dnsutils 가 없는 기계가 흔하다 (WSL 기본 설치에 없다).  curl 은 있으므로
    # DNS-over-HTTPS 로 묻는다 — 주소가 IP 라 이 기계의 resolver 를 안 탄다.
    out="$(curl -sS -m 6 -H 'accept: application/dns-json' \
           "${doh}?name=${host}&type=A" 2>/dev/null)"
    verdict="$(dns_public_json_verdict "$out")"
    [ "$verdict" = "unknown" ] || { printf '%s' "$verdict"; return; }
  done <<EOF
$DNS_PROVIDERS
EOF
  printf 'unknown'
}

#: 공용 DNS 가 준 A 레코드 하나 (IPv4).  못 얻으면 빈 문자열.
#:
#: `dns_public_state` 와 따로 두는 이유는 쓰임이 다르기 때문이다.  저쪽은
#: "이 망이 막는가" 만 알면 되지만, 이쪽은 **그 주소로 실제로 찔러 보려고**
#: IP 를 원한다.  이름을 못 쓰는 기계에서 터널이 살아 있는지 아는 유일한 길이다.
dns_public_ip() {
  local host="${1:-}" out plain doh
  [ -n "$host" ] || return 0
  while IFS='|' read -r plain doh; do
    [ -n "$plain" ] || continue
    if command -v dig >/dev/null 2>&1; then
      out="$(dig +short +time=4 +tries=1 @"$plain" "$host" A 2>/dev/null \
             | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1)"
      [ -n "$out" ] && { printf '%s' "$out"; return 0; }
    fi
    if command -v nslookup >/dev/null 2>&1; then
      # 첫 두 줄은 물어본 서버 자신의 주소다 -- 그것을 집으면 resolver 를 찌른다.
      out="$(nslookup "$host" "$plain" 2>/dev/null | sed -n '/^Name:/,$p' \
             | sed -n 's/^Address: *\([0-9.]*\)$/\1/p' | head -n 1)"
      [ -n "$out" ] && { printf '%s' "$out"; return 0; }
    fi
    # dnsutils 가 없는 기계가 흔하다.  curl 은 있으므로 DNS-over-HTTPS 로.
    out="$(curl -sS -m 6 -H 'accept: application/dns-json' \
           "${doh}?name=${host}&type=A" 2>/dev/null)"
    out="$(printf '%s' "$out" | tr ',{}' '\n\n\n' \
           | sed -n 's/.*"data":"\([0-9][0-9.]*\)".*/\1/p' | head -n 1)"
    [ -n "$out" ] && { printf '%s' "$out"; return 0; }
  done <<EOF
$DNS_PROVIDERS
EOF
  return 0
}

#: 이름을 건너뛰고 **IP 로 직접** 워크벤치인지 물어본다.  HTTP 코드를 낸다.
#:
#: `curl --resolve` 는 이 기계의 resolver 를 통째로 건너뛰므로, DNS 만 막힌
#: 망에서도 진짜 답이 나온다.  이것이 있기 전에는 "이름이 잡히는 것과 터널이
#: 살아 있는 것은 다릅니다 -- 휴대폰으로 열어 봐야 압니다" 까지가 끝이었다.
#: 사람에게 다른 기계를 꺼내라고 하기 전에, 여기서 알 수 있는 것은 여기서 안다.
tunnel_probe_by_ip() {
  local url="$1" ip="$2" host port
  host="$(url_host "$url")" || { printf '000'; return; }
  case "$url" in https://*) port=443 ;; *) port=80 ;; esac
  curl -sS -o /dev/null -m 12 --resolve "${host}:${port}:${ip}" \
    -w '%{http_code}' "$url/api/health" 2>/dev/null || printf '000'
}

tunnel_block_layer() {
  local host
  host="$(url_host "${1:-}")" || { printf 'unknown'; return; }
  if command -v getent >/dev/null 2>&1; then
    getent hosts "$host" >/dev/null 2>&1 || { printf 'dns'; return; }
  fi
  if command -v timeout >/dev/null 2>&1; then
    timeout 8 bash -c "exec 3<>/dev/tcp/$host/443" 2>/dev/null || { printf 'tcp'; return; }
  else
    printf 'unknown'; return
  fi
  printf 'tls'
}

#: 그 층이 무슨 뜻이고 다음에 뭘 해야 하는지.
#:
#: 두 번째 인자는 **터널 프로그램이 살아 있는가**.  이것을 알면 `dns` 의 뜻이
#: 달라진다: 이름이 안 잡히는 것은 터널이 닫혔다는 뜻일 수도, 이 기계의 DNS 가
#: 그 도메인을 거른다는 뜻일 수도 있는데, 우리 ssh 가 붙어 있고 주소를 받아
#: 왔다면 앞쪽은 아니다.  "이미 닫혔거나" 를 그대로 두면 사람은 멀쩡한 터널을
#: 닫고 처음부터 다시 한다 — 실제로 그 화면이 "터널은 살아 있는데" 라는 제목
#: 바로 밑에 찍혔다.
block_layer_meaning() {
  local alive="${2:-}"
  case "$1" in
    dns) if [ -n "$alive" ]; then
           printf '이름을 못 찾습니다 — 터널 프로그램은 살아 있으니, 이 기계의 DNS 가 그 도메인을 거르는 쪽이 유력합니다 (랩 DNS 가 터널 도메인을 막는 일이 흔합니다)'
         else
           printf '이름을 못 찾습니다 — 터널이 이미 닫혔거나 DNS 가 막혔습니다'
         fi ;;
    tcp) printf '443 에 붙지 못합니다 — 이 망이 나가는 길을 막습니다' ;;
    tls) printf '443 에 TCP 는 붙는데 그 뒤가 안 끝납니다 — 이 망의 장비가 끊는 것으로 보입니다 (TLS 손잡기 자체를 확인한 것은 아닙니다). 다른 망에서는 열릴 수 있습니다' ;;
    *)   printf '어디서 끊겼는지 짚지 못했습니다' ;;
  esac
}

#: 왜 안 닿았는지 curl 이 아는 것을 그대로 보여 준다.
#: "이름을 못 찾음"(주소 오타·터널 닫힘)과 "연결 거절"(방화벽)과 404(주소는
#: 맞지만 우리 서버가 아님)는 대처가 전혀 다른데, "응답하지 않습니다" 만으로는
#: 셋을 구분할 수 없다.
explain_unreachable() {
  local url="$1"
  say "  ${DIM}curl 이 말한 것:${OFF}"
  curl -sS -o /dev/null -m 8 -w '    HTTP %{http_code}  (%{time_total}s)\n' \
    "$url/api/health" 2>&1 | sed 's/^/    /'
}

#: 확인에 실패했을 때 그 HTTP 코드가 무슨 뜻인지 한 줄로.
#:
#: "응답하지 않습니다" 는 대처가 전혀 다른 셋을 한 덩어리로 만든다 —
#: **이 기계가 그 주소로 못 나간 것**(000: DNS·방화벽·TLS 가로채기)과,
#: **터널이 아직 우리 서버에 못 붙은 것**(5xx)과, **엉뚱한 서버**(404)다.
#: 특히 000 은 상대 쪽에서는 멀쩡히 열려 있을 수 있다 — 7844 를 막는 망은
#: 처음 보는 도메인도 함께 막는 일이 흔하다.  그때 주소를 버리면 안 된다.
tunnel_code_meaning() {
  case "${1:-000}" in
    200)    printf 'HTTP 200 — 열렸습니다' ;;
    000|'') printf 'HTTP 000 — 이 기계가 그 주소로 나가지 못했습니다 (DNS·방화벽·TLS 가로채기). 상대 쪽에서는 열려 있을 수 있습니다' ;;
    404)    printf 'HTTP 404 — 주소는 닿는데 우리 서버가 아닙니다' ;;
    429)    printf 'HTTP 429 — 터널 제공자가 잠시 막았습니다 (무료 터널의 사용량 제한)' ;;
    502|503|504|530)
            printf 'HTTP %s — 터널 제공자가 뒤에서 아무 응답도 못 받았습니다 (터널이 끊겼거나, 그 뒤의 서버가 안 떠 있거나)' "$1" ;;
    5*)     printf 'HTTP %s — 터널이 아직 우리 서버에 붙지 못했습니다' "$1" ;;
    *)      printf 'HTTP %s' "$1" ;;
  esac
}

#: `.bml/env` 의 한 줄을 고쳐 쓴다.  빈 값이면 그 줄을 지운다.
#: 손으로 적어 둔 다른 줄(WORKBENCH_DATA 등)은 그대로 남긴다.
#: 저장에 실패했을 때 한 곳에서 말한다.  부르는 쪽마다 다르게 적으면 어떤
#: 경로로 실패했는지에 따라 안내가 달라지는데, 사람이 할 일은 하나다.
env_write_failed() {
  printf '%s✕%s 설정을 저장하지 못했습니다: %s\n' "$RED" "$OFF" "$REPO/.bml/env" >&2
  say "  ${DIM}권한이나 남은 공간을 확인하세요:${OFF}"
  say "    ${GREEN}ls -ld \"$REPO/.bml\" \"$REPO/.bml/env\"${OFF}"
  say "  ${DIM}아무것도 바뀌지 않았습니다 — 예전 설정이 그대로입니다.${OFF}"
}

write_env_key() {
  local key="$1" value="$2" file="$REPO/.bml/env" tmp rc
  #: **실패를 삼키지 않는다.**  예전에는 어느 단계가 실패해도 조용히 넘어가서,
  #: 부르는 쪽이 "암호를 저장했습니다" 를 출력하고 0 으로 끝났다.  사용자는
  #: 보호됐다고 믿는데 서버에는 옛 암호(또는 무암호)가 그대로 남았다.
  if ! need_run_dir 2>/dev/null; then return 1; fi

  # 같은 폴더에 만든다.  /tmp 에 만들면 파일시스템이 달라 mv 가 복사가 되고,
  # 그 사이에 설정 파일이 없는 순간이 생긴다.
  tmp="$RUN_DIR/env.$$"
  if ! : > "$tmp" 2>/dev/null; then return 1; fi

  # 이 파일에는 공유 암호가 들어간다.  실험실 공용 PC 의 기본 umask 로는
  # 누구나 읽을 수 있는 파일이 되므로, 권한을 못 걸면 **저장하지 않는다** —
  # 누구나 읽는 암호는 없는 암호보다 나쁘다 (있다고 믿게 되므로).
  if ! chmod 600 "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi

  if [ -f "$file" ]; then
    grep -v "^[[:space:]]*${key}[[:space:]]*=" "$file" >> "$tmp" 2>/dev/null
    rc=$?
    # grep 은 남은 줄이 하나도 없으면 1 을 낸다 — 그것은 실패가 아니다.
    # 2 이상만 읽기 오류다.  여기서 그냥 진행하면 새 key 하나만 든 파일이
    # 원본을 갈아치워 WORKBENCH_DATA·기존 암호가 통째로 사라진다.
    if [ "$rc" -ge 2 ]; then rm -f "$tmp"; return 1; fi
  fi

  if [ -n "$value" ]; then
    if ! printf '%s=%s\n' "$key" "$value" >> "$tmp" 2>/dev/null; then
      rm -f "$tmp"; return 1
    fi
  fi
  if ! mv "$tmp" "$file" 2>/dev/null; then rm -f "$tmp"; return 1; fi
  return 0
}

#: 안 닿을 때 무엇을 볼지.  WSL 은 NAT 뒤에 있어서, 중추 서버 안에서 본
#: `hostname -I` 주소로는 다른 기계에서 닿지 않는다 — 그 PC 의 Windows 쪽
#: 주소로 접속하고, Windows 가 WSL 로 넘겨 주어야 한다.
#: 이 주소가 **우리가 여는 터널**의 것인가.
#:
#: 예전에는 `https://` 면 전부 터널로 봤다 (Codex 리뷰 12번).  그러면
#: `bml use https://typo.example.invalid` 같은 오타에도 "bml share stop 후 다시
#: bml share" 를 시킨다 — 열지도 않은 터널을 닫으라는 말이다.  우리가 쓰는
#: 제공자의 도메인만 그 절차로 보낸다.
is_our_tunnel_url() {
  local h; h="$(url_host "${1:-}")" || return 1
  case "$h" in
    *.lhr.life|*.localhost.run|*.trycloudflare.com) return 0 ;;
  esac
  return 1
}

server_unreachable_help() {
  local url="$1"
  say ""

  # 터널 주소는 방화벽도 포트 포워딩도 상관이 없다.  LAN 안내를 그대로 주면
  # 아무 소용 없는 것을 확인하느라 시간을 쓴다.
  if is_our_tunnel_url "$url"; then
      # 코드가 무엇을 말하는지 먼저 읽는다.  **502·503·530 은 짐작이 아니라
      # 확정 신호다**: 이름도 잡히고 TLS 도 됐는데 제공자가 "뒤에서 아무 응답도
      # 못 받았다" 고 답한 것이다.  그때 아래 점검표를 훑게 하면 안 되는 일에
      # 시간을 쓴다.
      local hc; hc="$(http_code_of "$url" 8)"
      case "$hc" in
        502|503|504|530)
          # 여기서는 curl 의 첫 대답을 찍지 않는다.  두 번 물어보면 답이 다를 수
          # 있고 (실제로 `HTTP 000` 바로 밑에 `(HTTP 503)` 이 나란히 찍혔다),
          # 그러면 화면이 스스로 모순된다.  확정 코드가 있으면 그것이 답이다.
          #
          # **다만 그 코드가 가르는 것은 여기까지다.**  제공자가 뒤에서 응답을
          # 못 받았다는 것만 확정이고, 터널이 끊긴 것인지 그 뒤의 서버가 안 떠
          # 있는 것인지는 이 코드로 알 수 없다 — 둘 다 503 이다.
          #
          # 예전에는 "터널이 끊긴 것입니다" 라고 단정하고 다시 열게 시켰다.
          # 서버가 내려간 경우에는 그것이 **주소만 새로 바꾸고 같은 화면을
          # 다시 보여 주는 절차**다 (실측 2026-08-24: 방금 연 터널이 503 이었고,
          # 끊긴 것은 터널이 아니라 서버였다.  그 전 실측에서는 정말 터널이
          # 끊겨 있었다 — 그래서 화면이 둘을 갈라 줄 수 없다).
          #
          # 그래서 **값싼 확인을 먼저** 시킨다.  status 는 아무것도 안 바꾸고,
          # 터널을 다시 여는 것은 주소를 잃는다.
          warn "터널 주소는 닿는데 그 뒤에서 응답이 없습니다 (HTTP ${hc})."
          say "  ${DIM}터널이 끊겼거나, 그 뒤의 서버가 안 떠 있습니다 — 이 코드로는 구분되지 않습니다.${OFF}"
          say "  ${B}중추 서버에서${OFF} ${GREEN}bml status${OFF} ${DIM}— 그 화면의 두 줄이 답을 가릅니다.${OFF}"
          say "    ${B}'실행 중' 이 없다${OFF}       ${DIM}서버가 내려갔습니다.${OFF} ${GREEN}bml${OFF} ${DIM}로 띄웁니다.${OFF}"
          say "                          ${DIM}터널은 그대로라 주소도 그대로입니다.${OFF}"
          say "    ${B}'공유 주소' 가 없다${OFF}   ${DIM}터널이 죽었습니다.${OFF} ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF}"
          say "                          ${DIM}주소가 바뀌므로 여기서${OFF} ${GREEN}bmlout <새 주소>${OFF} ${DIM}를 다시 칩니다.${OFF}"
          say ""
          say "  ${DIM}지금 이 기계만의 데이터로 띄우려면${OFF}  ${GREEN}bml use off${OFF} ${DIM}후${OFF} ${GREEN}bml${OFF}"
          return 0
          ;;
        404)
          warn "그 주소에 닿기는 하는데 우리 워크벤치가 아닙니다 (HTTP 404)."
          say "  ${DIM}터널이 다른 서비스로 이어졌거나 주소를 잘못 적었습니다.${OFF}"
          say "  ${DIM}중추 서버의${OFF} ${GREEN}bml status${OFF} ${DIM}의 '공유 주소' 줄을 그대로 씁니다.${OFF}"
          return 0
          ;;
      esac
      # 확정이 아니면 그때 curl 이 뭐라 했는지를 보여 준다.
      explain_unreachable "$url"
      say ""
      # 이름 자체가 안 잡히면, 아래 목록을 훑기 전에 **갈라 준다.**  터널이
      # 닫힌 것과 이 망의 DNS 가 그 도메인을 거르는 것은 화면에서 똑같은데
      # 대처가 정반대다 — 뒤쪽인데 앞쪽으로 알면 멀쩡한 터널을 닫고 다시 열기를
      # 반복하게 된다 (랩 망이 터널 도메인을 거르는 일은 흔하다).
      local uhost=""
      uhost="$(url_host "$url" 2>/dev/null)" || uhost=""
      if [ -n "$uhost" ] && command -v getent >/dev/null 2>&1 \
         && ! getent hosts "$uhost" >/dev/null 2>&1; then
        say "  ${B}이름 자체를 못 찾았습니다.${OFF} ${DIM}공용 DNS 에 직접 물어봅니다 (이 기계의 DNS 를 건너뜁니다)...${OFF}"
        case "$(dns_public_state "$uhost")" in
          exists)
            # 여기서 말할 수 있는 것은 **이 망의 DNS 가 막는다** 까지다.
            # 이름이 잡힌다고 터널이 살아 있다는 뜻은 아니다 — lhr.life 는
            # 와일드카드라 아무 이름이나 같은 IP 로 잡힌다 (실측으로 확인).
            # 그 둘을 뭉뚱그리면 죽은 터널을 기다리게 만든다.
            say "  ${B}→ 공용 DNS 에서는 잡힙니다 — 이 망의 DNS 가 막는 것입니다.${OFF}"
            # 여기서 멈추지 않는다.  IP 를 얻었으면 이름을 건너뛰고 직접
            # 찔러 볼 수 있고, 그러면 "터널이 살아 있는가" 까지 **여기서**
            # 답이 난다 -- 사람에게 휴대폰을 꺼내라고 하기 전에.
            local tip="" tcode=""
            tip="$(dns_public_ip "$uhost")"
            if [ -n "$tip" ]; then
              say "    ${DIM}이름을 건너뛰고 그 주소(${tip})로 직접 물어봅니다...${OFF}"
              tcode="$(tunnel_probe_by_ip "$url" "$tip")"
            fi
            case "$tcode" in
              200)
                say "  ${B}→ 터널은 살아 있습니다.${OFF} ${DIM}막는 것은 이 기계의 DNS 하나뿐입니다.${OFF}"
                say "    ${DIM}브라우저도 같은 DNS 를 쓰므로, 그대로는 이 기계에서 열리지 않습니다. 셋 중 하나입니다:${OFF}"
                say "    ${DIM}1.${OFF} ${B}같은 랩 안이면 터널 말고 LAN 주소${OFF} ${DIM}— 중추 서버의${OFF} ${GREEN}bml status${OFF} ${DIM}의 '접속 주소' 줄. 가장 빠릅니다.${OFF}"
                say "    ${DIM}2. 휴대폰 테더링으로 바꿉니다.${OFF}"
                # 손으로 hosts 를 고치는 절차를 여기 적어 두지 않는다.  세
                # 단계(공용 DNS → hosts → 다시 붙기)를 사람이 순서대로 치게
                # 하면 한 단계씩 빠뜨리고, 터널 주소가 바뀔 때마다 처음부터
                # 다시다.  그 셋을 하는 명령이 따로 있다 (`cmd_only`).
                say "    ${DIM}3.${OFF} ${B}이 기계에서 그대로 보려면${OFF} ${DIM}— 아래 한 줄이 셋을 다 합니다${OFF}"
                say "       ${DIM}(공용 DNS 로 주소 → 살아 있는지 확인 → /etc/hosts 에 이름표 → 접속):${OFF}"
                say "       ${GREEN}bmlonly ${url}${OFF}   ${DIM}— sudo 를 한 번 묻습니다${OFF}"
                say ""
                return 0
                ;;
              000|'')
                if [ -n "$tip" ]; then
                  say "  ${B}→ 그 주소로도 못 나갑니다.${OFF} ${DIM}DNS 만이 아니라 나가는 길 자체가 막혔거나, 터널이 닫혔습니다.${OFF}"
                  say "    ${DIM}둘을 가르려면 휴대폰(모바일 데이터)으로 그 주소를 열어 보세요.${OFF}"
                fi
                ;;
              *)
                say "  ${B}→ 그 주소는 닿는데 우리 서버가 아닙니다:${OFF} ${DIM}$(tunnel_code_meaning "$tcode")${OFF}"
                say "    ${DIM}중추 서버의${OFF} ${GREEN}bml status${OFF} ${DIM}의 '공유 주소' 줄을 그대로 씁니다.${OFF}"
                say ""
                return 0
                ;;
            esac
            say "    ${DIM}같은 랩 안이라면 터널 말고 LAN 주소를 쓰세요 — 중추 서버의${OFF} ${GREEN}bml status${OFF} ${DIM}의 '접속 주소' 줄.${OFF}"
            say "    ${DIM}밖에서 봐야 한다면 휴대폰 테더링으로 바꿉니다. (이 기계의 DNS 를 1.1.1.1 로 바꾸는 것은${OFF}"
            say "    ${DIM}권하지 않습니다 — 이런 망은 바깥 53 번도 막는 일이 많아, 그러면 DNS 가 통째로 죽습니다.)${OFF}"
            say ""
            return 0
            ;;
          missing)
            say "  ${B}→ 그 이름은 없습니다 — 터널이 닫혔습니다.${OFF}"
            say "    ${DIM}중추 서버에서${OFF} ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF}${DIM}, 새로 나온 주소를 씁니다.${OFF}"
            say ""
            return 0
            ;;
          *)
            say "  ${DIM}→ 공용 DNS 에도 못 물어봤습니다 (이 망이 그것마저 막습니다).${OFF}"
            say "    ${DIM}휴대폰(모바일 데이터)으로 그 주소를 열어 보면 갈립니다 — 열리면 이 망 문제입니다.${OFF}"
            say ""
            ;;
        esac
      fi
      say "  ${B}터널 주소일 때 확인할 것${OFF}"
      say "    1. ${DIM}중추 서버에서${OFF} ${GREEN}bml share${OFF} ${DIM}창이 아직 켜져 있는가 (닫으면 주소가 죽습니다)${OFF}"
      say "    2. ${DIM}그 창에 지금 떠 있는 주소와 같은가 — 주소가 바뀔 수 있습니다${OFF}"
      say "    3. ${DIM}방금 열었다면 몇 초 더 기다렸다 다시${OFF} ${GREEN}bml use $url${OFF}"
      say ""
      say "  ${DIM}중추 서버에서 직접 확인해 보면 어디가 문제인지 갈립니다:${OFF}"
      say "    ${GREEN}curl -sS -m 15 $url/api/health${OFF}"
      say "    ${DIM}거기서도 안 되면 터널 문제, 되면 이 기계의 네트워크 문제입니다.${OFF}"
      say ""
      # 두 기계가 같은 망에 있으면 위의 확인이 갈라 주지 못한다 — 둘 다 같은
      # DNS·같은 방화벽을 쓰므로 똑같이 실패한다.  망 밖에서 한 번 찔러 보는
      # 것만이 그 경우를 가른다.  랩 망은 터널 도메인을 막는 일이 흔하다.
      say "  ${B}두 기계가 같은 망이면 위의 확인으로는 안 갈립니다${OFF} ${DIM}— 같은 DNS·같은 방화벽입니다.${OFF}"
      say "  ${DIM}휴대폰의 Wi-Fi 를${OFF} ${B}끄고${OFF} ${DIM}모바일 데이터로 그 주소를 열어 보세요. 그것이 진짜 '밖' 입니다:${OFF}"
      say "    ${DIM}열리면${OFF}   터널은 정상이고 ${B}이 망이 막는 것${OFF}${DIM}입니다. 같은 랩 안이라면 터널 말고 LAN 주소를 쓰세요.${OFF}"
      say "    ${DIM}안 열리면${OFF} 중추 서버에서 ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF}${DIM}.${OFF}"
      say ""
      say "  ${DIM}지금 이 기계만의 데이터로 띄우려면${OFF}  ${GREEN}bml use off${OFF} ${DIM}후${OFF} ${GREEN}bml${OFF}"
      return 0
  fi

  explain_unreachable "$url"
  say ""
  say "  ${B}중추 서버 쪽에서 순서대로${OFF}"
  say "    1. 떠 있는가          ${GREEN}bml status${OFF} ${DIM}— '실행 중' 이어야 합니다${OFF}"
  say "    2. 주소가 맞는가       ${DIM}같은 화면의${OFF} ${GREEN}접속 주소${OFF} ${DIM}줄을 그대로 씁니다${OFF}"
  say "    3. 네트워크에 열었는가  ${DIM}.bml/env 에${OFF} ${GREEN}WORKBENCH_HOST=0.0.0.0${OFF}"
  say "    4. 방화벽              ${DIM}그 PC 의${OFF} ${B}관리자${OFF} ${DIM}PowerShell (Win+X → 터미널(관리자))${OFF}"
  say "       ${GREEN}New-NetFirewallRule -DisplayName \"BML ${PORT}\" -Direction Inbound -LocalPort ${PORT} -Protocol TCP -Action Allow${OFF}"
  say ""
  say "  ${DIM}여기까지 해도 안 되면 그 WSL 이 NAT 모드라 Windows 가 포트를 넘겨 줘야${OFF}"
  say "  ${DIM}합니다. 두 기계가 다른 망에 있으면 LAN 주소로는 애초에 못 닿습니다 —${OFF}"
  say "  ${DIM}둘 다 docs/guides/central-server.md 의 '주소' 절에 있습니다.${OFF}"
  say ""
  say "  ${DIM}지금 이 기계만의 데이터로 띄우려면${OFF}  ${GREEN}bml use off${OFF} ${DIM}후${OFF} ${GREEN}bml${OFF}"
  say "  ${DIM}(현재 설정: ${url})${OFF}"
}

#: 글자 수.  `${#var}` 는 로케일을 탄다 — C 로케일에서는 바이트를 세므로
#: 한글 두 글자가 여섯 글자로 통과한다.  UTF-8 의 이어지는 바이트(0x80-0xBF)를
#: 지우면 글자당 한 바이트만 남고, 그것은 로케일과 무관하다.
count_chars() {
  printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

#: cloudflared 가 뱉는 여러 줄에서 주소만 꺼낸다.
#:
#: 주소를 못 꺼내면 터널은 떠 있는데 아무도 못 들어온다 — 그 상태가 제일
#: 나쁘다. 열려 있다고 믿고 끄지 않기 때문이다.
tunnel_url_from() {
  # 도메인을 한정한다.  localhost.run 은 접속 안내에 admin.localhost.run 도 같이
  # 찍는데, 그것을 주소로 알려 주면 상대는 남의 관리 페이지를 연다.
  printf '%s' "$1" \
    | grep -oE 'https://[a-z0-9][a-z0-9-]*\.(trycloudflare\.com|lhr\.life)' \
    | head -1
}

#: 터널 프로그램의 경로.  ensure_cloudflared 가 채운다.
CLOUDFLARED=""

#: 터널 프로그램을 준비한다.  경로는 찍지 않고 CLOUDFLARED 에 넣는다.
#:
#: 값을 stdout 으로 돌려주면 호출부가 `$(...)` 로 받게 되는데, 그러면 두 가지가
#: 한꺼번에 깨진다.  진행 표시("받는 중")가 사람 눈이 아니라 그 변수로 들어가고,
#: `die` 의 exit 이 서브셸만 끝내서 스크립트는 빈 경로를 들고 계속 간다.
#: 실제로 그렇게 됐다 — 화면에는 아무 설명 없이 "터널 주소를 받지 못했습니다"
#: 만 떴다.
ensure_cloudflared() {
  local own="$RUN_DIR/bin/cloudflared" arch url
  if command -v cloudflared >/dev/null 2>&1; then
    CLOUDFLARED="$(command -v cloudflared)"
    return 0
  fi
  if [ -x "$own" ]; then CLOUDFLARED="$own"; return 0; fi

  case "$(uname -m)" in
    x86_64|amd64)  arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) die "이 CPU($(uname -m))용 터널 프로그램을 모릅니다.
   ${DIM}https://github.com/cloudflare/cloudflared/releases 에서 직접 받아 PATH 에 두세요.${OFF}" ;;
  esac
  url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$arch"
  mkdir -p "$RUN_DIR/bin"
  step "터널 프로그램을 받는 중 (cloudflared, 처음 한 번 · 약 35 MB)"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -o "$own.part" "$url" || die "받지 못했습니다: $url"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --show-progress -O "$own.part" "$url" || die "받지 못했습니다: $url"
  else
    die "curl 이나 wget 이 필요합니다."
  fi
  chmod +x "$own.part" && mv "$own.part" "$own"
  ok "받았습니다 (${own})"
  CLOUDFLARED="$own"
}

#: 바깥에 열 때 쓸 공유 암호.  값은 절대 다시 찍지 않는다 — 터미널 기록과
#: 스크롤백에 남고, 사람들은 그 화면을 스크린샷으로 보낸다.
cmd_password() {
  local given="${1:-}"

  if [ -z "$given" ]; then
    if [ -n "${WORKBENCH_PASSWORD:-}" ]; then
      ok "공유 암호가 설정돼 있습니다.  ${DIM}($REPO/.bml/env)${OFF}"
      say "  ${DIM}바꾸려면${OFF} ${GREEN}bml password <새 암호>${OFF}${DIM}, 없애려면${OFF} ${GREEN}bml password off${OFF}"
    else
      say "${DIM}공유 암호가 없습니다 — 랩 안에서 쓸 때는 이대로가 맞습니다.${OFF}"
      say "  ${DIM}바깥에 열려면(bml share) 먼저${OFF} ${GREEN}bml password <암호>${OFF}"
    fi
    return 0
  fi

  case "$given" in
    off|none|해제)
      if ! write_env_key WORKBENCH_PASSWORD ""; then env_write_failed; return 1; fi
      ok "공유 암호를 없앴습니다."
      warn "떠 있는 서버에는 아직 걸려 있습니다 — ${GREEN}bml restart${OFF} ${DIM}로 반영됩니다.${OFF}"
      return 0
      ;;
  esac

  # 짧은 암호는 터널 주소가 인터넷에 있는 동안 통째로 시도된다.
  if [ "$(count_chars "$given")" -lt 6 ]; then
    die "너무 짧습니다 (6자 이상).  주소가 인터넷에 있는 동안에는 이것 하나가 전부입니다."
  fi
  # `.bml/env` 는 한 줄이 한 설정이다.  줄바꿈이 든 암호는 파일을 두 줄로
  # 쪼개서 저장되고, 그러면 사용자가 아는 암호로는 영영 안 열린다.
  case "$given" in
    *=*) die "암호에 '=' 는 쓸 수 없습니다 (.bml/env 가 KEY=VALUE 라서 잘립니다)." ;;
    *$'\n'*|*$'\r'*|*$'\t'*) die "암호에 줄바꿈이나 탭은 쓸 수 없습니다." ;;
  esac

  if ! write_env_key WORKBENCH_PASSWORD "$given"; then env_write_failed; return 1; fi
  ok "공유 암호를 저장했습니다.  ${DIM}($REPO/.bml/env — git 에 올라가지 않습니다)${OFF}"
  warn "떠 있는 서버는 아직 옛 설정입니다 — ${GREEN}bml restart${OFF} ${DIM}로 반영됩니다.${OFF}"
}

#: 커밋 제목에서 `fix:` 같은 접두사를 떼고 본문만 낸다.
#:
#: 커밋과 `docs/log.md` 를 짝지으려면 둘의 제목이 같아야 한다.  이 저장소는
#: 커밋을 `fix: <제목>` 으로, log.md 를 `## [날짜] fix | <제목>` 으로 쓴다 —
#: 접두사만 떼면 같은 문자열이 된다.  같게 쓰기로 정한 이유가 이것이다.
commit_subject_body() {
  local subject="$1"
  # 접두사는 SCHEMA.md 의 어휘와 CLAUDE.md §2 의 커밋 prefix 를 합친 것이다.
  printf '%s' "${subject#* }" | sed 's/^[[:space:]]*//'
  return 0
}

#: 커밋 제목에 해당하는 `docs/log.md` 항목이 있는가.
#:
#: 제목이 아니라 `| <제목>` 으로 찾는다.  본문에 같은 문장이 우연히 있어도
#: 항목 제목이 아니면 기록으로 치지 않는다 — "적었다" 를 잘못 세면, 이 검사가
#: 있으나 마나 해진다.
log_has_entry() {
  local subject="$1" file="${2:-$REPO/docs/log.md}" body
  [ -f "$file" ] || return 1
  case "$subject" in
    *:*) body="$(commit_subject_body "$subject")" ;;
    *)   body="$subject" ;;
  esac
  [ -n "$body" ] || return 1
  grep -qF "| $body" "$file"
}

#: 이 명령줄이 우리가 띄운 터널의 것인가.
#:
#: PID 는 재사용된다.  낡은 tunnel.pid 가 가리키는 번호를 그 사이 남의
#: 프로세스가 물려받았을 수 있는데, close_tunnel 은 프로세스 그룹째 죽인다 —
#: 남의 실험을 죽이는 길이다 (CLAUDE.md §0.8).  포트 쪽(classify_process)과
#: 같은 원칙으로, 정체를 설명할 수 없으면 죽이지 않는다.
#:
#: 프로세스 없이 시험할 수 있게 명령줄만 받는다.
looks_like_our_tunnel() {
  case "$1" in
    *cloudflared*--url*"$URL"*) return 0 ;;
    *ssh*-R*"80:localhost:$PORT"*localhost.run*) return 0 ;;
    # 되살리는 감독자.  `$RUN_DIR` 아래의 우리 파일 경로라 남의 것과 겹치지
    # 않는다 -- 이것이 없으면 `bml status` 가 살아 있는 터널을 못 보고,
    # `close_tunnel` 은 "우리 것이 아니다" 며 안 닫는다.
    *"$RUN_DIR/tunnel-keepalive.sh"*) return 0 ;;
    *) return 1 ;;
  esac
}

owns_tunnel_pid() {
  local pid="$1" cmd
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
  [ -n "$cmd" ] || cmd="$(ps -p "$pid" -o args= 2>/dev/null)"
  [ -n "$cmd" ] || return 1
  looks_like_our_tunnel "$cmd"
}

tunnel_running() {
  local pid
  pid="$(cat "$TUNNEL_PID_FILE" 2>/dev/null)" || return 1
  owns_tunnel_pid "$pid"
}

tunnel_url() { cat "$TUNNEL_URL_FILE" 2>/dev/null; }

#: 터널을 닫는다.  `bml stop` 도 이걸 부른다 — 서버 없이 남은 터널은 남에게
#: Cloudflare 오류 화면(1033)을 띄우는 주소일 뿐이고, 그 화면은 "닫혔다" 가
#: 아니라 "고장 났다" 로 읽힌다.
close_tunnel() {
  local pid
  pid="$(cat "$TUNNEL_PID_FILE" 2>/dev/null)"
  if owns_tunnel_pid "$pid"; then
    kill "$pid" 2>/dev/null
    kill -- "-$pid" 2>/dev/null
    rm -f "$TUNNEL_PID_FILE" "$TUNNEL_URL_FILE"
    return 0
  fi
  # 우리 것이 아니면 건드리지 않는다.  표식만 지운다 — 낡은 파일을 남겨 두면
  # 다음 `bml share` 가 "이미 열려 있습니다" 로 끝난다.
  rm -f "$TUNNEL_PID_FILE" "$TUNNEL_URL_FILE"
  return 1
}

#: 터널 하나를 띄우고, 그 주소가 실제로 열릴 때까지 기다린다.
#:
#: 성공하면 TUNNEL_PID_FILE·TUNNEL_URL_FILE 을 채우고 0.  실패하면 띄운 것을
#: 닫고 1 — 반쯤 열린 터널을 남겨 두면 다음 시도가 "이미 열려 있습니다" 로
#: 끝난다.
#: 돌려주는 값
#:   0  열렸다
#:   1  주소조차 못 받았다 (띄운 것은 닫았다)
#:   2  터널은 살아 있는데 여기서 확인이 안 됐다.  첫 인자가 1 이면 **닫지 않고**
#:      남긴다 — 마지막 시도에서는 남기는 쪽이 낫다.  터널이 준비되는 데 우리
#:      상한보다 오래 걸렸을 수도 있고, 이 기계만 그 주소로 못 나가는 것일 수도
#:      있다 (상대는 열려 있다).  죽여 놓고 "안 됐습니다" 만 하면 아무것도 모른다.
#:   3  주소는 받았는데 터널 프로그램이 끝났다.  이 주소는 살아날 일이 없으므로
#:      keep 과 무관하게 닫는다 — 죽은 주소를 "열어 둡니다" 로 내보내면, 그것을
#:      받은 사람이 오류 화면을 보고 서버를 의심한다.
#: 어느 쪽이든 마지막으로 본 HTTP 코드를 `tunnel.last-code` 에 적어 둔다.
try_tunnel() {
  local keep="$1"; shift
  local label="$1"; shift
  local log="$RUN_DIR/tunnel.log" url="" pid i
  : > "$log"
  step "$label"
  # 이 창에 매달아 두지 않는다.  창을 닫거나 Ctrl-C 를 누르면 터널이 죽고,
  # 그 주소를 받은 사람은 오류 화면을 본다 — 실제로 그렇게 됐다.  닫는 것은
  # `bml share stop` 이 한다.
  nohup "$@" >>"$log" 2>&1 </dev/null &
  pid=$!
  echo "$pid" > "$TUNNEL_PID_FILE"
  disown "$pid" 2>/dev/null || true

  for i in $(seq 1 60); do
    url="$(tunnel_url_from "$(cat "$log" 2>/dev/null)")"
    [ -n "$url" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  if [ -z "$url" ]; then
    close_tunnel >/dev/null 2>&1 || true
    return 1
  fi

  printf '%s' "$url" > "$TUNNEL_URL_FILE"
  # 실패해도 남긴다 — 무엇이 안 열렸는지 사람이 손으로 찔러 볼 수 있어야 한다.
  printf '%s' "$url" > "$RUN_DIR/tunnel.last-url"
  # 주소를 받은 것과 그 주소가 열린 것은 다르다.  확인하는 비용이, "열렸다" 를
  # 믿고 상대에게 알려 줬다가 되돌아오는 왕복 한 번보다 훨씬 싸다.
  step "주소가 실제로 열렸는지 확인 중 ${DIM}(최대 1분)${OFF}"
  if wait_until_alive "$url" 60 "$pid"; then
    rm -f "$RUN_DIR/tunnel.last-code" "$RUN_DIR/tunnel.last-layer"
    return 0
  fi
  # 1분을 이미 물어봤으면서 화면에서는 "확인해 보세요" 로 끝나면 안 된다.
  # 우리가 본 것을 적어 둔다.
  local code
  code="$(http_code_of "$url" 8)"
  printf '%s' "$code" > "$RUN_DIR/tunnel.last-code"
  # 000 일 때만 한 층 더 판다.  코드가 나왔다면 이미 거기까지 간 것이다.
  rm -f "$RUN_DIR/tunnel.last-layer"
  [ "${code:-000}" = "000" ] && tunnel_block_layer "$url" > "$RUN_DIR/tunnel.last-layer"
  if ! owns_tunnel_pid "$pid"; then
    close_tunnel >/dev/null 2>&1 || true
    return 3
  fi
  [ "$keep" = "1" ] && return 2
  close_tunnel >/dev/null 2>&1 || true
  return 2
}

tunnel_via_cloudflare() {
  local keep="${1:-0}"
  ensure_cloudflared
  [ -x "$CLOUDFLARED" ] || return 1
  try_tunnel 0 "터널 여는 중 ${DIM}(Cloudflare)${OFF}" \
    "$CLOUDFLARED" tunnel --no-autoupdate --url "$URL" && return 0
  # QUIC(UDP)만 막힌 망이 있다.  http2 도 같은 7844 를 쓰지만 TCP 다.
  try_tunnel "$keep" "다시 여는 중 ${DIM}(Cloudflare · http2)${OFF}" \
    "$CLOUDFLARED" tunnel --no-autoupdate --protocol http2 --url "$URL"
}

#: SSH 한 줄이 전부다 — 받을 것도, 계정도 없다.
#:
#: 7844 가 막힌 망에서 유일하게 남는 길이다.  `nokey@` 는 키 없이 붙으라는
#: localhost.run 의 사용자 이름이고, StrictHostKeyChecking=accept-new 가 없으면
#: 첫 접속의 "계속할까요?" 에서 조용히 멈춘다 — nohup 이라 그 물음도 안 보인다.
#: 등록한 키가 있으면 그것으로 붙는다 (`.bml/env` 의 `WORKBENCH_TUNNEL_KEY`).
#:
#: localhost.run 은 **등록하지 않은 키를 거부한다** (`Permission denied
#: (publickey)` -- 실측). 무료 계정에 공개키를 올리면 그때부터 "더 오래 가는
#: 도메인 이름" 을 주는데, 그것이 이 랩의 진짜 문제를 푼다: 주소가 매번 바뀌면
#: 받는 쪽이 그때마다 `/etc/hosts` 를 다시 박아야 한다 (`bmlonly`).
#:
#: 키가 없으면 `nokey@` 그대로다.  등록 전에 키를 강제하면 그때부터 `bml share`
#: 가 Permission denied 로 죽으므로, **설정한 사람만** 이 길을 탄다.
tunnel_ssh_key() {
  local key="${WORKBENCH_TUNNEL_KEY:-}"
  [ -n "$key" ] || return 1
  case "$key" in "~/"*) key="$HOME/${key#\~/}" ;; esac
  [ -r "$key" ] || return 1
  printf '%s' "$key"
}

#: 끊기면 다시 붙는 감독자를 한 장 써 둔다.  경로를 돌려준다.
#:
#: **등록한 키가 있을 때만 뜻이 있다.**  `nokey@` 는 붙을 때마다 새 이름을
#: 받으므로, 되살아나면 주소가 바뀌어서 받는 쪽은 어차피 다시 쳐야 한다 --
#: 그러면 "스스로 낫는다" 가 아니라 "조용히 딴 데를 가리킨다" 가 된다.
#:
#: 파일로 쓰는 이유: 한 줄짜리 `bash -c` 로 밀어 넣으면 따옴표가 겹겹이 되고,
#: 무엇이 도는지 사람이 볼 수 없다.  `cat` 한 번이면 읽히는 편이 낫다.
write_tunnel_keepalive() {
  local key="$1" path="$RUN_DIR/tunnel-keepalive.sh"
  cat > "$path" <<KEEPALIVE
#!/usr/bin/env bash
# bml 이 만든 파일입니다 -- 고치지 마세요.  \`bml share\` 가 다시 씁니다.
# 끊기면 다시 붙습니다.  등록한 키라 주소는 그대로입니다.
child=""
trap 'kill "\$child" 2>/dev/null; exit 0' TERM INT
quick=0
while :; do
  started=\$SECONDS
  ssh -T -i $(shquote "$key") -o IdentitiesOnly=yes \\
      -o StrictHostKeyChecking=accept-new \\
      -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \\
      -o ExitOnForwardFailure=yes \\
      -R 80:localhost:$PORT localhost.run &
  child=\$!
  wait "\$child"
  # 붙자마자 죽는 것이 이어지면 고칠 수 있는 문제가 아니다 (키가 지워졌거나,
  # 계정이 막혔거나).  무한히 두드리지 않고 멈춘다 -- 로그에 이유가 남는다.
  if [ \$(( SECONDS - started )) -lt 5 ]; then
    quick=\$(( quick + 1 ))
    [ "\$quick" -ge 20 ] && { echo "bml: 계속 곧바로 끊겨서 멈춥니다"; exit 1; }
  else
    quick=0
  fi
  sleep 5
done
KEEPALIVE
  chmod +x "$path" 2>/dev/null || true
  printf '%s' "$path"
}

tunnel_via_ssh() {
  local keep="${1:-0}" key label
  if ! command -v ssh >/dev/null 2>&1; then
    warn "ssh 가 없습니다 — SSH 터널을 쓸 수 없습니다."
    return 1
  fi
  if key="$(tunnel_ssh_key)"; then
    # 등록한 키는 주소가 그대로이므로 되살려도 뜻이 있다 (위를 보라).
    label="터널 여는 중 ${DIM}(localhost.run · 등록한 키 · 끊기면 다시 붙음)${OFF}"
    try_tunnel "$keep" "$label" bash "$(write_tunnel_keepalive "$key")"
    return
  fi
  try_tunnel "$keep" "터널 여는 중 ${DIM}(localhost.run · SSH)${OFF}" \
    ssh -T \
      -o StrictHostKeyChecking=accept-new \
      -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
      -o ExitOnForwardFailure=yes \
      -R "80:localhost:$PORT" nokey@localhost.run
}

#: `bml share key <경로>` — 어느 키로 붙을지 적어 둔다.
#:
#: 등록은 사람이 하는 일이라 (localhost.run 계정에 공개키를 올린다), 여기서는
#: **경로가 읽히는지만** 보고 등록 여부는 묻지 않는다.  안 된 채로 적어 두면
#: 다음 `bml share` 가 Permission denied 로 죽고 화면이 그렇게 말한다.
cmd_share_key() {
  local raw="${1:-}" key
  case "$raw" in
    '')
      if key="$(tunnel_ssh_key)"; then
        say "터널 키  ${B}${key}${OFF}   ${DIM}(.bml/env)${OFF}"
        say "  ${DIM}이 키의 공개키를 localhost.run 계정에 올려 두어야 합니다:${OFF}"
        say "    ${GREEN}cat ${key}.pub${OFF}  ${DIM}→ https://admin.localhost.run/${OFF}"
        say "  ${DIM}그 사이트가 이 망에서 안 열리면 (랩 망이 그 도메인을 통째로 끊습니다)${OFF}"
        say "  ${DIM}휴대폰 테더링으로 잠깐 바꿔서 하세요 — 가입은 한 번뿐이고, 그 뒤로는${OFF}"
        say "  ${DIM}터널만 열면 되므로 이 망에서 그대로 됩니다.${OFF}"
      else
        say "${DIM}터널 키가 없습니다 — 주소가 열 때마다 바뀝니다 (nokey).${OFF}"
        say "  ${GREEN}ssh-keygen -t ed25519 -N \"\" -f ~/.ssh/localhost_run -C 'bml tunnel'${OFF}"
        say "  ${GREEN}cat ~/.ssh/localhost_run.pub${OFF}  ${DIM}→ https://admin.localhost.run/ 에 등록${OFF}"
        say "  ${GREEN}bml share key ~/.ssh/localhost_run${OFF}"
      fi
      return 0
      ;;
    off|none|해제)
      if ! write_env_key WORKBENCH_TUNNEL_KEY ""; then env_write_failed; return 1; fi
      ok "터널 키를 지웠습니다 — 다시 nokey 로 붙습니다 (주소가 매번 바뀝니다)."
      return 0
      ;;
  esac
  key="$raw"
  case "$key" in "~/"*) key="$HOME/${key#\~/}" ;; esac
  [ -r "$key" ] || die "그 키를 읽지 못합니다: $key"
  if ! write_env_key WORKBENCH_TUNNEL_KEY "$key"; then env_write_failed; return 1; fi
  ok "터널 키 → ${B}${key}${OFF}"
  say "  ${DIM}공개키가 localhost.run 계정에 등록돼 있어야 합니다:${OFF}"
  say "    ${GREEN}cat ${key}.pub${OFF}  ${DIM}→ https://admin.localhost.run/${OFF}"
  say "  ${DIM}그 사이트가 안 열리면 휴대폰 테더링으로 — 가입은 한 번뿐입니다.${OFF}"
  say "  ${DIM}그다음${OFF} ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF}"
}

#: 다른 공유기에 있는 사람도 볼 수 있게 임시 터널을 연다 (ADR 0014).
#: 켜는 동안만 열린다.  잊고 꺼 두는 쪽이 잊고 열어 두는 쪽보다 낫다.
cmd_share() {
  case "${1:-}" in
    stop|off|close|down)
      if close_tunnel; then
        ok "터널을 닫았습니다 — 그 주소는 이제 안 열립니다."
      else
        say "${DIM}열려 있는 터널이 없습니다.${OFF}"
      fi
      return 0
      ;;
  esac

  # 이미 열려 있으면 새로 열지 않는다.  두 개를 열면 주소가 둘이 되고, 남에게
  # 알려 준 쪽이 어느 것인지 알 수 없게 된다.
  if tunnel_running && [ -n "$(tunnel_url)" ]; then
    ok "이미 열려 있습니다 → ${B}$(tunnel_url)${OFF}"
    say "  ${B}다른 기계에서${OFF}  ${GREEN}bml use $(tunnel_url)${OFF}"
    say "  ${DIM}닫으려면${OFF}  ${GREEN}bml share stop${OFF}"
    return 0
  fi
  close_tunnel >/dev/null 2>&1 || true

  if [ -z "${WORKBENCH_PASSWORD:-}" ]; then
    printf '%s✕%s 공유 암호가 없어서 열지 않습니다.\n' "$RED" "$OFF" >&2
    say "  ${DIM}이 주소는 인터넷에 있게 됩니다. 이 앱에는 로그인이 없어서, 주소를 아는${OFF}"
    say "  ${DIM}사람은 전부 읽고 전부 지울 수 있습니다 (ADR 0014).${OFF}"
    say ""
    say "  ${GREEN}bml password <암호>${OFF} ${DIM}후${OFF} ${GREEN}bml restart${OFF} ${DIM}후 다시${OFF} ${GREEN}bml share${OFF}"
    exit 1
  fi

  if ! server_state; then
    die "서버가 안 떠 있습니다 — 먼저 ${GREEN}bml${OFF} 로 띄우세요."
  fi

  # 설정 파일에 암호가 있는 것과 떠 있는 서버가 그것을 들고 있는 것은 다르다.
  # 암호를 적어 두고 restart 를 안 한 채 터널을 열면, 문이 없는 워크벤치가
  # 인터넷에 뜬다.  실제로 닫혀 있는지 확인하고서야 연다.
  local code
  code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "$URL/api/samples" 2>/dev/null)"
  code="$(printf '%s' "$code" | tr -dc '0-9' | tail -c 3)"
  if [ "$code" != "401" ]; then
    printf '%s✕%s 떠 있는 서버에 암호가 안 걸려 있습니다 (/api/samples → %s).\n' \
      "$RED" "$OFF" "${code:-무응답}" >&2
    say "  ${DIM}.bml/env 에 적기 전에 띄운 서버입니다.${OFF}"
    say "  ${GREEN}bml restart${OFF} ${DIM}후 다시${OFF} ${GREEN}bml share${OFF}"
    exit 1
  fi
  # 401 은 문이 있다는 뜻일 뿐이다.  **그 문이 지금 적어 둔 암호의 것인지**를
  # 실제로 두드려 확인한다 — 여기서 틀리면 남에게 안 맞는 암호를 알려 주고
  # 주소만 인터넷에 남는다.
  if ! door_password_works "$URL" "${WORKBENCH_PASSWORD:-}"; then
    printf '%s✕%s 떠 있는 서버가 지금 적어 둔 암호를 안 씁니다.\n' "$RED" "$OFF" >&2
    say "  ${DIM}암호를 바꾸고 서버를 다시 안 띄운 경우입니다 — 문은 옛 암호로 잠겨 있습니다.${OFF}"
    say "  ${GREEN}bml restart${OFF} ${DIM}후 다시${OFF} ${GREEN}bml share${OFF}"
    exit 1
  fi

  ensure_cloudflared
  [ -x "$CLOUDFLARED" ] || die "터널 프로그램을 준비하지 못했습니다."

  local url="" rc=1
  case "$TUNNEL" in
    ssh|localhost.run)      tunnel_via_ssh 1;        rc=$? ;;
    cloudflare|cloudflared) tunnel_via_cloudflare 1; rc=$? ;;
    *)
      # 7844/TCP 가 열려 있으면 Cloudflare 가 빠르고 안정적이다.  막혀 있으면
      # cloudflared 는 어떤 --protocol 로도 못 붙는다 (QUIC 도 http2 도 그
      # 포트를 쓴다) — 그때는 SSH 쪽이 유일한 길이다.  찔러 보고 고른다.
      step "밖으로 나가는 길 확인 중"
      if edge_port_open; then
        tunnel_via_cloudflare 0; rc=$?
      else
        say "  ${DIM}7844/TCP 가 막혀 있습니다 — SSH 터널을 씁니다.${OFF}"
      fi
      # SSH 가 마지막 시도다 — 확인이 안 돼도 남긴다.
      [ "$rc" -eq 0 ] || { tunnel_via_ssh 1; rc=$?; }
      ;;
  esac
  url="$(tunnel_url)"

  if [ "$rc" -ne 0 ] && [ -z "$url" ]; then
    printf '%s✕%s 터널을 열지 못했습니다.\n' "$RED" "$OFF" >&2
    say ""
    if [ "$rc" -eq 3 ]; then
      say "  ${DIM}주소는 받았지만 터널 프로그램이 곧 끝났습니다 — 죽은 주소라서 남기지 않았습니다.${OFF}"
      say ""
    fi
    # 빈 줄을 걸러서 보여 준다.  localhost.run 의 접속 배너는 빈 줄로 끝나서,
    # 그냥 tail 하면 화면에 빈 줄 열두 개만 찍힌다 — 실제로 그랬다.
    # 빈 줄을 걸러 냈더니 **아무것도 안 남는** 경우가 실제로 있었다 (배너만
    # 찍고 죽거나, 로그 자체가 안 생긴 경우).  그때 화면은 "마지막 줄:" 이라고
    # 해 놓고 침묵한다 — 사람은 자기 화면이 잘린 줄 안다.  없으면 없다고 한다.
    local tlog_lines
    tlog_lines="$(tr -d '\r' < "$RUN_DIR/tunnel.log" 2>/dev/null \
                  | grep -v '^[[:space:]]*$' | tail -n 14)"
    if [ -n "$tlog_lines" ]; then
      say "  ${DIM}$RUN_DIR/tunnel.log 의 마지막 줄:${OFF}"
      printf '%s\n' "$tlog_lines" | sed 's/^/    /'
    else
      say "  ${DIM}$RUN_DIR/tunnel.log 에 남은 말이 없습니다 — 터널 프로그램이 아무 말도 없이 끝났습니다.${OFF}"
      say "  ${DIM}같은 주소가 아직 저쪽에 잡혀 있으면 새 연결이 그대로 거절됩니다 (ExitOnForwardFailure).${OFF}"
      say "  ${DIM}1분쯤 뒤에 다시${OFF} ${GREEN}bml share${OFF} ${DIM}— 그래도 같으면${OFF} ${GREEN}WORKBENCH_TUNNEL=cloudflare bml share${OFF}"
    fi
    # 주소는 받았는데 안 열린 경우가 있다.  그 주소를 알려 줘야 손으로 찔러 볼
    # 수 있다.
    if [ -s "$RUN_DIR/tunnel.last-url" ]; then
      say ""
      say "  ${DIM}받았지만 응답하지 않은 주소:${OFF} $(cat "$RUN_DIR/tunnel.last-url")"
      say "  ${DIM}직접 확인:${OFF} ${GREEN}curl -sS -o /dev/null -w '%{http_code}\\n' $(cat "$RUN_DIR/tunnel.last-url")/api/health${OFF}"
    fi
    say ""
    say "  ${B}대안${OFF}  같은 공유기 안이라면 터널 없이 ${GREEN}bml status${OFF} ${DIM}의 '접속 주소'${OFF}"
    say "        휴대폰 테더링으로 잠깐 바꾸면 대개 열립니다"
    say "        ${GREEN}WORKBENCH_TUNNEL=ssh bml share${OFF}${DIM} 또는 ${OFF}${GREEN}=cloudflare${OFF} ${DIM}로 한쪽만 시켜 봅니다${OFF}"
    exit 1
  fi

  if [ "$rc" -eq 2 ]; then
    local code; code="$(cat "$RUN_DIR/tunnel.last-code" 2>/dev/null)"
    warn "터널은 살아 있는데, 여기서는 확인이 안 됐습니다 — 그래서 열어 둡니다."
    say "  ${B}${url}${OFF}"
    # **여기가 IP 가 제일 필요한 자리다.**  이 갈래로 오는 이유가 대개 "이
    # 기계의 DNS 가 그 도메인을 거른다" 이고, 그러면 받는 쪽도 같은 랩 망이라
    # 같은 벽에 부딪힌다.  성공 갈래에만 적어 두면 정작 필요할 때 없다.
    tunnel_ip_hint "$url"
    say ""
    say "  ${DIM}1분 동안 물어본 결과:${OFF}  $(tunnel_code_meaning "$code")"
    case "${code:-000}" in
      000|'')
        # 여기서 못 나가는 것과 터널이 안 붙은 것은 다르다.  7844 를 막는 망은
        # 처음 보는 도메인도 같이 막는 일이 흔해서, 정작 상대 쪽에서는 열린다.
        local layer; layer="$(cat "$RUN_DIR/tunnel.last-layer" 2>/dev/null)"
        # 이 분기의 제목이 이미 "터널은 살아 있는데" 다 — 그 사실을 넘겨 준다.
        say "  ${DIM}어디서 끊겼나:${OFF}        $(block_layer_meaning "$layer" 1)"
        say ""
        # dns 도 여기 넣는다.  이 분기는 우리가 방금 연 터널이고 ssh 가 주소를
        # 받아 왔다 — 그러면 이름이 안 잡히는 것은 터널이 닫혀서가 아니라 이
        # 기계의 DNS 가 그 도메인을 거르기 때문이다.  바로 위 줄에서 그렇게
        # 단정해 놓고 아래에서 "일 수 있습니다" 로 물러서면, 두 줄이 부딪히고
        # 사람은 약한 쪽을 믿어 멀쩡한 터널을 닫는다.
        case "$layer" in
          tls|tcp|dns)
            # 이 층에서 끊기는 것은 이 기계의 망이지 터널이 아니다.  단정해서
            # 말해 준다 — "일 수 있습니다" 로 흐리면 사람은 멀쩡한 터널을 닫고
            # 처음부터 다시 하는 데 시간을 쓴다.
            say "  ${B}터널 문제가 아닙니다 — 이 기계의 망이 막고 있습니다.${OFF}"
            say "  ${B}상대에게 이 주소를 그대로 주세요${OFF} ${DIM}(다른 망이면 열립니다):${OFF}"
            say "    ${GREEN}bml use ${url}${OFF} ${DIM}또는 브라우저로 그냥 엽니다${OFF}"
            say "  ${DIM}이 기계에서도 봐야 한다면 그냥${OFF} ${GREEN}http://localhost:${PORT}${OFF} ${DIM}를 씁니다 — 터널을 거칠 이유가 없습니다.${OFF}"
            ;;
          *)
            say "  ${B}먼저 상대에게 이 주소를 찔러 달라고 하세요${OFF} ${DIM}— 이 기계의 망 문제일 수 있습니다.${OFF}"
            say "    ${GREEN}bml use ${url}${OFF} ${DIM}또는 브라우저로 그냥 엽니다${OFF}"
            say "  ${DIM}상대도 안 되면${OFF} ${GREEN}bml share stop${OFF} ${DIM}후 다시${OFF} ${GREEN}bml share${OFF} ${DIM}— 주소가 바뀔 수 있습니다.${OFF}"
            ;;
        esac
        ;;
      *)
        say ""
        say "  ${DIM}터널이 붙는 중일 수 있습니다. 10초쯤 뒤${OFF} ${GREEN}bml status${OFF}"
        say "  ${DIM}의 '공유 주소' 줄에 경고가 없으면 그때 상대에게 알려 주면 됩니다.${OFF}"
        say "  ${DIM}계속 이러면${OFF} ${GREEN}bml share stop${OFF} ${DIM}후 다시${OFF} ${GREEN}bml share${OFF}"
        ;;
    esac
    say ""
    say "  ${DIM}닫으려면${OFF} ${GREEN}bml share stop${OFF}"
    exit 0
  fi

  ok "열렸습니다 → ${B}${url}${OFF}"
  say ""
  say "  ${B}다른 기계에서${OFF}  ${GREEN}bmlout ${url}${OFF}   ${DIM}(한 번만 — 그다음부터는${OFF} ${GREEN}bmlout${OFF}${DIM})${OFF}"
  say "  ${DIM}브라우저로만 볼 거라면 그 주소를 그대로 엽니다 — 암호를 한 번 묻습니다.${OFF}"
  tunnel_ip_hint "$url"
  say ""
  say "  ${DIM}이 창은 닫아도 됩니다. 닫으려면${OFF} ${GREEN}bml share stop${OFF}${DIM}, 주소는 열 때마다 바뀝니다.${OFF}"
}

#: 이 주소의 IP 를 한 줄로 — 받는 쪽 기계의 DNS 가 막혔을 때 쓰라고.
#:
#: **공용 DNS 까지 막힌 망이 있고**, 그런 기계에서 남는 유일한 길이 "이름을 아는
#: 기계가 대신 물어봐 주는 것" 이다.  주소를 부르는 사람 옆에 있는 값을 못 읽어서
#: 막히는 일은 없어야 한다.
#:
#: 못 얻어도 조용하다.  이 줄은 덤이고, 없다고 해서 위의 주소가 덜 쓸모 있어지는
#: 것은 아니다 -- 시끄러운 실패는 진짜 실패를 묻는다.
tunnel_ip_hint() {
  local url="${1:-}" ip
  [ -n "$url" ] || return 0
  ip="$(dns_public_ip "$(url_host "$url")")"
  [ -n "$ip" ] || return 0
  say ""
  say "  ${DIM}받는 기계가 주소를 못 찾는다고 하면 (랩·학교망이 거르는 일이 있습니다):${OFF}"
  say "    ${GREEN}bmlonly ${url} ${ip}${OFF}"
}

#: 이 기계가 볼 중추 서버를 정한다.  인자 없이 부르면 지금 설정을 보여 준다.
#: 랩 안에서 쓸 주소와 밖에서 쓸 주소를 **따로** 기억한다.
#:
#: `WORKBENCH_SERVER` 하나만 있으면 자리를 옮길 때마다 주소를 다시 쳐야 한다.
#: 그런데 두 주소의 성격이 다르다: LAN 주소는 한 번 정하면 안 바뀌고, 터널
#: 주소는 **열 때마다 달라질 수 있다** (실측: 70a2261f8bc0e8 → 683dafde44f8ea).
#: 그래서 둘을 따로 적어 두고 `bml in` / `bml out` 으로 갈아 끼운다.
#:
#: 활성 주소는 여전히 `WORKBENCH_SERVER` 다 — 나머지 코드는 아무것도 안 바뀐다.
#: 여기서 하는 일은 "어느 것을 거기에 복사할까" 뿐이다.
slot_key() {
  case "${1:-}" in
    in|lan)      printf 'WORKBENCH_SERVER_LAN' ;;
    out|tunnel)  printf 'WORKBENCH_SERVER_TUNNEL' ;;
    *)           return 1 ;;
  esac
}

slot_label() {
  case "${1:-}" in
    in|lan)     printf '랩 안 (LAN)' ;;
    out|tunnel) printf '밖 (터널)' ;;
  esac
}

#: `bml in [주소]` / `bml out [주소]`.
#:
#: 주소를 주면 그 자리에 적고 그리로 붙는다.  안 주면 적어 둔 것을 쓴다.
#: 닿는지 본 뒤에만 활성으로 만든다 — 못 닿는 주소를 활성으로 만들면 그 뒤로
#: `bml` 이 매번 실패하는데, 사람은 방금 고른 자리가 아니라 서버를 의심한다
#: (`cmd_use` 가 같은 이유로 같은 순서를 지킨다).
cmd_slot() {
  local which="$1" raw="${2:-}" key url
  key="$(slot_key "$which")" || die "모르는 자리: $which"

  if [ -z "$raw" ]; then
    raw="${!key:-}"
    if [ -z "$raw" ]; then
      printf '%s✕%s %s 주소가 아직 없습니다.\n' "$RED" "$OFF" "$(slot_label "$which")" >&2
      case "$which" in
        in|lan)
          say "  ${DIM}중추 서버에서${OFF} ${GREEN}bml status${OFF} ${DIM}의 '접속 주소' 줄을 보고:${OFF}"
          say "    ${GREEN}bml in <그 주소>${OFF}" ;;
        *)
          say "  ${DIM}중추 서버에서${OFF} ${GREEN}bml share${OFF} ${DIM}가 알려 준 주소로:${OFF}"
          say "    ${GREEN}bml out <그 주소>${OFF}"
          say "  ${DIM}터널 주소는 열 때마다 달라질 수 있습니다 — 그때마다 다시 적어 주세요.${OFF}" ;;
      esac
      exit 1
    fi
  fi

  url="$(normalize_server_url "$raw")"
  step "확인  $url ${DIM}($(slot_label "$which") · 최대 ${WORKBENCH_WAIT:-40}초)${OFF}"
  if ! wait_until_alive "$url" "${WORKBENCH_WAIT:-40}"; then
    printf '%s✕%s 그 주소에서 워크벤치가 응답하지 않습니다: %s\n' "$RED" "$OFF" "$url" >&2
    server_unreachable_help "$url"
    # 적어 둔 것은 지우지 않는다.  자리를 옮기는 중일 뿐일 수 있고, 지워 버리면
    # 돌아왔을 때 다시 쳐야 한다.
    [ -n "${!key:-}" ] && say "  ${DIM}적어 둔 $(slot_label "$which") 주소는 그대로 둡니다: ${!key}${OFF}"
    # 자리를 둘로 나눈 이유가 이것이다 — 한쪽이 안 되면 다른 쪽이 있다.
    local other okey
    case "$which" in in|lan) other=out ;; *) other=in ;; esac
    okey="$(slot_key "$other")"
    if [ -n "${!okey:-}" ]; then
      say "  ${DIM}반대쪽이 적혀 있습니다 —${OFF} ${GREEN}bml${other}${OFF} ${DIM}로 붙습니다: ${!okey}${OFF}"
    fi
    exit 1
  fi

  if ! write_env_key "$key" "$url" || ! write_env_key WORKBENCH_SERVER "$url"; then
    env_write_failed
    return 1
  fi
  SERVER="$url"
  ok "$(slot_label "$which") → ${B}${url}${OFF}"

  # 이 기계에 서버가 떠 있으면 같이 짚는다 (cmd_use 와 같은 이유: 둘 다
  # localhost:5003 이라 화면으로는 어느 쪽인지 알 수 없다).
  if port_busy "$PORT" && owns_port "$PORT"; then
    warn "이 기계에도 서버가 떠 있습니다 — ${GREEN}bml stop${OFF} ${DIM}으로 내리세요.${OFF}"
  fi
}

#: `bmlonly [주소]` — **이 기계의 DNS 가 터널 도메인을 거를 때만** 쓰는 길.
#:
#: 왜 따로 두는가.  `bmlout` 은 어느 기계에서나 같은 뜻이어야 한다 -- "밖
#: 주소로 붙어라".  그런데 DNS 가 막힌 기계에서는 그 한 줄이 세 단계가 된다:
#: 공용 DNS 로 IP 를 얻고, `/etc/hosts` 에 이름표를 박고, 그다음 다시 붙는다.
#: 그 셋을 `bmlout` 에 섞으면 **멀쩡한 기계에서도** sudo 를 묻는 명령이 되고,
#: 막히지도 않은 곳에서 hosts 를 건드리게 된다.  그래서 이름을 나눴다 --
#: `bmlonly` 는 그 한 대에서만 쓴다.
#:
#: 하는 일은 그 셋뿐이고, **터널이 살아 있는 것을 확인한 뒤에만** hosts 를
#: 건드린다 (§0.4).  죽은 터널의 IP 를 박아 두면 다음에 그 이름이 다른 곳을
#: 가리키게 되고, 그때 화면은 아무 말도 안 한다.
cmd_only() {
  local raw="${1:-${WORKBENCH_SERVER_TUNNEL:-}}" given_ip="${2:-}" url host ip code

  if [ -z "$raw" ]; then
    printf '%s✕%s 어느 터널 주소인지 알려 주세요.\n' "$RED" "$OFF" >&2
    say "  ${DIM}중추 서버의${OFF} ${GREEN}bml share${OFF} ${DIM}가 알려 준 주소로:${OFF}"
    say "    ${GREEN}bmlonly https://xxxx.lhr.life${OFF}"
    say "  ${DIM}공용 DNS 까지 막힌 망이면 IP 도 함께 (bml share 가 같이 적어 줍니다):${OFF}"
    say "    ${GREEN}bmlonly https://xxxx.lhr.life 1.2.3.4${OFF}"
    exit 1
  fi
  url="$(normalize_server_url "$raw")"
  host="$(url_host "$url")" || die "주소를 읽지 못했습니다: $url"

  # **이미 닿으면 아무것도 하지 않는다.**  이름이 잡히는지(`getent`)가 아니라
  # 워크벤치가 답하는지를 본다 -- 우리가 알고 싶은 것이 그것이고, 이름 풀이는
  # 그 대리 지표일 뿐이라 어긋날 수 있다.
  #
  # 이 갈래가 없으면 **성공한 뒤에 실패가 찍힌다.**  `sync_repo` 가 자기
  # 갱신을 받으면 원래 명령줄로 다시 실행하는데(exec), 그러면 방금 끝낸
  # 이름표 박기가 처음부터 한 번 더 돌고, 그 두 번째가 공용 DNS 에서 걸리면
  # 화면의 마지막 줄이 빨간 ✕ 다 -- 실제로는 붙어 있는데.
  # 4초로 재다가 두 번 헛짚었다.  이 왕복은 학교망 → 인터넷 → localhost.run →
  # 다시 학교망 → WSL 이라, 잘 되는 날에도 몇 초가 든다.  짧게 재면 **멀쩡한
  # 터널을 죽은 것으로 보고** 아래의 hosts 절차로 내려간다.
  if server_alive "$url" 12; then
    say "${DIM}이미 닿습니다 — hosts 를 건드릴 것 없이 그대로 씁니다.${OFF}"
    cmd_slot out "$url"
    return 0
  fi

  # 아직 안 닿아도 **이름이 잡히면** 여기서 할 일은 없다.  이름표는 이미
  # 박혀 있고, 지금 안 닿는 것은 저쪽 사정이다 (터널이 다시 붙는 중이라거나).
  # 그때 공용 DNS 로 내려가면, 그것마저 막힌 망에서는 "이 망이 막습니다" 라는
  # **엉뚱한 결론**으로 끝난다 -- 정작 막힌 것은 아무것도 없는데 (실측).
  # 평소 길로 보내면 40초를 기다려 보고, 그래도 안 되면 제대로 된 진단이 나온다.
  if command -v getent >/dev/null 2>&1 && getent hosts "$host" >/dev/null 2>&1; then
    say "${DIM}이름은 이미 잡힙니다 — hosts 는 그대로 두고 평소처럼 붙습니다.${OFF}"
    cmd_slot out "$url"
    return 0
  fi

  # 사람이 IP 를 들고 왔으면 아무한테도 안 물어본다.  **모든 DNS 가 막힌
  # 망에서 남는 유일한 길**이고, 답을 아는 기계(중추 서버)가 이미 있다.
  if [ -n "$given_ip" ]; then
    case "$given_ip" in
      *[!0-9.]*|"") die "IP 로 안 보입니다: $given_ip" ;;
    esac
    ip="$given_ip"
    say "${DIM}주소를 받아 왔습니다 — DNS 는 건너뜁니다: ${ip}${OFF}"
  else
    step "공용 DNS 에 주소를 물어보는 중 ${DIM}(이 기계의 DNS 를 건너뜁니다)${OFF}"
    ip="$(dns_public_ip "$host")"
  fi
  if [ -z "$ip" ]; then
    printf '%s✕%s 공용 DNS 세 곳에 다 못 물어봤습니다 (1.1.1.1 · 8.8.8.8 · 9.9.9.9).\n' \
      "$RED" "$OFF" >&2
    say "  ${B}그래도 길이 있습니다.${OFF} ${DIM}주소를 아는 기계가 이미 있으니까요 —${OFF}"
    say "  ${DIM}중추 서버(윤홍 쪽)에서${OFF} ${GREEN}bml share${OFF} ${DIM}를 치면 주소 밑에 IP 가 같이 나옵니다.${OFF}"
    say "  ${DIM}그 IP 를 뒤에 붙여 다시:${OFF}"
    say "    ${GREEN}bmlonly ${url} <그 IP>${OFF}"
    say "  ${DIM}그마저 안 되면 휴대폰(모바일 데이터)으로 그 주소를 열어 보면 갈립니다 —${OFF}"
    say "  ${DIM}열리면 이 망만의 문제이고, 안 열리면 터널이 닫힌 것입니다.${OFF}"
    exit 1
  fi
  [ -n "$given_ip" ] || ok "$host → $ip"

  step "그 주소로 직접 물어보는 중 ${DIM}(이름을 건너뜁니다)${OFF}"
  code="$(tunnel_probe_by_ip "$url" "$ip")"
  if [ "$code" != "200" ]; then
    # 살아 있는 것을 못 봤으면 hosts 를 건드리지 않는다.  죽은 IP 를 박아 두면
    # 그 뒤로 이 기계만 조용히 엉뚱한 곳을 본다.
    printf '%s✕%s 그 주소가 워크벤치를 돌려주지 않습니다.\n' "$RED" "$OFF" >&2
    say "  ${DIM}$(tunnel_code_meaning "$code")${OFF}"
    say "  ${DIM}/etc/hosts 는 건드리지 않았습니다 — 중추 서버에서${OFF} ${GREEN}bml status${OFF}${DIM}:${OFF}"
    say "    ${DIM}'실행 중' 이 없으면${OFF}   ${GREEN}bml${OFF} ${DIM}로 띄웁니다 (주소는 그대로)${OFF}"
    say "    ${DIM}'공유 주소' 가 없으면${OFF} ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF} ${DIM}(새 주소)${OFF}"
    exit 1
  fi
  ok "터널이 살아 있습니다 ${DIM}(HTTP 200)${OFF}"

  step "이름표를 박는 중 ${DIM}(/etc/hosts · sudo 를 묻습니다)${OFF}"
  say "  ${DIM}${ip} ${host}${OFF}"
  # 옛 터널 이름은 먼저 지운다.  열 때마다 이름이 바뀌므로 붙이기만 하면
  # 죽은 이름이 쌓이고, 그중 하나가 나중에 남의 서버를 가리킬 수 있다.
  if ! sudo sed -i '/\.lhr\.life$/d;/\.localhost\.run$/d;/\.trycloudflare\.com$/d' /etc/hosts \
     || ! printf '%s %s\n' "$ip" "$host" | sudo tee -a /etc/hosts >/dev/null; then
    printf '%s✕%s /etc/hosts 를 고치지 못했습니다.\n' "$RED" "$OFF" >&2
    say "  ${DIM}손으로 한 줄:${OFF} ${GREEN}echo '${ip} ${host}' | sudo tee -a /etc/hosts${OFF}"
    exit 1
  fi
  ok "박았습니다. ${DIM}(WSL 안에서 — 아래를 보세요)${OFF}"
  if is_wsl; then
    # **여기가 진짜 함정이다.**  이 명령은 WSL 의 /etc/hosts 를 고치는데,
    # 브라우저는 **Windows** 에 있고 그 파일을 아예 안 본다.  그래서 방금
    # `bml` 은 붙었다고 하는데 크롬은 ERR_CONNECTION_CLOSED 를 낸다 -- 화면
    # 둘이 정반대를 말하고, 어느 쪽을 믿어야 하는지 알 방법이 없다 (실측).
    say ""
    say "  ${B}브라우저로 보려면 Windows 에도 같은 줄이 있어야 합니다.${OFF}"
    say "  ${DIM}방금 고친 것은 WSL 의 /etc/hosts 이고, 크롬은 Windows 것이라 그 파일을 안 봅니다.${OFF}"
    say "  ${DIM}Windows 의${OFF} ${B}관리자${OFF} ${DIM}PowerShell (Win+X → 터미널(관리자)) 에서 한 줄:${OFF}"
    say "    ${GREEN}Add-Content \$env:WINDIR\\System32\\drivers\\etc\\hosts \"${ip} ${host}\"${OFF}"
    say "  ${DIM}지울 때:${OFF}"
    say "    ${GREEN}(gc \$env:WINDIR\\System32\\drivers\\etc\\hosts) | ? { \$_ -notmatch 'lhr\\.life' } | sc \$env:WINDIR\\System32\\drivers\\etc\\hosts${OFF}"
    say ""
    say "  ${DIM}WSL 쪽은 켤 때마다 다시 만들어져 재부팅하면 사라집니다 — 그때는${OFF} ${GREEN}bmlonly${OFF} ${DIM}를 한 번 더.${OFF}"
    say "  ${DIM}아예 남기려면 /etc/wsl.conf 에 [network] generateHosts=false.${OFF}"
  fi

  # 여기서부터는 보통 기계와 같다 -- 이름이 잡히므로 `bmlout` 과 똑같이 간다.
  cmd_slot out "$url"
}

cmd_use() {
  local raw="${1:-}"

  if [ -z "$raw" ]; then
    if [ -n "$SERVER" ]; then
      say "중추 서버  ${B}${SERVER}${OFF}   ${DIM}($REPO/.bml/env)${OFF}"
      if server_alive "$SERVER"; then ok "응답합니다."; else warn "지금은 응답하지 않습니다."; fi
      if server_is_this_machine; then
        say ""
        warn "이 주소는 ${B}이 기계 자신${OFF}입니다 — 설정을 지우는 편이 맞습니다."
        say "  ${DIM}이대로면 bml 이 서버를 띄우지도 빌드하지도 않아, 갱신을 받아도${OFF}"
        say "  ${DIM}화면이 그대로입니다.${OFF}  ${GREEN}bml use off${OFF}"
      fi
    else
      say "${DIM}중추 서버가 설정돼 있지 않습니다 — 'bml' 은 이 기계에 서버를 띄웁니다.${OFF}"
      say "  ${GREEN}bml use 192.168.0.7${OFF}   ${DIM}(중추 서버 PC 의 주소)${OFF}"
    fi
    return 0
  fi

  case "$raw" in
    off|none|local|해제)
      if ! write_env_key WORKBENCH_SERVER ""; then env_write_failed; return 1; fi
      ok "중추 서버 설정을 지웠습니다 — 이제 'bml' 은 이 기계에 서버를 띄웁니다."
      say "  ${DIM}데이터: ${DATA_DIR}${OFF}"
      return 0
      ;;
  esac

  local url; url="$(normalize_server_url "$raw")"
  step "확인  $url ${DIM}(최대 ${WORKBENCH_WAIT:-40}초)${OFF}"
  # 닿는지 본 뒤에만 적는다.  못 닿는 주소를 적어 두면 그 뒤로 `bml` 이 매번
  # 실패하는데, 사람은 방금 적은 주소를 의심하지 않고 서버를 의심한다.
  if ! wait_until_alive "$url" "${WORKBENCH_WAIT:-40}"; then
    printf '%s✕%s 그 주소에서 워크벤치가 응답하지 않습니다: %s\n' "$RED" "$OFF" "$url" >&2
    server_unreachable_help "$url"
    say "  ${DIM}한 번만 시험해 보려면${OFF}  ${GREEN}WORKBENCH_SERVER=$url bml${OFF}"
    exit 1
  fi

  if ! write_env_key WORKBENCH_SERVER "$url"; then env_write_failed; return 1; fi
  ok "이제 이 기계의 'bml' 은 ${B}${url}${OFF} 을 엽니다."

  # 이 기계에 서버가 떠 있으면 그대로 두지 않는다.  둘 다 5003 이라 브라우저
  # 탭 두 개가 같은 주소처럼 보이는데 데이터는 서로 다르다.
  if port_busy "$PORT" && owns_port "$PORT"; then
    say ""
    warn "이 기계에도 서버가 떠 있습니다 — 그쪽 데이터는 ${DATA_DIR} 입니다."
    say "  ${GREEN}bml stop${OFF} ${DIM}으로 내리세요.${OFF}"
  fi
}

#: 중추 서버를 여는 것이 전부다.  pull 도 venv 도 하지 않는다 — 이 기계는
#: 코드를 실행하지 않으므로 최신일 필요가 없고, 무엇보다 data/ 를 만들지
#: 않는다.  코드를 고칠 때만 `bml dev` 로 자기 서버를 띄운다.
#: `bml use` 로 적어 둔 주소가 이 기계 자신을 가리키는가.
#:
#: 그러면 `bml` 은 서버를 띄우지도 빌드하지도 않고 브라우저만 연다 —
#: 이미 떠 있던 옛 서버가 계속 응답하므로 화면은 멀쩡하고, 갱신을 받아도
#: 반영되지 않는다.  **"restart 했는데 안 바뀐다" 가 이렇게 나온다.**
#: 실제로 그렇게 됐다 (2026-08-24, 비교 화면의 dQ/dV 토글).
#:
#: 주소만 받아 시험할 수 있게 인자를 하나 받는다.
server_is_this_machine() {
  local url="${1:-$SERVER}"
  [ -n "$url" ] || return 1
  local rest="${url#*://}"; rest="${rest%%/*}"
  local host="$rest" port=""
  case "$rest" in
    \[*\]*)  host="${rest%%]*}]"; port="${rest##*]}"; port="${port#:}" ;;
    *:*)     host="${rest%%:*}";  port="${rest##*:}" ;;
  esac
  [ -n "$port" ] || port=80
  [ "$port" = "$PORT" ] || return 1
  case "$host" in
    localhost|127.0.0.1|'[::1]'|::1|0.0.0.0) return 0 ;;
  esac
  hostname -I 2>/dev/null | tr ' ' '\n' | grep -qx -- "$host"
}

cmd_connect() {
  say "${B}Battery Lab Workbench${OFF}  ${DIM}중추 서버${OFF}"
  say ""
  if server_is_this_machine; then
    warn "중추 서버 주소가 ${B}이 기계 자신${OFF}을 가리킵니다 — ${SERVER}"
    say "  ${DIM}그러면 bml 은 서버를 띄우지도, 화면을 빌드하지도 않고 브라우저만${OFF}"
    say "  ${DIM}엽니다.  이미 떠 있던 옛 서버가 계속 응답하므로, 갱신을 받아도${OFF}"
    say "  ${DIM}화면이 그대로입니다.${OFF}"
    say "  ${GREEN}bml use off${OFF} ${DIM}후${OFF} ${GREEN}bml${OFF} ${DIM}— 이 기계가 직접 띄우게 하세요.${OFF}"
    say ""
  fi
  if ! wait_until_alive "$SERVER" "${WORKBENCH_WAIT:-20}"; then
    printf '%s✕%s 중추 서버가 응답하지 않습니다: %s\n' "$RED" "$OFF" "$SERVER" >&2
    server_unreachable_help "$SERVER"
    exit 1
  fi
  ok "열었습니다 → ${SERVER}"
  say "  ${DIM}올린 .wrd 와 고친 값은 전부 그 서버에 저장됩니다 — 모두가 같은 것을 봅니다.${OFF}"
  if port_busy "$PORT" && owns_port "$PORT"; then
    say ""
    warn "이 기계에도 서버가 떠 있습니다 (${URL}) — 그쪽은 ${DATA_DIR} 를 봅니다."
    say "  ${GREEN}bml stop${OFF} ${DIM}으로 내리면 헷갈릴 일이 없습니다.${OFF}"
  fi
  open_browser "$SERVER"
}

cmd_status() {
  say "${B}Battery Lab Workbench${OFF}  ${DIM}$REPO${OFF}"
  say ""

  server_state
  case $? in
    0) ok "실행 중 → $URL" ;;
    1)
      warn "서버는 떠 있는데 정상 응답하지 않습니다."
      say "  ${DIM}해결: ${OFF}${GREEN}bml repair${OFF}${DIM} 후 ${OFF}${GREEN}bml${OFF}"
      ;;
    *)
      if port_busy "$PORT"; then
        if owns_port "$PORT"; then
          warn "이전 bml 프로세스가 남아 있습니다 — 'bml' 이 알아서 갈아끼웁니다."
        else
          warn "포트 ${PORT} 는 사용 중인데 bml 이 아닙니다."
        fi
      else
        say "${DIM}멈춰 있습니다. 'bml' 로 시작하세요.${OFF}"
      fi
      ;;
  esac

  say ""
  local branch dirty ahead behind
  branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  dirty="$(git -C "$REPO" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  ahead="$(git -C "$REPO" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo ?)"
  behind="$(git -C "$REPO" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo ?)"
  say "브랜치      ${branch}"
  # 이 기계가 남의 서버를 보고 있으면, 아래 '데이터' 줄은 화면에 뜨는 것과
  # 아무 상관이 없다.  그 사실을 안 적어 두면 원본 0개를 보고 데이터가
  # 사라졌다고 읽는다.
  if [ -n "$SERVER" ]; then
    if server_alive "$SERVER"; then
      say "중추 서버   ${SERVER}  ${DIM}(화면에 뜨는 것은 여기 있습니다)${OFF}"
    else
      warn "중추 서버   ${SERVER} — 응답 없음"
    fi
    # 적어 둔 두 자리를 같이 보여 준다.  어느 쪽에 붙어 있는지, 반대쪽으로
    # 가려면 무엇을 치는지가 한 화면에 있어야 자리를 옮길 때 헤매지 않는다.
    local lan="${WORKBENCH_SERVER_LAN:-}" wan="${WORKBENCH_SERVER_TUNNEL:-}"
    if [ -n "$lan" ] || [ -n "$wan" ]; then
      local mark
      mark=" "; [ "$SERVER" = "$lan" ] && mark="●"
      [ -n "$lan" ] && say "  ${mark} ${DIM}랩 안 (bmlin)${OFF}   ${lan}"
      mark=" "; [ "$SERVER" = "$wan" ] && mark="●"
      [ -n "$wan" ] && say "  ${mark} ${DIM}밖   (bmlout)${OFF}   ${wan}"
    fi
  fi
  # 떠 있는 서버가 **어느 코드를 들고 있는가.**
  #
  # 이 줄이 없어서 실제로 막혔다: 새 기능을 push 하고 상대가 `bml` 을 쳤는데
  # 화면에 안 보였다.  그때 확인할 방법이 "코드를 열어 본다" 뿐이었다 —
  # 저장소는 최신인데 서버가 옛 코드일 수도, 서버는 새 코드인데 브라우저가
  # 옛 번들을 캐시했을 수도 있고, 대처가 셋 다 다르다.
  #
  # `bml` 은 옛 서버를 감지해서 다시 띄우지만, status 는 아무 말도 안 했다.
  # server_state 는 값을 찍지 않고 **종료 코드**로 답한다 ($(...) 로 받으면
  # 항상 빈 문자열이라 이 줄이 통째로 죽는다).
  if [ -z "$SERVER" ] && server_state; then
    local serving head_now
    serving="$(cat "$HEAD_FILE" 2>/dev/null)"
    head_now="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"
    if [ -z "$serving" ]; then
      warn "서비스 중   어느 커밋인지 알 수 없습니다 ${DIM}(옛 bml 이 띄운 서버)${OFF}"
      say "  ${GREEN}bml restart${OFF} ${DIM}하면 지금 코드로 다시 뜹니다.${OFF}"
    elif [ "$serving" != "$head_now" ]; then
      warn "서비스 중   ${serving:0:8} — 저장소는 ${head_now:0:8} 입니다 ${DIM}(옛 코드가 떠 있습니다)${OFF}"
      say "  ${GREEN}bml restart${OFF} ${DIM}로 지금 코드를 띄웁니다.${OFF}"
    elif web_needs_build; then
      warn "서비스 중   ${serving:0:8} — 화면 번들이 소스보다 낡았습니다"
      say "  ${GREEN}bml restart${OFF} ${DIM}가 다시 빌드합니다.${OFF}"
    else
      say "서비스 중   ${serving:0:8}  ${DIM}$(git -C "$REPO" log -1 --format=%s "$serving" 2>/dev/null | cut -c1-52)${OFF}"
    fi
  fi

  # 중추 서버로 쓸 때 가장 먼저 확인해야 하는 줄이다 — 드라이브가 빠지면
  # 화면은 멀쩡하고 라이브러리만 비어 보인다.
  local whose=""
  [ -n "$SERVER" ] && whose="  ${DIM}— 이 기계 것 (중추 서버를 볼 때는 안 쓰입니다)${OFF}"
  if [ -d "$DATA_DIR" ]; then
    say "데이터      ${DATA_DIR}  ${DIM}(원본 $(uploads_count "$DATA_DIR/uploads")개)${OFF}${whose}"
  elif [ -n "$SERVER" ]; then
    say "데이터      ${DIM}없음${OFF}${whose}"
  else
    warn "데이터      ${DATA_DIR} — 폴더가 없습니다 (드라이브가 빠졌나요?)"
  fi
  [ -n "${WORKBENCH_PASSWORD:-}" ] && say "공유 암호   설정됨  ${DIM}(bml share 로 바깥에 열 수 있습니다)${OFF}"
  # 터널이 **스스로 죽은** 경우.  주소 파일은 남고 프로세스만 없다 (SSH 가
  # 끊기거나 랩 망이 그 연결을 자르면 그렇게 된다).
  #
  # 예전에는 이때 화면이 아무 말도 안 했다 -- 공유 관련 줄이 통째로 사라질
  # 뿐이라, "터널이 죽었다" 와 "애초에 안 열었다" 가 같은 화면이 된다.  실측
  # 2026-08-24: 그 침묵 때문에 서버가 내려간 줄 알고 엉뚱한 곳을 30분 팠다.
  # **없는 줄은 근거가 아니다.**  죽었으면 죽었다고 적는다.
  if ! tunnel_running && [ -n "$(tunnel_url)" ]; then
    warn "공유 주소   $(tunnel_url) — ${B}터널이 죽어 있습니다${OFF} ${DIM}(주소 기록만 남았습니다)${OFF}"
    say "  ${GREEN}bml share${OFF} ${DIM}로 다시 엽니다 — 주소가 바뀌므로 다른 기계에서${OFF} ${GREEN}bmlout <새 주소>${OFF}"
  fi
  if tunnel_running && [ -n "$(tunnel_url)" ]; then
    local tcode; tcode="$(http_code_of "$(tunnel_url)" 8)"
    if [ "$tcode" = "200" ]; then
      say "공유 주소   ${B}$(tunnel_url)${OFF}  ${DIM}(bml share stop 으로 닫습니다)${OFF}"
    else
      warn "공유 주소   $(tunnel_url) — 여기서는 확인이 안 됩니다"
      say "  ${DIM}$(tunnel_code_meaning "$tcode")${OFF}"
      # 000 일 때만 한 층 더 판다.  tls·tcp 에서 끊기는 것은 터널이 아니라 이
      # 기계의 망이므로, "다시 열어 보라" 는 안내를 하면 안 된다 — 멀쩡한
      # 터널을 닫게 만든다.
      local ours=1 tlayer="" talive=""
      tunnel_running && talive=1
      if [ "${tcode:-000}" = "000" ]; then
        tlayer="$(tunnel_block_layer "$(tunnel_url)")"
        say "  ${DIM}$(block_layer_meaning "$tlayer" "$talive")${OFF}"
        # 터널 프로그램이 살아 있는데 이름이 안 잡히는 것은 닫힌 것이 아니라
        # 이 기계의 DNS 다.  여기서 "다시 열어 보라" 를 하면 멀쩡한 터널을
        # 닫게 만든다 — tls·tcp 와 같은 이유로 같은 취급을 한다.
        case "$tlayer" in tls|tcp) ours=0 ;; dns) [ -n "$talive" ] && ours=0 ;; esac
      fi
      if [ "$ours" -eq 0 ]; then
        say "  ${DIM}터널은 살아 있습니다 — 상대에게 그 주소를 그대로 주세요. 이 기계에서는${OFF} ${GREEN}http://localhost:${PORT}${OFF}"
      else
        say "  ${DIM}방금 열었다면 10초쯤 뒤 다시${OFF} ${GREEN}bml status${OFF}${DIM}. 계속 이러면${OFF} ${GREEN}bml share stop${OFF} ${DIM}후${OFF} ${GREEN}bml share${OFF}"
      fi
    fi
  fi
  local scope; scope="$(listening_scope "$(ss -ltn 2>/dev/null)")"
  if [ "$scope" = "local" ] && [ "$HOST" = "0.0.0.0" ]; then
    warn "공개        설정은 0.0.0.0 인데, 떠 있는 서버는 이 기계 안에서만 열려 있습니다."
    say "  ${GREEN}bml restart${OFF} ${DIM}— 설정을 넣기 전에 띄운 서버입니다.${OFF}"
  elif [ -z "$SERVER" ] && server_state && [ "$HOST" != "0.0.0.0" ] && [ "$scope" != "all" ]; then
    # 이 기계 안에서만 열려 있다.  예전에는 이때 **아무 줄도 안 찍었다** — 그래서
    # "노트북에서 왜 안 붙지" 를 서버 쪽 화면에서 확인할 방법이 없었다.  실측:
    # `.bml/env` 를 통째로 덮어써서 WORKBENCH_HOST 줄이 사라졌고, 서버는 멀쩡히
    # 떠 있는데 노트북이 `curl (7)` 로 튕겼다.  서버 화면은 그때도 조용했다.
    say "공개        ${DIM}이 기계 안에서만 (localhost)${OFF}"
    say "            ${DIM}다른 기계에서 보려면${OFF} ${GREEN}bml host open${OFF} ${DIM}후${OFF} ${GREEN}bml restart${OFF}"
  elif [ "$HOST" = "0.0.0.0" ] || [ "$scope" = "all" ]; then
    say "공개        네트워크의 다른 기계에서 접속 가능"
    # 누가 들어올 수 있는지까지 말한다.  "접속 가능" 만으로는 **암호 없이**
    # 전부 보고 고칠 수 있다는 사실이 안 보이고, 그것은 사람이 스스로 물어야
    # 알게 되는 것이 아니라 화면이 먼저 말해야 하는 것이다.
    local door_code
    door_code="$(curl -s -o /dev/null -m 4 -w '%{http_code}' "$URL/api/samples" 2>/dev/null | tr -dc '0-9' | tail -c 3)"
    case "$(door_state "$door_code" "${WORKBENCH_PASSWORD:-}")" in
      locked)
        # 문이 있다는 것과 **지금 적어 둔 암호의 문**이라는 것은 다르다.
        if [ -z "${WORKBENCH_PASSWORD:-}" ]; then
          say "문          공유 암호를 한 번 묻습니다. ${DIM}(이 기계에는 그 암호가 안 적혀 있습니다)${OFF}"
        elif door_password_works "$URL" "${WORKBENCH_PASSWORD:-}"; then
          say "문          공유 암호를 한 번 묻습니다. ${DIM}(지금 적어 둔 암호로 열립니다 — 확인했습니다)${OFF}"
        else
          warn "문          있는데 ${B}지금 적어 둔 암호로는 안 열립니다${OFF} — 떠 있는 서버가 옛 암호를 들고 있습니다."
          say "  ${GREEN}bml restart${OFF} ${DIM}— 적어 둔 암호를 서버에 반영합니다. 그 전에 남에게 알려 주면 못 들어옵니다.${OFF}"
        fi
        ;;
      pending) warn "문          암호를 적어 뒀지만 떠 있는 서버는 그것을 안 들고 있습니다."
               say "  ${GREEN}bml restart${OFF} ${DIM}— 적기 전에 띄운 서버입니다.${OFF}" ;;
      open)    say "문          ${B}없습니다${OFF} ${DIM}— 이 주소에 닿는 사람은 암호 없이 전부 보고 고칩니다.${OFF}"
               say "            ${DIM}랩 안에서는 이대로가 맞습니다. 걸려면${OFF} ${GREEN}bml password <암호>${OFF} ${DIM}후${OFF} ${GREEN}bml restart${OFF}" ;;
      # 모르면 모른다고 찍는다 (Codex 리뷰 14번).  줄 자체가 사라지면 사람은
      # "문이 없구나" 로 읽는다 — 확인을 못 한 것과 없는 것은 다르다.
      *)       say "문          ${DIM}확인하지 못했습니다 — 서버가 응답하지 않습니다 (HTTP ${door_code:-무응답}).${OFF}" ;;
    esac
    # 다른 사람에게 불러 줄 주소.  이것을 안 적어 두면 hostname -I 의 첫 줄을
    # 그대로 쓰게 되는데, 그것이 맞을 이유가 없다.
    local addrs label="접속 주소  "
    # lan 이 vpn 보다 먼저 오도록 정렬한다 — 같은 공유기 안이면 그쪽이 빠르다.
    addrs="$(reachable_addresses "$(hostname -I 2>/dev/null)" | sort)"
    if [ -n "$addrs" ]; then
      printf '%s\n' "$addrs" | while read -r kind a; do
        case "$kind" in
          vpn) say "${label} ${B}http://${a}:${PORT}${OFF}  ${DIM}사설망 — 다른 공유기에서도${OFF}" ;;
          *)   say "${label} ${B}http://${a}:${PORT}${OFF}  ${DIM}같은 공유기 안에서${OFF}" ;;
        esac
        label="           "
      done
      say "            ${DIM}다른 기계에서:${OFF} ${GREEN}bml use <위 주소 중 하나>${OFF}"
    else
      # 다른 기계가 칠 수 있는 주소가 없다.  거의 항상 WSL 의 NAT 모드다 —
      # 무엇을 붙여넣어야 하는지까지 nat_hint 가 찍는다.
      warn "접속 주소   찾지 못했습니다 — WSL 이 NAT 뒤에 있습니다."
      nat_hint "$(wsl_nat_address "$(hostname -I 2>/dev/null)")"
    fi
  fi
  say "미커밋      ${dirty}개"
  say "업스트림    ahead ${ahead} / behind ${behind}"
  [ "$behind" != "0" ] && [ "$behind" != "?" ] && warn "'bml pull' 로 먼저 맞추세요."

  if command -v "$(python_bin)" >/dev/null 2>&1; then
    say ""
    "$(python_bin)" "$REPO/tools/wiki_status.py" 2>/dev/null | tail -n +2 | head -20
  fi
}

#: 이 브랜치에서 무슨 일이 있었나 — 다른 세션이 한 번에 따라잡는 화면.
#:
#: 두 사람이 같은 브랜치를 쓰고, 각자 다른 Claude Code 세션에서 일한다.
#: `git log` 는 **무엇을** 고쳤는지만 말하고 **왜** 는 말하지 않는다.  그
#: '왜' 가 `docs/log.md` 에 있는데, 둘을 따로 보면 짝이 안 맞는 것을 아무도
#: 눈치채지 못한다.  여기서 나란히 놓고, 기록이 빠진 커밋을 드러낸다.
cmd_feed() {
  local n="${1:-12}"
  case "$n" in ''|*[!0-9]*) n=12 ;; esac
  cd "$REPO" 2>/dev/null || die "저장소를 찾지 못했습니다: $REPO"

  say "${B}이 브랜치에서 무슨 일이 있었나${OFF}  ${DIM}($(git rev-parse --abbrev-ref HEAD 2>/dev/null))${OFF}"
  say ""

  local missing=0 hash date subject
  while IFS=$'\t' read -r hash date subject; do
    [ -n "$hash" ] || continue
    if log_has_entry "$subject"; then
      say "  ${GREEN}●${OFF} ${B}${hash}${OFF}  ${DIM}${date}${OFF}  ${subject}"
    else
      say "  ${YELLOW}○${OFF} ${B}${hash}${OFF}  ${DIM}${date}${OFF}  ${subject}"
      say "      ${DIM}docs/log.md 에 이 제목의 항목이 없습니다${OFF}"
      missing=$((missing + 1))
    fi
  done < <(git log -n "$n" --format='%h%x09%ad%x09%s' --date=short 2>/dev/null)

  say ""
  # 아직 안 올린 것과 안 커밋한 것.  다른 세션은 push 된 것만 볼 수 있으므로,
  # 여기 남아 있는 것은 "상대에게 아직 안 보이는 일" 이다.
  local ahead dirty upstream
  upstream="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"
  if [ -n "$upstream" ]; then
    ahead="$(git rev-list --count "$upstream"..HEAD 2>/dev/null)"
    [ "${ahead:-0}" -gt 0 ] && warn "push 안 한 커밋 ${ahead}개 — 상대에게 아직 안 보입니다 (git push)"
  fi
  dirty="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  [ "${dirty:-0}" -gt 0 ] && say "  ${DIM}작업 중인 변경 ${dirty}개 — 커밋 전입니다.${OFF}"

  if [ "$missing" -gt 0 ]; then
    say ""
    warn "기록이 없는 커밋 ${missing}개 — 다른 세션은 '왜' 를 알 수 없습니다."
    say "  ${DIM}docs/log.md 에 커밋 제목과 같은 제목으로 한 줄 적습니다 (명령이 아니라 파일 내용입니다):${OFF}"
    file_line "## [$(date +%F)] fix | <커밋 제목과 같은 문장>"
  else
    ok "커밋마다 기록이 있습니다."
  fi
}

