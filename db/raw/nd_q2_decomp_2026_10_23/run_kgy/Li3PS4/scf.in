&CONTROL
    calculation = 'vc-relax'
    prefix      = 'Li3PS4'
    outdir      = './tmp'
    pseudo_dir  = '/home/kgy/work/pseudo'
    tprnfor     = .true.
    tstress     = .true.
    etot_conv_thr = 1.0d-6
    forc_conv_thr = 1.0d-4
    nstep        = 200
/
&SYSTEM
    ibrav       = 0
    nat         = 32
    ntyp        = 3
    ecutwfc     = 70.0
    ecutrho     = 560.0
    occupations = 'smearing'
    smearing    = 'mv'
    degauss     = 0.01
    nosym       = .true.
/
&ELECTRONS
    conv_thr     = 1.0d-9
    electron_maxstep = 100
    mixing_mode  = 'plain'
    mixing_beta  = 0.3
    mixing_ndim  = 8
    diagonalization = 'david'
/
&IONS
    ion_dynamics = 'bfgs'
/
&CELL
    cell_dynamics = 'bfgs'
    press_conv_thr = 0.5
/
