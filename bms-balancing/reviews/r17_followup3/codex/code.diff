+    bytes 가 다르면 값이 달라야 하고, 같으면 같아야 한다 (정규 내용 digest)."""
+    sys.path.insert(0, str(ROOT / "reviews"))
+    import evidence_gate as G                                    # noqa: PLC0415
+
