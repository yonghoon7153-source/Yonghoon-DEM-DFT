# ============================================================
# DEM 언로딩 키트 — ps_7_3_r45 · R — 복원 시험 R (S0 · 2,000 step · PRE · POST · R_END · 보조 소거 진단 restart)
#   생성: make_unload_decks.py (손으로 고치지 말 것 — 생성기를 고치고 다시 만든다 · SHA256SUMS)
#   정본: docs/data/ps45_unload_20261009/README.md · 등록 docs/reviews/dem_unloading_ps45_prereg_20261009.md §12 · §13
#   변수 (run_unload.sh 가 -var 로 준다): out (이 런 폴더) · plate_stl (판 STL · 자료는 restart 에서) · ckpt (읽을 restart) ·
#     ul_base (KE 기준 파일 · S2) · ul_state (상태 파일 · 이어 돌림 · 중력 팔) · ul_resume (1 = 이어 돌림) · ul_s0 (10:0 S0′ 결정)
#   모델 머리 = 원 덱 글자 · 언로딩 블록 숫자 = unload_params.json (덱 안 상수로 다시 적지 않는다 · 생성기 selftest 가 검사)
# ============================================================

# >>> block head — 원 마지막 조각 덱 (r8 꼴) 이 S0 에 켜 둔 정의 그대로 · 순서 = 원 PHASE 4 (zwall_bot → integr → gravi → top_mesh → zwall_top → damp)
#     (r8 글자에서 뽑았다 · 판 STL 경로만 ${plate_stl} — 메시 자료는 restart 에서 · 압축 감쇠 0.5 · 판 이동 fix 는 S0 에 없다)
atom_style granular
atom_modify map array sort 0 0
boundary p p f
newton off
soft_particles yes
communicate single vel yes
units si

variable r_AM_P equal 4.5e-3
variable r_AM_S equal 2.0e-3
variable r_SE equal 0.5e-3
variable dt equal 1.0e-6
timestep ${dt}
processors * * 1

read_restart ${ckpt}

neighbor 0.002 bin
neigh_modify delay 0 check yes

fix m1 all property/global youngsModulus peratomtype 1.4e8 1.4e8 0.135e7
fix m2 all property/global poissonsRatio peratomtype 0.25 0.25 0.30
fix m3 all property/global coefficientRestitution peratomtypepair 3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3 0.3
fix m4 all property/global coefficientFriction peratomtypepair 3 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5 0.5
fix m5 all property/global coefficientRollingFriction peratomtypepair 3 0.2 0.2 0.1 0.2 0.2 0.1 0.1 0.1 0.1
fix m6 all property/global coefficientMaxElasticStiffness peratomtypepair 3 1.5 1.5 3.0 1.5 1.5 3.0 3.0 3.0 5.0
fix m7 all property/global coefficientAdhesionStiffness peratomtypepair 3 1.0e5 1.0e5 2.0e5 1.0e5 1.0e5 2.0e5 2.0e5 2.0e5 1.0e6
fix m8 all property/global coefficientPlasticityDepth peratomtypepair 3 0.05 0.05 0.01 0.05 0.05 0.01 0.01 0.01 0.005
fix m9 all property/global characteristicVelocity scalar 2.0

pair_style gran model hooke/hysteresis tangential history rolling_friction cdt
pair_coeff * *

compute strs all stress/atom
compute ke all ke/atom
compute cpl all pair/gran/local pos id force force_normal force_tangential torque contactArea delta contactPoint

fix zwall_bot all wall/gran model hooke/hysteresis tangential history rolling_friction cdt primitive type 1 zplane 0.0

fix integr all nve/sphere
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix top_mesh all mesh/surface/stress file ${plate_stl} type 1 scale 1.0 reference_point 0 0 0
fix zwall_top all wall/gran model hooke/hysteresis tangential history rolling_friction cdt mesh n_meshes 1 meshes top_mesh
fix damp all viscous 1.0e-5
fix_modify zwall_top energy yes

variable pressMPa equal abs(f_top_mesh[3])/0.0025/1000000
# <<< block head

# >>> block r_params — 표에서 온 숫자
variable ul_bed string ps_7_3_r45
variable ul_s0 index 3200000
variable ul_atoms0 equal 160417
variable ul_big equal 1000000000
# <<< block r_params

# >>> block r_obs — 복원 관측 (ul_ 접두 · 동역학 없음) · 벽 local = mesh 판만 (3d5c00f compute_pair_gran_local.cpp 247–269 행)
compute ul_erot all erotate/sphere
compute ul_wh all wall/gran/local id history force_normal
variable ul_Ps equal f_top_mesh[3]/0.0025/1000000
thermo_style custom step atoms ke c_ul_erot v_ul_Ps v_pressMPa cpu
thermo 1000
# <<< block r_obs

# >>> block r_start — S0 · G1 (setup 줄) · PRE_SETUP (바닥 primitive 배열 그대로 · write_dump = 덤프 init → write · system setup 없음)
variable ul_step equal step
variable ul_step equal ${ul_step}
variable ul_na equal atoms
variable ul_na equal ${ul_na}
if "${ul_step} != ${ul_s0}" then "print 'UL_ABORT reason=start_step step=${ul_step} expect=${ul_s0}'" "quit"
if "${ul_na} != ${ul_atoms0}" then "print 'UL_ABORT reason=start_atoms atoms=${ul_na} expect=${ul_atoms0}'" "quit"
print "UL_R_START bed=${ul_bed} step=${ul_step} atoms=${ul_na}"
write_dump all custom ${out}/obs/pre_bot.dump id type x y z radius mass vx vy vz omegax omegay omegaz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4] modify format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
# POST_SETUP (run 0) — G2 (원 형식 atom · 기본 형식 · 글자 대조) · G2c (원 형식 쌍 접촉 26 열) · 판 mesh md5 · 판 · 바닥 이력 · omega (새 출력)
dump ul_g2a all custom ${ul_big} ${out}/g2/atom_*.liggghts id type x y z radius vx vy vz c_strs[1] c_strs[2] c_strs[3] c_ke
dump_modify ul_g2a first yes
dump ul_g2c all local ${ul_big} ${out}/g2/contact_*.liggghts c_cpl[1] c_cpl[2] c_cpl[3] c_cpl[4] c_cpl[5] c_cpl[6] c_cpl[7] c_cpl[8] c_cpl[9] c_cpl[10] c_cpl[11] c_cpl[12] c_cpl[13] c_cpl[14] c_cpl[15] c_cpl[16] c_cpl[17] c_cpl[18] c_cpl[19] c_cpl[20] c_cpl[21] c_cpl[22] c_cpl[23] c_cpl[24] c_cpl[25] c_cpl[26]
dump_modify ul_g2c first yes
dump ul_g2m all mesh/stl ${ul_big} ${out}/g2/mesh_*.stl top_mesh
dump_modify ul_g2m first yes
dump ul_ow all local ${ul_big} ${out}/obs/post_wall_*.dump c_ul_wh[1] c_ul_wh[2] c_ul_wh[3] c_ul_wh[4] c_ul_wh[5] c_ul_wh[6] c_ul_wh[7] c_ul_wh[8] c_ul_wh[9] c_ul_wh[10]
dump_modify ul_ow first yes format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump ul_oa all custom ${ul_big} ${out}/obs/post_atom_*.dump id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4]
dump_modify ul_oa first yes format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
undump ul_g2a
undump ul_g2c
undump ul_g2m
undump ul_ow
undump ul_oa
print "UL_R_SETUP_DONE step=${ul_step}"
# G3 — 2,000 step (판 고정 = 원 PHASE 4 그대로 · 첫 정규 줄 = 원 로그 같은 step)
run 2000
variable ul_step equal step
variable ul_step equal ${ul_step}
print "UL_R_END step=${ul_step}"
# R_END 관측 (보조 소거 진단의 대조 · 같은 관측 경로)
write_dump all custom ${out}/obs/end_pre_bot.dump id type x y z radius mass vx vy vz omegax omegay omegaz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4] modify format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump ul_ew all local ${ul_big} ${out}/obs/end_post_wall_*.dump c_ul_wh[1] c_ul_wh[2] c_ul_wh[3] c_ul_wh[4] c_ul_wh[5] c_ul_wh[6] c_ul_wh[7] c_ul_wh[8] c_ul_wh[9] c_ul_wh[10]
dump_modify ul_ew first yes format "%.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
dump ul_ea all custom ${ul_big} ${out}/obs/end_post_atom_*.dump id type x y z radius mass vx vy vz omegax omegay omegaz fx fy fz f_history_zwall_bot[1] f_history_zwall_bot[2] f_history_zwall_bot[3] f_history_zwall_bot[4]
dump_modify ul_ea first yes format "%d %d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
undump ul_ew
undump ul_ea
# 보조 소거 (진단 · S0 복원 증명 아님 · §12-1 ④): 활성 compute 를 먼저 지운다 → 두 벽 unfix (판 · 바닥 이력 소거) → 진단 restart (UNread 가 새 프로세스로 읽는다)
uncompute ul_wh
unfix zwall_top
unfix zwall_bot
write_restart ${out}/un_diag.bin
print "UL_R_DONE bed=${ul_bed} end_step=${ul_step}"
# <<< block r_start
