+def _pkg(tmp_path, body: bytes):
+    d = tmp_path / f"pkg_{body.decode()}"
+    d.mkdir()
+    (d / "one.txt").write_bytes(body)
+    sums = d / "SHA256SUMS"
+    sums.write_text(f"{hashlib.sha256(body).hexdigest()}  one.txt\n", encoding="utf-8")
+    return d, sums
