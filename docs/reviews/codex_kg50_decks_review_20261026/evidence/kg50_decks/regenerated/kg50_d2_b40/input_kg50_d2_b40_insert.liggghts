# ===== SE 입도 비교 생성본 (make_se_size_decks.py · 50kg/batch 4차년도) =====
#   kg50_d2_b40: mono AM D6, AM:SE=85:15 wt%, SE D50 2um, 6.5mAh/cm2, 40x40um
#   기준 덱 docs/data/phase_a_6mah/in.real_4.liggghts (sha256 900ae9c8f1fde02e…) — 바꾼 자리 = 아래뿐
#   ① 조성 단일 활물질 (AM_P 자리 · pts2 정의만) · 질량분율 AM 0.85 · SE 0.15
#   ② r_AM_P 3 µm · r_SE 1 µm   ③ 진밀도 세대 lab20261014: AM 4.85 · SE 1.64 g/cm³
#   ④ 영역 40×40 µm (reg_box · reg_mix · 판 꼭짓점 · 압력 면적 0.0016)
#   ⑤ 삽입 위끝 z 0.322700 (높이 317.7 µm · volumefraction 0.321 그대로) = 고체 두께 101.98 µm = 6.5 mAh/cm² @ 200 mAh/g
#   ⑥ 시드 (큰 소수 · 케이스마다 독립): 12000017, 12100003, 12200009, 12300017, 12400001
#   ⑦ 태그 real_4 → kg50_d2_b40   ⑧ maxattempt 15,000 → 3,000 (예상 14,306 × 3,000 = 4.29e+07 < 2^31/1.3 · 원장 PS-01)
#   ⑨ processors * * 1 (x·y 분할)   ⑩ 삽입 자기검사 (99 %)   ⑪ restart 200000 restart_kg50_d2_b40/restart_compress_*.bin (간격 200,000)
#   ⑫ atom 덤프 간격 5,000 → 50,000
#   ⑬ 삽입 직후 체크포인트 write_restart restart_kg50_d2_b40/restart_settling_1.bin (NP 1 삽입 → 재개 스크립트로 코어 변경)
#   ⑭ 삽입 직후 활물질 수 943–953 (계획 948) 밖이면 quit 1 — 삽입은 NP 1 (SELF-70)
#   ⑮ 이웃 skin 그대로 (2 µm)
#   그대로: 재료 property/global 전부 (E_SE 0.135e7 = 1.35 GPa 연화값) · 접촉법칙 · dt · 이웃 · 벽 · 중력 · 감쇠 ·
#     정착 200,000 · 안정화 200,000 · 판 속도 0.01 · 목표 0.30 (300 MPa) · 이완 100,000 · 접촉 · mesh 덤프
#   예상 입자 수 (질량분율 규약): AM_P 948 · SE 13,358 (합 14,306) · 예상 면용량 6.500 mAh/cm²
#   ⚠ 상별 수는 MPI 랭크 수 NP 만큼 흔들린다 (소수 상 = 활물질이 체계적으로 부족 · 원장 SELF-70) — 삽입은 NP 1 ·
#     런 뒤 덤프로 실현 조성을 센다.
#   ⚠ 언로딩 없음 — 끝 상태 = 판 고정 이완 (가압 상태) · 실험 (하중 제거) 과 바로 비교하지 않는다.

# ============================================================
# kg50_d2_b40: SE 입도 비교 (50kg/batch 4차년도 · make_se_size_decks.py)
# Scale: r×1000, E×0.001, P×0.001
# ============================================================

# --- 1. General Settings ---
atom_style      granular
atom_modify     map array sort 0 0
boundary        p p f
newton          off
soft_particles  yes
communicate     single vel yes
units           si

# --- 2. Variables & Domain ---
variable target_press equal 0.30          # 300 MPa × 0.001
variable r_AM_P  equal 3e-3            # AM_P r=3μm → Sim 3mm
variable r_AM_S  equal 2.0e-3            # AM_S r=2μm → Sim 2mm
variable r_SE    equal 1e-3            # SE r=1μm → Sim 1mm
variable dt      equal 1.0e-6
variable plate_margin equal 0.003
timestep        ${dt}

# RVE: 40×40 μm → Sim 0.04×0.04 m
processors * * 1
region reg_box block 0.0 0.04 0.0 0.04 -0.01 1.0 units box
create_box      3 reg_box

neighbor        0.002 bin
neigh_modify    delay 0 check yes

# --- 3. Material Properties (Type 1:AM_P, 2:AM_S, 3:SE) ---
# AM: E=140 GPa → Sim 1.4e8 Pa, ν=0.25
# SE: E=1.35 GPa → Sim 0.135e7 Pa (소성변형 보정), ν=0.30
fix m1 all property/global youngsModulus peratomtype 1.4e8 1.4e8 0.135e7
fix m2 all property/global poissonsRatio peratomtype 0.25 0.25 0.30

fix m3 all property/global coefficientRestitution peratomtypepair 3 &
    0.3 0.3 0.3 &
    0.3 0.3 0.3 &
    0.3 0.3 0.3

fix m4 all property/global coefficientFriction peratomtypepair 3 &
    0.5 0.5 0.5 &
    0.5 0.5 0.5 &
    0.5 0.5 0.5

fix m5 all property/global coefficientRollingFriction peratomtypepair 3 &
    0.2 0.2 0.1 &
    0.2 0.2 0.1 &
    0.1 0.1 0.1

fix m6 all property/global coefficientMaxElasticStiffness peratomtypepair 3 &
    1.5 1.5 3.0 &
    1.5 1.5 3.0 &
    3.0 3.0 5.0

fix m7 all property/global coefficientAdhesionStiffness peratomtypepair 3 &
    1.0e5 1.0e5 2.0e5 &
    1.0e5 1.0e5 2.0e5 &
    2.0e5 2.0e5 1.0e6

fix m8 all property/global coefficientPlasticityDepth peratomtypepair 3 &
    0.05 0.05 0.01 &
    0.05 0.05 0.01 &
    0.01 0.01 0.005

fix m9 all property/global characteristicVelocity scalar 2.0

# --- 4. Contact Model ---
pair_style      gran model hooke/hysteresis tangential history rolling_friction cdt
pair_coeff      * *

compute strs all stress/atom
compute ke   all ke/atom
compute cpl all pair/gran/local pos id force force_normal force_tangential torque contactArea delta contactPoint

# --- 5. Wall (Bottom) ---
fix zwall_bot all wall/gran model hooke/hysteresis tangential history rolling_friction cdt primitive type 1 zplane 0.0

# --- 6. Templates & Distribution ---
# Type 1: AM   (NCM811, ρ=4850 kg/m³, r=3μm) — 단일 활물질
# Type 2: AM_S (정의만 · 분포 가중 0 · ρ=4850 kg/m³)
# Type 3: SE   (LPSCl,  ρ=1640 kg/m³, r=1μm)
fix pts1 all particletemplate/sphere 12000017 atom_type 1 density constant 4850 radius constant ${r_AM_P}
fix pts2 all particletemplate/sphere 12100003 atom_type 2 density constant 4850 radius constant ${r_AM_S}   # (이 케이스 질량분율 0 — 분포에서 제외)
fix pts3 all particletemplate/sphere 12200009 atom_type 3 density constant 1640 radius constant ${r_SE}

# 질량비: AM_P:0.85, SE:0.15
# AM:SE = 81.6:18.4, P:S = 7:3
fix pdd_mix all particledistribution/discrete 12300017 2 pts1 0.85 pts3 0.15

# --- 7. Particle Insertion ---
region reg_mix block 0.0 0.04 0.0 0.04 0.005 0.322700 units box

print "====== INSERTING PARTICLES (KG50_D2_B40: mono AM D6, AM:SE=85:15 wt%, SE D50 2um, 6.5mAh/cm2, 40x40um) ====="
fix ins_mix all insert/pack seed 12400001 distributiontemplate pdd_mix &
    maxattempt 3000 insert_every once overlapcheck yes all_in no &
    vel constant 0.0 0.0 -0.5 &
    region reg_mix &
    volumefraction_region 0.321
run 1
unfix ins_mix

# ── 삽입 자기검사 (원장 `PS-01` · 감사 GAP high) ──
#   부분 삽입 침대는 조성이 달라 **다른 물건**이다 — 완주시키지 않는다.
variable n_ins equal count(all)
print "====== INSERTED ${n_ins} / 14306 (floor 14162 = 99%) ======"
if "${n_ins} < 14162" then &
    "print 'FATAL: partial insertion - bed composition differs (PS-01). aborting.'" &
    "quit 1"

# ⑭ 삽입 직후 활물질 수 — 계획 948 ±0.5 % (SELF-70: NP 가 크면 소수 상이 체계적으로 부족 → 삽입은 NP 1)
group g_am_ins type 1
variable n_am_ins equal count(g_am_ins)
print "====== AM ${n_am_ins} / 948 (gate 943-953) ======"
if "${n_am_ins} < 943 || ${n_am_ins} > 953" then &
    "print 'FATAL: AM count off plan (SELF-70) - insert at NP 1. aborting.'" &
    "quit 1"

# --- 8. Output ---
shell mkdir post_kg50_d2_b40
thermo_style    custom step atoms ke cpu
thermo          1000

# --- 9. Phase 1: Settling ---
print "====== PHASE 1: SETTLING ======"
fix integr all nve/sphere
fix gravi all gravity 98.1 vector 0.0 0.0 -1.0
fix damp all viscous 1.0e-5

compute zmax all reduce max z
shell mkdir restart_kg50_d2_b40
restart 50000 restart_kg50_d2_b40/restart_settling_*.bin
write_restart restart_kg50_d2_b40/restart_settling_1.bin   # 삽입 직후 (step 1) — 재개 스크립트의 settling 모드 = 남은 200,000
run 2000
# ⑬ 삽입 전용 덱 끝 — NP 1 로 돌린 뒤 resume_ckpt.sh (settling 모드) 로 본 덱 (kg50_d2_b40) 을 이어받는다
