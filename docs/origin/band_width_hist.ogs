// band_width_hist.ogs — 12장 오른쪽 패널: 대표 구조 선택 폭 분포 (가로) BML 포맷
// 쓰는 법: 그래프 창 활성화 → Script Window 에 붙여넣고 Enter.
// 전제: band_width_hist_guide.md 의 A(원자료 Histogram → 축 교환) 또는 B(가로 Bar) 로
//       **이미 가로 그림이 만들어진 상태**.
// 이 스크립트가 **못 하는 것**: 축 교환 · 구간 설정 · 막대 간격 0 · 기준선 두 개
//   → 전부 GUI 단계다 (안내 문서 A-3 / A-4 / B-3 / '기준선 두 개' 절).

layer.unit = 3;
layer.width = 5.2;          // 왼쪽 큰 패널과 나란히 놓는 작은 패널 (12 cm 아님)
layer.height = 9;
page.margincontrol = 1;

// ── X 축: 종 수 (도수) ────────────────────────────────────────────────────
layer.x.color = color(64,64,64);
layer.x.thickness = 1;
layer.x.ticks = 10;              // major out + minor out
layer.x.ticklength = 6;
layer.x.tickthickness = 1;
layer.x.mticklength = 3;
layer.x.label.font = font(arial);
layer.x.label.pt = 28;
layer.x.label.color = color(64,64,64);
layer.x.from = 0;
layer.x.to = 28;
layer.x.inc = 10;

// ── Y 축: 폭 (eV/atom) ────────────────────────────────────────────────────
layer.y.color = color(64,64,64);
layer.y.thickness = 1;
layer.y.ticks = 10;
layer.y.ticklength = 6;
layer.y.tickthickness = 1;
layer.y.mticklength = 3;
layer.y.label.font = font(arial);
layer.y.label.pt = 28;
layer.y.label.color = color(64,64,64);
layer.y.from = 0;
layer.y.to = 0.20;               // ⚠ 안내 B(구간 중심 막대) 로 그렸으면 0.205 로 (맨 위 막대가 반쯤 걸린다)
layer.y.inc = 0.05;

// ── 위 / 오른쪽 축: 선만 ───────────────────────────────────────────────────
layer.x2.showAxes = 3; layer.x2.color = color(64,64,64);
layer.x2.thickness = 1; layer.x2.ticks = 0; layer.x2.showLabels = 0;
layer.y2.showAxes = 3; layer.y2.color = color(64,64,64);
layer.y2.thickness = 1; layer.y2.ticks = 0; layer.y2.showLabels = 0;

// ── 축 제목 (열 이름이 그대로 올라오는 것을 덮는다) ─────────────────────────
label -xb species;
label -yl band width  (eV / atom);

// ── 막대 색 — 파이썬 판과 같은 보라 (#7C3AED, house_style ELEM["P"]) ────────
range r1 = 1!1;  set r1 -c color(124,58,237);
