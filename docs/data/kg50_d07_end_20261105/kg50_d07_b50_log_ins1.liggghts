unfix ins_mix

# ── 삽입 자기검사 (원장 `PS-01` · 감사 GAP high) ──
#   부분 삽입 침대는 조성이 달라 **다른 물건**이다 — 완주시키지 않는다.
variable n_ins equal count(all)
print "====== INSERTED ${n_ins} / 488291 (floor 483408 = 99%) ======"
====== INSERTED 488291 / 488291 (floor 483408 = 99%) ======
if "${n_ins} < 483408" then     "print 'FATAL: partial insertion - bed composition differs (PS-01). aborting.'"     "quit 1"

# ⑭ 삽입 직후 AM 수 — 계획 1,481 · 정수 구간 1474–1488 (±0.5 % 안 · ceil/floor) · 상별 수는 MPI 랭크 · 시드에 따라 흔들린다 (부족 또는 초과 · SELF-70 · KG50-07) → 삽입은 NP 1
group g_am_ins type 1
1481 atoms in group g_am_ins
variable n_am_ins equal count(g_am_ins)
print "====== AM ${n_am_ins} / 1481 (gate 1474-1488) ======"
====== AM 1481 / 1481 (gate 1474-1488) ======
if "${n_am_ins} < 1474 || ${n_am_ins} > 1488" then     "print 'FATAL: AM count off plan (SELF-70) - insert at NP 1. aborting.'"     "quit 1"

# ⑭ 삽입 직후 SE 수 — 계획 486,810 · 정수 구간 484376–489244 (±0.5 % 안 · ceil/floor) · 상별 수는 MPI 랭크 · 시드에 따라 흔들린다 (부족 또는 초과 · SELF-70 · KG50-07) → 삽입은 NP 1
group g_se_ins type 3
486810 atoms in group g_se_ins
variable n_se_ins equal count(g_se_ins)
print "====== SE ${n_se_ins} / 486810 (gate 484376-489244) ======"
====== SE 486810 / 486810 (gate 484376-489244) ======
if "${n_se_ins} < 484376 || ${n_se_ins} > 489244" then     "print 'FATAL: SE count off plan (SELF-70) - insert at NP 1. aborting.'"     "quit 1"

# --- 8. Output ---
shell mkdir post_kg50_d07_b50
thermo_style    custom step atoms ke cpu
thermo          1000

# --- 9. Phase 1: Settling ---
print "====== PHASE 1: SETTLING ======"
====== PHASE 1: SETTLING ======
fix integr all nve/sphere
fix gravi all gravity 98.1 vector 0.0 0.0 -1.0
fix damp all viscous 1.0e-5

compute zmax all reduce max z
shell mkdir restart_kg50_d07_b50
restart 50000 restart_kg50_d07_b50/restart_settling_*.bin

run 20000
