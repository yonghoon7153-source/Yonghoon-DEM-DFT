# Phase field 예시 (예: dendrite/LFP 상분리, Cahn–Hilliard/Allen–Cahn)
#   비선형·시간의존 → 직접솔버를 반복 호출 → cuDSS 이득 큼(메시 미세할수록).
# 복사:  cp config/models/phasefield_cudss.env.example config/models/phasefield_cudss.env
MODEL_NAME=phasefield_cudss
MPH_FILE=models/phasefield.mph
STUDY=
SOLVER=cudss         # 모델 Direct 솔버를 cuDSS로 저장해둘 것
USE_GPU=true
NP=8
HWACC=
EXTRA_FLAGS=
NOTES="Phase field — cuDSS 1순위. fully-coupled 대형은 VRAM 주의."
