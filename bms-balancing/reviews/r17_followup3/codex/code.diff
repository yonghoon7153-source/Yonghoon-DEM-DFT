+PARAM_COLS = ["a_PE", "b_PE", "a_NE", "b_NE", "gamma_Si"]
+#: 첫 판 dd_eval.m (56a35a8:118) 이 쓴 rmse 열 — 부분 대조(옛 스키마)가 성립하려면 최소한 이 둘은 있어야 한다.
+OLD_SCHEMA_MIN_COLS = ("rmse_pocv", "rmse_dvdq")
