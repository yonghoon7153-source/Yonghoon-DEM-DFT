# 복사해서 사용:  cp config/models/lpscl_3d_bulk.env.example config/models/lpscl_3d_bulk.env
#
# 0.1C_31x31x40_LPSCl_5e-6_bulk.mph
#   3D 전고체전지(argyrodite Li6PS5Cl) bulk 모델 · 0.1C · 31x31x40 격자
#   → 3D 공간분해 = cuDSS(GPU) 후보. 단 VRAM(인수분해 메모리) 점검 필수.
MODEL_NAME=lpscl_3d_bulk
MPH_FILE=models/0.1C_31x31x40_LPSCl_5e-6_bulk.mph

# 실행할 study 태그. 비우면 모델 기본. COMSOL GUI에서 std1 등 태그 확인.
STUDY=

# ★ 실제 GPU 사용을 위해 모델 Direct 솔버가 cuDSS로 저장돼 있어야 함!
#   (methods/set_cudss_solver.md 참고. 라벨일 뿐, 모델 저장이 진짜 스위치)
SOLVER=cudss
USE_GPU=true

NP=8                 # 사용할 물리 코어 수 (cuDSS 외 전처리/조립은 CPU 사용)
HWACC=               # 음향 explicit 전용 — 배터리는 비움
EXTRA_FLAGS=
NOTES="3D SSB LPSCl bulk, 0.1C, 31x31x40 — cuDSS 후보(메모리 점검)"
