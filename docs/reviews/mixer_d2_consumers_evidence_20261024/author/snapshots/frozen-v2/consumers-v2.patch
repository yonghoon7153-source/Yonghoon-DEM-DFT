+        _d2_need(all(t in (['shell','mkdir','post'],['shell','mkdir','restart']) for t in commands if t[0]=='shell'), 'unsupported shell command')
+        allowed_styles={'property/global','gravity','mesh/surface','wall/gran','particletemplate/sphere',
