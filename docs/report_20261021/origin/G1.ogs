// G1.ogs — 사양 5 조성 — 공극률 (union) · 두께 vs 대 : 소 (DoubleY)
// 사용: G1.csv 를 가져온 워크북을 활성으로 두고 Script Window 에 붙여 넣기 → Enter.
// 결과: 새 그래프 + BML 서식 (바깥 틱 · 위/오른쪽 축선 · #404040 · 틱 라벨 Aptos 28 pt).  축 제목 글꼴 · 범례는 GUIDE.md 의 GUI 단계.
string bk$ = %H;
plotxy iy:=[%(bk$)]1!(1,3) plot:=202 ogl:=<new template:=DoubleY>;
set %C -c color(241,64,64); set %C -w 1000; set %C -k 2; set %C -z 10; set %C -d 0;
plotxy iy:=[%(bk$)]1!(1,5) plot:=202 ogl:=2!;
set %C -c color(79,189,255); set %C -w 800; set %C -k 1; set %C -z 9; set %C -d 1;
page.active = 1;

// ── BML 축 서식 (글꼴 = Aptos · 사용자 지정) ──
layer.unit = 3; layer.width = 10; layer.height = 8;
layer.x.color = color(64,64,64); layer.x.thickness = 1; layer.x.ticks = 10;
layer.x.ticklength = 6; layer.x.tickthickness = 1; layer.x.mticklength = 3; layer.x.mtickthickness = 1;
layer.x.label.font = font(Aptos); layer.x.label.pt = 28; layer.x.label.color = color(64,64,64);
layer.y.color = color(64,64,64); layer.y.thickness = 1; layer.y.ticks = 10;
layer.y.ticklength = 6; layer.y.tickthickness = 1; layer.y.mticklength = 3; layer.y.mtickthickness = 1;
layer.y.label.font = font(Aptos); layer.y.label.pt = 28; layer.y.label.color = color(64,64,64);
layer.x2.showAxes = 3; layer.x2.color = color(64,64,64); layer.x2.thickness = 1; layer.x2.ticks = 0; layer.x2.showLabels = 0;
page.margincontrol = 1;
label -xb Large : small AM (mass);
label -yl Porosity, union (%);
page.active = 2;
layer2.y.color = color(79,189,255); layer2.y.thickness = 1; layer2.y.ticks = 10;
layer2.y.label.font = font(Aptos); layer2.y.label.pt = 28; layer2.y.label.color = color(79,189,255);
label -yr Thickness (\g(m)m);
