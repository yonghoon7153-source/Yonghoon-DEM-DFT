+def _read_run_cont(d, cont, P):
+    """UTc 기록 = 부모 UT 기록 (≤ R_M · 해시 대조된 CSV) + UTc 자기 기록 (> R_M) — 경계 중복 · 누락 검사 (개정 3 §14-3)."""
+    par, own = read_run(cont['dir'], P), read_run(d, P)
