{
  "name": "nihonchizu",
  "private": true,
  "version": "0.1.0",
  "description": "일본 47도도부현을 눌러보며 익히는 인터랙티브 지도 (日本地図で学ぶ)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5004 --strictPort",
    "build": "npm run data:check && vite build",
    "preview": "vite preview --port 5004 --strictPort",
    "typecheck": "tsc --noEmit",
    "geo:build": "node scripts/build-geo.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "check": "npm run data:check && npm run typecheck && vite build",
    "mascots:import": "node scripts/import-mascot-images.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
